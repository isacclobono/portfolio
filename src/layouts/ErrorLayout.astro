---
import Layout from './Layout.astro';
import Button from '../components/Button.astro';

interface Props {
  code: string;
  status: string;
  title: string;
  description: string;
  accentColor?: 'red' | 'amber' | 'blue' | 'purple' | 'cyan';
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  secondaryIcon?: 'tools' | 'status' | 'jwt' | 'calendar';
}

const {
  code,
  status,
  title,
  description,
  accentColor = 'cyan',
  primaryHref = '/',
  primaryLabel = 'Return to Homepage',
  secondaryHref = '/tools',
  secondaryLabel = 'Developer Tools',
  secondaryIcon = 'tools'
} = Astro.props;

const pageTitle = `${code} — ${title} | SK Builds`;
---

<Layout 
  title={pageTitle} 
  description={description} 
  currentPath={`/${code}`}
  noindex={true}
>
  <div class="error-container">
    <div class="error-content">
      <!-- Monumental Watermark Code -->
      <div class={`error-watermark accent-${accentColor}`} aria-hidden="true">
        {code}
      </div>

      <!-- Live Status Badge -->
      <div class={`error-status-pill badge-${accentColor}`}>
        <span class={`status-dot dot-${accentColor}`} aria-hidden="true"></span>
        <span class="status-code">HTTP {code}</span>
        <span class="status-sep">&bull;</span>
        <span class="status-name">{status}</span>
      </div>

      <!-- Main Headline & Description -->
      <h1 class="error-title">{title}</h1>
      <p class="error-description">{description}</p>

      <!-- Primary & Secondary Actions -->
      <div class="error-actions">
        <Button href={primaryHref} variant="primary" size="md">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>{primaryLabel}</span>
        </Button>

        {secondaryHref && secondaryLabel && (
          <Button href={secondaryHref} variant="secondary" size="md">
            {secondaryIcon === 'tools' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            )}
            {secondaryIcon === 'status' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
              </svg>
            )}
            {secondaryIcon === 'jwt' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            )}
            {secondaryIcon === 'calendar' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
              </svg>
            )}
            <span>{secondaryLabel}</span>
          </Button>
        )}
      </div>

      <!-- Clean Minimal Inline Links (No Cards Everywhere) -->
      <nav class="error-quick-nav" aria-label="Alternative Destinations">
        <span class="quick-nav-label">Popular destinations:</span>
        <div class="quick-nav-links">
          <a href="/projects" class="quick-nav-link">Projects</a>
          <span class="quick-nav-sep">&bull;</span>
          <a href="/work" class="quick-nav-link">Experience</a>
          <span class="quick-nav-sep">&bull;</span>
          <a href="/tools" class="quick-nav-link">Developer Tools</a>
          <span class="quick-nav-sep">&bull;</span>
          <a href="/blog" class="quick-nav-link">Blog</a>
          <span class="quick-nav-sep">&bull;</span>
          <a href="/status" class="quick-nav-link">Status</a>
          <span class="quick-nav-sep">&bull;</span>
          <a href="mailto:sunilkhobragade@proton.me" class="quick-nav-link">Contact</a>
        </div>
      </nav>
    </div>
  </div>
</Layout>

<style>
  /* Tall, Centered & Spacious Error Container */
  .error-container {
    min-height: calc(80vh - 100px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem 4.5rem 1.25rem;
    position: relative;
    width: 100%;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 620px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Monumental Watermark */
  .error-watermark {
    font-size: clamp(6.5rem, 18vw, 11rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    user-select: none;
    pointer-events: none;
    margin-bottom: -1.75rem;
    opacity: 0.14;
    transition: opacity 0.3s ease;
  }

  :global([data-theme="light"]) .error-watermark {
    opacity: 0.1;
  }

  .error-watermark.accent-red {
    background: linear-gradient(180deg, #ef4444 0%, transparent 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-watermark.accent-amber {
    background: linear-gradient(180deg, #f59e0b 0%, transparent 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-watermark.accent-blue {
    background: linear-gradient(180deg, #3b82f6 0%, transparent 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-watermark.accent-purple {
    background: linear-gradient(180deg, #a855f7 0%, transparent 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-watermark.accent-cyan {
    background: linear-gradient(180deg, #06b6d4 0%, transparent 80%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Status Pill Badge */
  .error-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border-subtle);
    background: var(--bg-subtle, rgba(255, 255, 255, 0.03));
    color: var(--text-secondary);
  }

  .status-dot {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .dot-red {
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
  }

  .dot-amber {
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }

  .dot-blue {
    background: #3b82f6;
    box-shadow: 0 0 8px #3b82f6;
  }

  .dot-purple {
    background: #a855f7;
    box-shadow: 0 0 8px #a855f7;
  }

  .dot-cyan {
    background: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
  }

  .status-sep {
    opacity: 0.4;
  }

  /* Titles & Descriptions */
  .error-title {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 0.85rem 0;
    line-height: 1.15;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  /* Action Buttons */
  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
    width: 100%;
  }

  /* Clean Inline Quick Nav (No Cards) */
  .error-quick-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    font-size: 0.84rem;
    color: var(--text-muted);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    width: 100%;
    max-width: 480px;
  }

  .quick-nav-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.85;
  }

  .quick-nav-links {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
  }

  .quick-nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .quick-nav-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .quick-nav-sep {
    color: var(--border-subtle);
    opacity: 0.6;
    user-select: none;
  }

  @media (max-width: 640px) {
    .error-container {
      min-height: calc(70vh - 60px);
      padding: 2rem 1rem 3.5rem 1rem;
    }

    .error-watermark {
      margin-bottom: -1rem;
    }

    .error-actions {
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
    }

    .error-actions :global(a) {
      width: 100%;
      justify-content: center;
    }

    .error-quick-nav {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
