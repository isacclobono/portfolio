---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CopyCode from '../components/CopyCode.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Chatbot from '../components/Chatbot.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const { 
  title = SITE.AUTHOR, 
  description = SITE.DESCRIPTION,
  currentPath = Astro.url.pathname,
  image = SITE.OG_IMAGE || '/og-image.svg',
  type = 'website',
  publishDate,
  modifiedDate,
  tags = [],
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- PWA & Mobile Web Capabilities -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SK Builds" />
    <meta name="application-name" content="SK Builds" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    
    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="DA-dWtsAyXF5D3yD31qyrnzBfrO8uWwFgppJ8ZDjFfw" />

    <!-- Google tag (gtag.js) - Deferred to idle to prevent render-blocking & preserve 100/100 LCP -->
    <script is:inline>
      (function() {
        const loadGA = function() {
          if (window.gaLoaded) return;
          window.gaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KD2S0XJWKB';
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-KD2S0XJWKB');
        };
        if (document.readyState === 'complete') {
          setTimeout(loadGA, 2000);
        } else {
          window.addEventListener('load', function() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadGA, { timeout: 3000 });
            } else {
              setTimeout(loadGA, 2000);
            }
          });
        }
      })();
    </script>

    <!-- Comprehensive SEO, Open Graph, Twitter & Structured Data Schema -->
    <SEO 
      title={title}
      description={description}
      image={image}
      type={type}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      tags={tags}
      noindex={noindex}
    />

    <script is:inline>
      (function(){const t=localStorage.getItem('theme'),d=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.setAttribute('data-theme',t==='dark'||(!t&&d)?'dark':'light');})();
    </script>
    <script>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <!-- Top Reading Progress Indicator -->
    <ScrollProgress />

    <div class="site-container">
      <Header currentPath={currentPath} />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Floating Scroll To Top Button -->
    <ScrollToTop />

    <!-- Copy Code Handler -->
    <CopyCode />

    <!-- AI Chatbot Assistant -->
    <Chatbot />

    <!-- Global Search & Command Palette (Ctrl + K) -->
    <GlobalSearch />
  </body>
</html>
