---
// ThemeToggle.astro
---

<div class="theme-toggle-group" id="theme-toggle-group">
  <button type="button" class="theme-btn" id="theme-light-btn" title="Light mode" aria-label="Light mode">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </button>
  <button type="button" class="theme-btn" id="theme-dark-btn" title="Dark mode" aria-label="Dark mode">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </button>
  <button type="button" class="theme-btn" id="theme-system-btn" title="System preference" aria-label="System preference">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="14" x="2" y="3" rx="2"></rect>
      <line x1="8" x2="16" y1="21" y2="21"></line>
      <line x1="12" x2="12" y1="17" y2="21"></line>
    </svg>
  </button>
</div>

<style>
  .theme-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 5px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-btn svg {
    width: 17px;
    height: 17px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease, filter 0.2s ease;
    will-change: transform;
  }

  .theme-btn:hover, .theme-btn.active {
    color: var(--text-primary);
  }

  /* Sun rotate ray animation */
  #theme-light-btn:hover svg {
    color: #eab308;
    transform: rotate(45deg) scale(1.18);
    filter: drop-shadow(0 0 6px rgba(234, 179, 8, 0.4));
  }

  /* Moon gentle rocking tilt animation */
  #theme-dark-btn:hover svg {
    color: #a855f7;
    transform: rotate(-18deg) scale(1.18);
    filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.4));
  }

  /* System monitor bounce */
  #theme-system-btn:hover svg {
    color: #38bdf8;
    transform: scale(1.18) translateY(-1px);
    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.4));
  }

  .theme-btn.active svg {
    transform: scale(1.05);
  }
</style>

<script is:inline>
  function setupTheme() {
    const lightBtn = document.getElementById('theme-light-btn');
    const darkBtn = document.getElementById('theme-dark-btn');
    const systemBtn = document.getElementById('theme-system-btn');

    function getSavedTheme() {
      return localStorage.getItem('theme') || 'system';
    }

    function applyTheme(theme) {
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
      }

      lightBtn?.classList.toggle('active', theme === 'light');
      darkBtn?.classList.toggle('active', theme === 'dark');
      systemBtn?.classList.toggle('active', theme === 'system');
    }

    lightBtn?.addEventListener('click', () => {
      localStorage.setItem('theme', 'light');
      applyTheme('light');
    });

    darkBtn?.addEventListener('click', () => {
      localStorage.setItem('theme', 'dark');
      applyTheme('dark');
    });

    systemBtn?.addEventListener('click', () => {
      localStorage.setItem('theme', 'system');
      applyTheme('system');
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getSavedTheme() === 'system') {
        applyTheme('system');
      }
    });

    applyTheme(getSavedTheme());
  }

  setupTheme();
  document.addEventListener('astro:after-swap', setupTheme);
</script>
