---
import { SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Line 1: Copyright / Author Name on Left, Theme Toggle on Right -->
  <div class="footer-primary-row">
    <div class="footer-brand-text">
      &copy; {year} | <strong class="footer-author-name">{SITE.AUTHOR}</strong> ({SITE.BRAND})
    </div>
    <div class="footer-theme-wrap">
      <ThemeToggle />
    </div>
  </div>

  <!-- Line 2: Pages Section with Generous Breathing Room -->
  <div class="footer-pages-section">
    <div class="footer-pages-heading">Pages</div>
    <nav class="footer-nav-list" aria-label="Footer Navigation">
      <a href="/status" class="footer-nav-item">
        <span class="status-indicator-dot" aria-hidden="true"></span>
        Status
      </a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>
      
      <a href="/changelog" class="footer-nav-item">Changelog</a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>
      
      <a href="/tech-stack" class="footer-nav-item">Tech Stack &amp; Uses</a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>
      
      <a href="/privacy" class="footer-nav-item">Privacy Policy</a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>
      
      <a href="/terms" class="footer-nav-item">Terms</a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>
      
      <a href="/rss.xml" class="footer-nav-item">RSS</a>
      <span class="nav-separator" aria-hidden="true">&bull;</span>

      <a href="/sitemap-index.xml" class="footer-nav-item">Sitemap</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 5.5rem;
    padding-top: 2.25rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Line 1: Name & Theme Toggle */
  .footer-primary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1.5rem;
  }

  .footer-brand-text {
    font-size: 0.925rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .footer-author-name {
    color: var(--text-primary);
    font-weight: 600;
  }

  .footer-theme-wrap {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* Line 2: Pages Section */
  .footer-pages-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    padding-top: 0.5rem;
  }

  .footer-pages-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .footer-nav-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 1.15rem;
    font-size: 0.875rem;
  }

  .footer-nav-item {
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 0.15s ease;
  }

  .footer-nav-item:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .status-indicator-dot {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .nav-separator {
    color: var(--text-muted);
    font-size: 0.8rem;
    opacity: 0.4;
    user-select: none;
    margin: 0 0.15rem;
  }

  @media (max-width: 580px) {
    .footer-primary-row {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer-brand-text {
      white-space: normal;
    }

    .footer-nav-list {
      gap: 0.75rem 0.85rem;
    }
  }
</style>
