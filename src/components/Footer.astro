---
import { SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const year = new Date().getFullYear();

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Work Experience', href: '/work' },
  { label: 'Education', href: '/education' },
  { label: 'Tech Stack', href: '/tech-stack' },
  { label: 'Uses', href: '/uses' },
];

const toolsLinks = [
  { label: 'All Tools', href: '/tools' },
  { label: 'JSON to TS', href: '/tools/json-to-ts' },
  { label: 'Regex Tester', href: '/tools/regex-tester' },
  { label: 'UUID Generator', href: '/tools/uuid-generator' },
  { label: 'Base64 & Hash', href: '/tools/base64-encoder' },
  { label: 'Diff Checker', href: '/tools/diff-viewer' },
  { label: 'SQL Formatter', href: '/tools/sql-formatter' },
  { label: 'JWT Decoder', href: '/tools/jwt-decoder' },
  { label: 'Cron Generator', href: '/tools/cron-generator' },
  { label: 'Project Estimator', href: '/tools/estimator' },
  { label: '1:1 Consultation', href: '/tools/appointment' },
];

const publicationLinks = [
  { label: 'All Articles', href: '/blog' },
  { label: 'Groq LLM Inference', href: '/blog/ultra-fast-llm-inference-groq-lpu-streaming' },
  { label: 'Zero-JS Web Apps', href: '/blog/zero-js-baseline-web-applications-astro-5' },
  { label: 'Microservices with Redis', href: '/blog/building-high-throughput-microservices-with-nodejs-and-redis' },
  { label: 'Concurrency-Safe Bookings', href: '/blog/architecting-concurrency-safe-booking-systems' },
  { label: 'Multi-Agent Orchestration', href: '/blog/autonomous-multi-agent-orchestration-langgraph' },
];

const platformLinks = [
  { label: 'Status', href: '/status', isLive: true },
  { label: 'Changelog', href: '/changelog' },
  { label: 'RSS', href: '/rss.xml' },
  { label: 'Sitemap', href: '/sitemap-index.xml' },
  { label: 'LLMs.txt', href: '/llms.txt' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];

const socialLinks = [
  { label: 'GitHub', href: SITE.GITHUB },
  { label: 'LinkedIn', href: SITE.LINKEDIN },
  { label: 'X / Twitter', href: SITE.TWITTER },
  { label: 'Email', href: `mailto:${SITE.EMAIL}` },
  { label: 'Phone', href: 'tel:+917498950562' },
];
---

<footer class="site-footer" role="contentinfo" style="width: 100% !important; margin-top: 4rem !important; padding-top: 2rem !important; padding-bottom: 3.5rem !important; border-top: 1px solid var(--border-subtle) !important; display: flex !important; flex-direction: column !important; gap: 1.5rem !important;">
  
  <!-- Line 1: Copyright / Author Name on Left, Theme Toggle on Right -->
  <div class="footer-primary-row" style="display: flex !important; align-items: center !important; justify-content: space-between !important; width: 100% !important; gap: 1rem !important; flex-wrap: wrap !important;">
    <div class="footer-brand-text" style="font-size: 0.925rem !important; color: var(--text-secondary) !important; display: inline-flex !important; align-items: center !important; gap: 0.35rem !important; white-space: nowrap !important;">
      &copy; {year} | <strong class="footer-author-name" style="color: var(--text-primary) !important; font-weight: 600 !important;">{SITE.AUTHOR}</strong> ({SITE.BRAND})
    </div>
    <div class="footer-theme-wrap" style="display: flex !important; align-items: center !important; flex-shrink: 0 !important;">
      <ThemeToggle />
    </div>
  </div>

  <!-- Tagline & About Me Block -->
  <div class="footer-bio-block" style="display: flex !important; flex-direction: column !important; gap: 0.4rem !important; width: 100% !important;">
    <p class="footer-tagline" style="font-size: 0.85rem !important; font-weight: 600 !important; color: var(--text-primary) !important; margin: 0 !important; line-height: 1.45 !important;">
      Senior Full-Stack Developer, AI Architect &amp; Cloud Specialist
    </p>
    <p class="footer-about-text" style="font-size: 0.815rem !important; color: var(--text-secondary) !important; margin: 0 !important; line-height: 1.5 !important;">
      Building fast, high-concurrency web platforms, autonomous AI agents, RAG retrieval pipelines, microservices, and distributed cloud infrastructure with Node.js, Python, TypeScript, React, Next.js, and Astro.
    </p>
  </div>

  <div class="footer-divider-line" style="width: 100% !important; height: 1px !important; background: var(--border-subtle) !important; opacity: 0.6 !important; margin: 0.25rem 0 !important;"></div>

  <!-- Category 1: Navigation -->
  <div class="footer-pages-section" style="display: flex !important; flex-direction: column !important; gap: 0.5rem !important; width: 100% !important;">
    <div class="footer-pages-heading" style="font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--text-muted) !important; display: inline-flex !important; align-items: center !important; gap: 0.4rem !important;">
      <svg class="heading-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: inline-block !important; vertical-align: middle !important;"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
      <span>Navigation</span>
    </div>
    <nav class="footer-nav-list" aria-label="Navigation" style="display: flex !important; align-items: center !important; flex-wrap: wrap !important; gap: 0.4rem 0.75rem !important; font-size: 0.875rem !important; width: 100% !important;">
      {navLinks.map((item, idx) => (
        <>
          <a href={item.href} class="footer-nav-item" style="display: inline !important; color: var(--text-secondary) !important; text-decoration: none !important;">
            {item.label}
          </a>
          {idx < navLinks.length - 1 && <span class="nav-separator" aria-hidden="true" style="display: inline-block !important; color: var(--text-muted) !important; opacity: 0.4 !important; user-select: none !important; margin: 0 0.1rem !important;">&bull;</span>}
        </>
      ))}
    </nav>
  </div>

  <!-- Category 2: Developer Tools -->
  <div class="footer-pages-section" style="display: flex !important; flex-direction: column !important; gap: 0.5rem !important; width: 100% !important;">
    <div class="footer-pages-heading" style="font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--text-muted) !important; display: inline-flex !important; align-items: center !important; gap: 0.4rem !important;">
      <svg class="heading-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: inline-block !important; vertical-align: middle !important;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
      <span>Developer Tools</span>
    </div>
    <nav class="footer-nav-list" aria-label="Developer Tools" style="display: flex !important; align-items: center !important; flex-wrap: wrap !important; gap: 0.4rem 0.75rem !important; font-size: 0.875rem !important; width: 100% !important;">
      {toolsLinks.map((item, idx) => (
        <>
          <a href={item.href} class="footer-nav-item" style="display: inline !important; color: var(--text-secondary) !important; text-decoration: none !important;">
            {item.label}
          </a>
          {idx < toolsLinks.length - 1 && <span class="nav-separator" aria-hidden="true" style="display: inline-block !important; color: var(--text-muted) !important; opacity: 0.4 !important; user-select: none !important; margin: 0 0.1rem !important;">&bull;</span>}
        </>
      ))}
    </nav>
  </div>

  <!-- Category 3: Publications -->
  <div class="footer-pages-section" style="display: flex !important; flex-direction: column !important; gap: 0.5rem !important; width: 100% !important;">
    <div class="footer-pages-heading" style="font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--text-muted) !important; display: inline-flex !important; align-items: center !important; gap: 0.4rem !important;">
      <svg class="heading-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: inline-block !important; vertical-align: middle !important;"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
      <span>Publications</span>
    </div>
    <nav class="footer-nav-list" aria-label="Publications" style="display: flex !important; align-items: center !important; flex-wrap: wrap !important; gap: 0.4rem 0.75rem !important; font-size: 0.875rem !important; width: 100% !important;">
      {publicationLinks.map((item, idx) => (
        <>
          <a href={item.href} class="footer-nav-item" style="display: inline !important; color: var(--text-secondary) !important; text-decoration: none !important;">
            {item.label}
          </a>
          {idx < publicationLinks.length - 1 && <span class="nav-separator" aria-hidden="true" style="display: inline-block !important; color: var(--text-muted) !important; opacity: 0.4 !important; user-select: none !important; margin: 0 0.1rem !important;">&bull;</span>}
        </>
      ))}
    </nav>
  </div>

  <!-- Category 4: Platform & System -->
  <div class="footer-pages-section" style="display: flex !important; flex-direction: column !important; gap: 0.5rem !important; width: 100% !important;">
    <div class="footer-pages-heading" style="font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--text-muted) !important; display: inline-flex !important; align-items: center !important; gap: 0.4rem !important;">
      <svg class="heading-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: inline-block !important; vertical-align: middle !important;"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
      <span>Platform</span>
    </div>
    <nav class="footer-nav-list" aria-label="Platform" style="display: flex !important; align-items: center !important; flex-wrap: wrap !important; gap: 0.4rem 0.75rem !important; font-size: 0.875rem !important; width: 100% !important;">
      {platformLinks.map((item, idx) => (
        <>
          <a href={item.href} class="footer-nav-item" style="display: inline-flex !important; align-items: center !important; gap: 0.35rem !important; color: var(--text-secondary) !important; text-decoration: none !important;">
            {item.isLive && (
              <span class="status-indicator-dot" aria-hidden="true" style="width: 6.5px !important; height: 6.5px !important; border-radius: 50% !important; background: #10b981 !important; display: inline-block !important; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6) !important; flex-shrink: 0 !important;"></span>
            )}
            <span>{item.label}</span>
          </a>
          {idx < platformLinks.length - 1 && <span class="nav-separator" aria-hidden="true" style="display: inline-block !important; color: var(--text-muted) !important; opacity: 0.4 !important; user-select: none !important; margin: 0 0.1rem !important;">&bull;</span>}
        </>
      ))}
    </nav>
  </div>

  <!-- Category 5: Connect -->
  <div class="footer-pages-section" style="display: flex !important; flex-direction: column !important; gap: 0.5rem !important; width: 100% !important;">
    <div class="footer-pages-heading" style="font-size: 0.75rem !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.1em !important; color: var(--text-muted) !important; display: inline-flex !important; align-items: center !important; gap: 0.4rem !important;">
      <svg class="heading-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: inline-block !important; vertical-align: middle !important;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
      <span>Connect</span>
    </div>
    <nav class="footer-nav-list" aria-label="Connect" style="display: flex !important; align-items: center !important; flex-wrap: wrap !important; gap: 0.4rem 0.75rem !important; font-size: 0.875rem !important; width: 100% !important;">
      {socialLinks.map((item, idx) => (
        <>
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="footer-nav-item" style="display: inline !important; color: var(--text-secondary) !important; text-decoration: none !important;">
            {item.label}
          </a>
          {idx < socialLinks.length - 1 && <span class="nav-separator" aria-hidden="true" style="display: inline-block !important; color: var(--text-muted) !important; opacity: 0.4 !important; user-select: none !important; margin: 0 0.1rem !important;">&bull;</span>}
        </>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer-nav-item:hover {
    color: var(--text-primary) !important;
    text-decoration: underline !important;
  }

  .heading-icon {
    color: var(--text-muted);
    opacity: 0.85;
  }

  @media (max-width: 580px) {
    .footer-primary-row {
      flex-direction: row !important;
      justify-content: space-between !important;
    }

    .footer-brand-text {
      white-space: normal !important;
    }

    .footer-nav-list {
      gap: 0.5rem 0.65rem !important;
    }
  }
</style>
