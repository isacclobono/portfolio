---
// src/components/GlobalSearch.astro
---

<!-- Floating Left-Center Global Search Trigger Dock -->
<div class="sk-floating-search-dock">
  <button 
    type="button" 
    id="global-search-trigger" 
    class="sk-floating-search-btn"
    aria-label="Global Search (Ctrl + K)"
    title="Search pages, projects, blogs, tools (Ctrl + K)"
  >
    <div class="sk-search-icon-badge">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <div class="sk-search-pill-label">
      <span class="sk-search-text">Search</span>
      <span class="sk-search-shortcut">
        <kbd class="kbd-key" id="search-mod-key">Ctrl</kbd>
        <kbd class="kbd-key">K</kbd>
      </span>
    </div>
  </button>
</div>

<!-- Global Command Palette / Search Modal Dialog -->
<div 
  id="global-search-modal" 
  class="search-modal-backdrop" 
  aria-hidden="true" 
  role="dialog" 
  aria-modal="true"
  aria-label="Global Search and Command Palette"
>
  <div class="search-modal-card">
    
    <!-- Search Bar Input Header -->
    <div class="search-input-header">
      <svg class="search-modal-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="global-search-input" 
        class="search-text-input" 
        placeholder="Type a command or search pages, projects, blogs..." 
        autocomplete="off" 
        spellcheck="false"
      />
      <button 
        type="button" 
        id="global-search-clear-btn" 
        class="search-clear-btn" 
        aria-label="Clear search"
        style="display: none;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <button 
        type="button" 
        id="global-search-close-btn" 
        class="search-esc-badge" 
        aria-label="Close search"
        title="Close (Esc)"
      >
        ESC
      </button>
    </div>

    <!-- Quick Filter Category Pills -->
    <div class="search-filter-pills" id="search-filter-tabs">
      <button type="button" class="filter-tab active" data-filter="all">All</button>
      <button type="button" class="filter-tab" data-filter="Projects">Projects</button>
      <button type="button" class="filter-tab" data-filter="Blog">Blog</button>
      <button type="button" class="filter-tab" data-filter="Tools">Tools</button>
      <button type="button" class="filter-tab" data-filter="Pages">Pages</button>
      <button type="button" class="filter-tab" data-filter="Actions">Actions</button>
    </div>

    <!-- Search Results Container -->
    <div id="global-search-results" class="search-results-list" role="listbox">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Modal Footer Controls Guide -->
    <div class="search-modal-footer">
      <div class="footer-hint">
        <kbd class="footer-kbd">↑</kbd>
        <kbd class="footer-kbd">↓</kbd>
        <span>Navigate</span>
      </div>
      <div class="footer-hint">
        <kbd class="footer-kbd">↵</kbd>
        <span>Select</span>
      </div>
      <div class="footer-hint">
        <kbd class="footer-kbd">ESC</kbd>
        <span>Close</span>
      </div>
      <div class="footer-count" id="search-results-count">
        All entries
      </div>
    </div>

  </div>
</div>

<style is:global>
  /* ==========================================================================
     Floating Left-Center Global Search Trigger
     ========================================================================== */
  .sk-floating-search-dock {
    position: fixed;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    pointer-events: auto;
  }

  @media (max-width: 1024px) {
    .sk-floating-search-dock {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }

  .sk-floating-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 9999px;
    padding: 6px 14px 6px 6px;
    color: var(--text-primary);
    box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--border-subtle);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .sk-floating-search-btn:hover {
    background: var(--bg-card-hover);
    border-color: #3b82f6;
    transform: scale(1.04) translateX(2px);
    box-shadow: 0 14px 30px -4px rgba(59, 130, 246, 0.35), 0 0 0 1px #3b82f6;
  }

  .sk-search-icon-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3b82f6;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .sk-floating-search-btn:hover .sk-search-icon-badge {
    background: #3b82f6;
    color: #ffffff;
  }

  .sk-search-pill-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .sk-search-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .sk-search-shortcut {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .kbd-key {
    background: var(--bg-pill, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 5px;
    color: var(--text-secondary);
  }

  /* ==========================================================================
     Search Modal Backdrop & Card
     ========================================================================== */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 1rem 1rem 1rem;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .search-modal-backdrop.is-active {
    display: flex;
    opacity: 1;
  }

  .search-modal-card {
    width: 100%;
    max-width: 620px;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 14px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px var(--border-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    animation: searchModalZoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes searchModalZoomIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Input Header */
  .search-input-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .search-modal-icon {
    color: #3b82f6;
    flex-shrink: 0;
  }

  .search-text-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1rem;
    color: var(--text-primary);
    font-family: inherit;
  }

  .search-text-input::placeholder {
    color: var(--text-muted);
    font-size: 0.925rem;
  }

  .search-clear-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .search-clear-btn:hover {
    color: var(--text-primary);
  }

  .search-esc-badge {
    background: var(--bg-pill, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    padding: 2px 6px;
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-esc-badge:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  /* Filter Tabs */
  .search-filter-pills {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .filter-tab {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 3px 10px;
    font-size: 0.725rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .filter-tab:hover {
    color: var(--text-primary);
    background: var(--bg-pill);
  }

  .filter-tab.active {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.3);
    color: #3b82f6;
  }

  /* Results List */
  .search-results-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
    max-height: 420px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .search-category-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding: 0.5rem 0.65rem 0.25rem 0.65rem;
    user-select: none;
  }

  .search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .search-result-item:hover,
  .search-result-item.is-selected {
    background: var(--bg-card-hover);
    border-color: var(--border-subtle);
  }

  .search-item-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    flex-shrink: 0;
    transition: all 0.12s ease;
  }

  .search-result-item:hover .search-item-icon,
  .search-result-item.is-selected .search-item-icon {
    background: #3b82f6;
    border-color: #3b82f6;
    color: #ffffff;
  }

  .search-item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search-item-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-item-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-item-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--bg-pill);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .search-item-enter {
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  .search-result-item:hover .search-item-enter,
  .search-result-item.is-selected .search-item-enter {
    opacity: 1;
    color: #3b82f6;
  }

  /* Empty State */
  .search-empty-state {
    padding: 3rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .search-empty-icon {
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .search-empty-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .search-empty-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .search-empty-ai-btn {
    margin-top: 0.75rem;
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.15s ease;
  }

  .search-empty-ai-btn:hover {
    background: #1d4ed8;
  }

  /* Modal Footer */
  .search-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.15rem;
    background: var(--bg-primary);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.725rem;
    color: var(--text-muted);
    user-select: none;
  }

  .footer-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-kbd {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 1px 4px;
    font-size: 0.65rem;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    color: var(--text-secondary);
  }

  body.mobile-menu-open .sk-floating-search-dock {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .sk-floating-search-dock {
      display: none !important;
    }

    .search-modal-backdrop {
      padding: 1rem;
    }

    .search-modal-card {
      max-height: 85vh;
    }

    .search-modal-footer .footer-hint:not(:last-child) {
      display: none;
    }
  }
</style>

