    // ==========================================
    // 🔍 Search Controller & Modal State
    // ==========================================
    function initGlobalSearch() {
      const modal = document.getElementById('global-search-modal');
      const input = document.getElementById('global-search-input');
      const clearBtn = document.getElementById('global-search-clear-btn');
      const closeBtn = document.getElementById('global-search-close-btn');
      const resultsContainer = document.getElementById('global-search-results');
      const filterTabs = document.querySelectorAll('.filter-tab');
      const countEl = document.getElementById('search-results-count');
      const modKeyEl = document.getElementById('search-mod-key');

      if (!modal || !input || !resultsContainer) return;

      // Detect OS for ⌘ vs Ctrl
      const isMac = typeof navigator !== 'undefined' && /Mac|iPod|iPhone|iPad/.test(navigator.platform);
      if (modKeyEl) {
        modKeyEl.textContent = isMac ? '⌘' : 'Ctrl';
      }

      let activeFilter = 'all';
      let selectedIndex = 0;
      let visibleItems = [];

      // Open Modal
      function openModal() {
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          input.focus();
          input.select();
        }, 50);
        renderResults();
      }

      // Close Modal
      function closeModal() {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        input.value = '';
        if (clearBtn) clearBtn.style.display = 'none';
      }

      // Bind all search trigger buttons across Header, Drawer, and Floating Dock
      document.querySelectorAll('#global-search-trigger, .js-search-trigger, [data-open-search]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal();
        });
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
      }

      // Close when clicking outside the card
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Clear input
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          input.focus();
          clearBtn.style.display = 'none';
          renderResults();
        });
      }

      // Filter tabs
      filterTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          filterTabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          activeFilter = tab.getAttribute('data-filter') || 'all';
          selectedIndex = 0;
          renderResults();
        });
      });

      // Filter & Match Logic
      function getFilteredData() {
        const query = input.value.trim().toLowerCase();
        let items = searchData;

        // Apply category filter
        if (activeFilter !== 'all') {
          items = items.filter((item) => item.category.toLowerCase() === activeFilter.toLowerCase());
        }

        if (!query) {
          return items;
        }

        const words = query.split(/\s+/).filter(Boolean);

        return items.filter((item) => {
          const title = item.title.toLowerCase();
          const desc = item.description.toLowerCase();
          const cat = item.category.toLowerCase();
          const kw = (item.keywords || '').toLowerCase();
          const combined = `${title} ${desc} ${cat} ${kw}`;

          return words.every((w) => combined.includes(w));
        });
      }

      // Render search items
      function renderResults() {
        visibleItems = getFilteredData();
        const query = input.value.trim();

        if (clearBtn) {
          clearBtn.style.display = query.length > 0 ? 'block' : 'none';
        }

        if (countEl) {
          countEl.textContent = `${visibleItems.length} result${visibleItems.length === 1 ? '' : 's'}`;
        }

        if (visibleItems.length === 0) {
          resultsContainer.innerHTML = `
            <div class="search-empty-state">
              <svg class="search-empty-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
              <h3 class="search-empty-title">No results found for "${escapeHtml(query)}"</h3>
              <p class="search-empty-desc">Try checking for typos or searching for projects, skills, or blog articles.</p>
              <button type="button" class="search-empty-ai-btn" id="search-ask-ai-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path></svg>
                Ask SK Agent instead &rarr;
              </button>
            </div>
          `;

          const askAiBtn = document.getElementById('search-ask-ai-btn');
          if (askAiBtn) {
            askAiBtn.addEventListener('click', () => {
              closeModal();
              const chatTrigger = document.getElementById('chatbot-trigger');
              if (chatTrigger) chatTrigger.click();
              const chatTextarea = document.getElementById('chat-textarea');
              if (chatTextarea && query) {
                setTimeout(() => {
                  chatTextarea.value = query;
                  chatTextarea.dispatchEvent(new Event('input'));
                  chatTextarea.focus();
                }, 200);
              }
            });
          }
          return;
        }

        // Clamp selected index
        if (selectedIndex >= visibleItems.length) {
          selectedIndex = Math.max(0, visibleItems.length - 1);
        }

        // Group results by category if 'all' filter is active
        let html = '';
        let currentCategory = '';

        visibleItems.forEach((item, index) => {
          if (activeFilter === 'all' && item.category !== currentCategory) {
            currentCategory = item.category;
            html += `<div class="search-category-title">${currentCategory}</div>`;
          }

          const isSelected = index === selectedIndex;
          const href = item.url ? item.url : 'javascript:void(0);';
          const target = item.external ? 'target="_blank" rel="noopener noreferrer"' : '';

          html += `
            <a 
              href="${href}" 
              class="search-result-item ${isSelected ? 'is-selected' : ''}" 
              data-index="${index}"
              data-item-id="${item.id}"
              ${target}
            >
              <div class="search-item-icon">
                ${getIconSvg(item.icon)}
              </div>
              <div class="search-item-info">
                <div class="search-item-title-row">
                  <span class="search-item-title">${escapeHtml(item.title)}</span>
                  <span class="search-item-badge">${item.category}</span>
                </div>
                <span class="search-item-desc">${escapeHtml(item.description)}</span>
              </div>
              <div class="search-item-enter" title="Press Enter to open">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 10 4 15 9 20"></polyline>
                  <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
                </svg>
              </div>
            </a>
          `;
        });

        resultsContainer.innerHTML = html;

        // Attach click handlers to items
        const itemEls = resultsContainer.querySelectorAll('.search-result-item');
        itemEls.forEach((el) => {
          el.addEventListener('click', (e) => {
            const idx = parseInt(el.getAttribute('data-index') || '0', 10);
            executeItem(visibleItems[idx], e);
          });
        });

        // Ensure selected item is scrolled into view
        const selectedEl = resultsContainer.querySelector('.search-result-item.is-selected');
        if (selectedEl) {
          selectedEl.scrollIntoView({ block: 'nearest' });
        }
      }

      // Execute Action or Navigate
      function executeItem(item, event) {
        if (!item) return;

        if (item.action) {
          if (event) event.preventDefault();
          closeModal();

          if (item.action === 'openChatbot') {
            const chatTrigger = document.getElementById('chatbot-trigger');
            if (chatTrigger) chatTrigger.click();
          } else if (item.action === 'toggleTheme') {
            const themeToggleBtn = document.getElementById('theme-toggle');
            if (themeToggleBtn) {
              themeToggleBtn.click();
            } else {
              const current = document.documentElement.getAttribute('data-theme') || 'dark';
              const next = current === 'dark' ? 'light' : 'dark';
              document.documentElement.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
            }
          } else if (item.action === 'copyEmail') {
            navigator.clipboard.writeText('sunilkhobragade@proton.me').then(() => {
              alert('Copied Sunil\'s email (sunilkhobragade@proton.me) to clipboard!');
            });
          }
          return;
        }

        if (item.url && !item.external) {
          closeModal();
          window.location.href = item.url;
        } else if (item.external) {
          closeModal();
          window.open(item.url, '_blank', 'noopener,noreferrer');
        }
      }

      // Live search input handler
      input.addEventListener('input', () => {
        selectedIndex = 0;
        renderResults();
      });

      // Keyboard Navigation (Arrows, Enter, Escape)
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (visibleItems.length > 0) {
            selectedIndex = (selectedIndex + 1) % visibleItems.length;
            renderResults();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (visibleItems.length > 0) {
            selectedIndex = (selectedIndex - 1 + visibleItems.length) % visibleItems.length;
            renderResults();
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (visibleItems.length > 0) {
            executeItem(visibleItems[selectedIndex]);
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
        }
      });

      // Global Keyboard Shortcuts (Ctrl+K, Cmd+K, '/')
      document.addEventListener('keydown', (e) => {
        // Cmd+K or Ctrl+K
        if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          if (modal.classList.contains('is-active')) {
            closeModal();
          } else {
            openModal();
          }
        }

        // '/' shortcut when not in active input/textarea
        if (e.key === '/' && !modal.classList.contains('is-active')) {
          const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
          if (activeTag !== 'input' && activeTag !== 'textarea' && !document.activeElement.isContentEditable) {
            e.preventDefault();
            openModal();
          }
        }

        // Escape closes
        if (e.key === 'Escape' && modal.classList.contains('is-active')) {
          closeModal();
        }
      });

      function escapeHtml(text) {
        return (text || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
    }

    // Initialize on DOM load and Astro page transitions
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlobalSearch);
    } else {
      initGlobalSearch();
    }
    document.addEventListener('astro:after-swap', initGlobalSearch);
  })();
</script>
