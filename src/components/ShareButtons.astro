---
interface Props {
  title: string;
  description?: string;
  url?: string;
  tags?: string[];
  type?: 'project' | 'article';
}

const { 
  title, 
  description = '', 
  url, 
  tags = [], 
  type = 'project' 
} = Astro.props;

const shareLabel = type === 'project' ? 'Share Project' : 'Share Article';
---

<div class="share-widget-container" data-share-title={title} data-share-desc={description}>
  <div class="share-header-row">
    <div class="share-title-group">
      <svg class="share-main-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
      </svg>
      <span class="share-label-text">{shareLabel}</span>
    </div>
    <span class="share-hint-text">Spread the word or bookmark</span>
  </div>

  <div class="share-buttons-grid">
    <!-- Native Mobile Web Share (Auto-shown on supported mobile browsers) -->
    <button type="button" class="share-btn share-native-btn" id="native-share-trigger" aria-label="Share via system dialog" title="Share via device menu" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
        <polyline points="16 6 12 2 8 6"></polyline>
        <line x1="12" y1="2" x2="12" y2="15"></line>
      </svg>
      <span>Share</span>
    </button>

    <!-- X / Twitter -->
    <button type="button" class="share-btn share-twitter" id="share-x-btn" aria-label="Share on X (Twitter)" title="Post to X / Twitter">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>Post on X</span>
    </button>

    <!-- LinkedIn -->
    <button type="button" class="share-btn share-linkedin" id="share-linkedin-btn" aria-label="Share on LinkedIn" title="Share with LinkedIn network">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.55a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z"/>
      </svg>
      <span>LinkedIn</span>
    </button>

    <!-- WhatsApp -->
    <button type="button" class="share-btn share-whatsapp" id="share-whatsapp-btn" aria-label="Share on WhatsApp" title="Send via WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span>WhatsApp</span>
    </button>

    <!-- Copy Direct URL -->
    <button type="button" class="share-btn share-copy-btn" id="share-copy-link-btn" aria-label="Copy page link to clipboard" title="Copy link">
      <svg class="copy-icon-default" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg class="copy-icon-success" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none; color: #10b981;">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span id="share-copy-label">Copy Link</span>
    </button>
  </div>
</div>

<style>
  .share-widget-container {
    margin: 3rem 0 2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg, 12px);
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .share-widget-container:hover {
    border-color: var(--border-card-hover);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .share-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    font-size: 0.925rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .share-main-icon {
    color: #3b82f6;
    flex-shrink: 0;
  }

  .share-hint-text {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .share-buttons-grid {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-full, 9999px);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .share-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-card-hover);
    transform: translateY(-1.5px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .share-twitter:hover {
    color: #ffffff;
    background: #000000;
    border-color: #333333;
  }

  :global([data-theme="light"]) .share-twitter:hover {
    color: #ffffff;
    background: #0f1419;
    border-color: #0f1419;
  }

  .share-linkedin:hover {
    color: #ffffff;
    background: #0a66c2;
    border-color: #0a66c2;
  }

  .share-whatsapp:hover {
    color: #ffffff;
    background: #25d366;
    border-color: #25d366;
  }

  .share-native-btn:hover {
    color: #ffffff;
    background: #3b82f6;
    border-color: #3b82f6;
  }

  .share-copy-btn.copied {
    border-color: rgba(16, 185, 129, 0.6);
    background: rgba(16, 185, 129, 0.08);
    color: #10b981;
  }

  @media (max-width: 540px) {
    .share-widget-container {
      padding: 1rem 1.15rem;
    }

    .share-buttons-grid {
      gap: 0.5rem;
    }

    .share-btn {
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function setupShareButtons() {
    const container = document.querySelector('.share-widget-container');
    if (!container) return;

    const title = container.getAttribute('data-share-title') || document.title;
    const desc = container.getAttribute('data-share-desc') || '';
    const currentUrl = window.location.href;

    // 1. Native Web Share API
    const nativeBtn = document.getElementById('native-share-trigger');
    if (nativeBtn && navigator.share) {
      nativeBtn.style.display = 'inline-flex';
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: title,
            text: desc || `${title} by Sunil Khobragade`,
            url: currentUrl,
          });
        } catch (err) {
          // Ignore abort
        }
      });
    }

    // 2. X / Twitter Share
    const xBtn = document.getElementById('share-x-btn');
    if (xBtn) {
      xBtn.addEventListener('click', () => {
        const text = encodeURIComponent(`Check out "${title}" by @sunilkhobragade`);
        const u = encodeURIComponent(currentUrl);
        const twitterUrl = `https://twitter.com/intent/tweet?text=${text}&url=${u}`;
        window.open(twitterUrl, '_blank', 'noopener,noreferrer,width=600,height=450');
      });
    }

    // 3. LinkedIn Share
    const inBtn = document.getElementById('share-linkedin-btn');
    if (inBtn) {
      inBtn.addEventListener('click', () => {
        const u = encodeURIComponent(currentUrl);
        const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${u}`;
        window.open(linkedinUrl, '_blank', 'noopener,noreferrer,width=600,height=550');
      });
    }

    // 4. WhatsApp Share
    const waBtn = document.getElementById('share-whatsapp-btn');
    if (waBtn) {
      waBtn.addEventListener('click', () => {
        const text = encodeURIComponent(`${title} — ${currentUrl}`);
        const waUrl = `https://api.whatsapp.com/send?text=${text}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // 5. Copy Link to Clipboard
    const copyBtn = document.getElementById('share-copy-link-btn');
    const copyLabel = document.getElementById('share-copy-label');
    const iconDefault = copyBtn?.querySelector('.copy-icon-default');
    const iconSuccess = copyBtn?.querySelector('.copy-icon-success');

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(currentUrl);
          copyBtn.classList.add('copied');
          copyLabel.textContent = 'Copied!';
          if (iconDefault) (iconDefault as HTMLElement).style.display = 'none';
          if (iconSuccess) (iconSuccess as HTMLElement).style.display = 'inline-block';

          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyLabel.textContent = 'Copy Link';
            if (iconDefault) (iconDefault as HTMLElement).style.display = 'inline-block';
            if (iconSuccess) (iconSuccess as HTMLElement).style.display = 'none';
          }, 2000);
        } catch (e) {
          console.warn('Failed to copy link:', e);
        }
      });
    }
  }

  setupShareButtons();
  document.addEventListener('astro:after-swap', setupShareButtons);
</script>
