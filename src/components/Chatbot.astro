---
import { CHATBOT_SYSTEM_PROMPT, SUNIL_KNOWLEDGE_BASE } from '../data/chatbotKnowledge';

const defaultSystemPrompt = JSON.stringify(CHATBOT_SYSTEM_PROMPT);
const knowledgeData = JSON.stringify(SUNIL_KNOWLEDGE_BASE);
const envGroqKey = import.meta.env.PUBLIC_GROQ_API_KEY || '';
const envGroqModel = import.meta.env.PUBLIC_GROQ_MODEL || 'openai/gpt-oss-120b';
---

<!-- Floating AI Chatbot Container (Native Messenger Feel, Crisp 12.5px Typography, IndexedDB) -->
<div 
  id="sk-ai-chatbot" 
  class="sk-chatbot-root" 
  data-system-prompt={defaultSystemPrompt} 
  data-knowledge={knowledgeData}
  data-env-key={envGroqKey}
  data-model={envGroqModel}
>
  <!-- Compact Floating Launcher Button with "SK" (Bottom-Right) -->
  <button 
    type="button" 
    id="chatbot-trigger" 
    class="sk-launcher-btn"
    aria-label="Open AI Assistant"
    aria-expanded="false"
    title="Chat with Sunil's AI Assistant"
  >
    <div class="sk-launcher-inner">
      <!-- "SK" Brand Monogram Badge (Visible when closed) -->
      <span class="sk-launcher-sk">SK</span>
      <!-- Close Icon (Visible when open) -->
      <svg class="sk-icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>
    <span class="sk-status-dot" aria-hidden="true"></span>
  </button>

  <!-- Main AI Assistant Window Modal -->
  <div id="chatbot-panel" class="sk-chat-modal" aria-hidden="true" role="dialog" aria-label="AI Assistant Chat">
    
    <!-- Multi-direction Resize Handles -->
    <div id="resize-handle-corner" class="sk-resize-corner" title="Drag to resize"></div>
    <div id="resize-handle-top" class="sk-resize-edge-top" title="Drag to resize height"></div>
    <div id="resize-handle-left" class="sk-resize-edge-left" title="Drag to resize width"></div>

    <!-- Top Header Bar -->
    <header class="sk-modal-header">
      <div class="sk-header-left">
        <!-- Back Chevron -->
        <button type="button" id="chat-back-btn" class="sk-header-icon-btn" aria-label="Back">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <!-- Brand Icon Badge -->
        <div class="sk-brand-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M4 19C4 10.716 10.716 4 19 4V8C12.925 8 8 12.925 8 19H4Z" fill="url(#headerLogoGrad)"/>
            <path d="M8 19C8 12.925 12.925 8 19 8V12C15.134 12 12 15.134 12 19H8Z" fill="#38bdf8"/>
            <defs>
              <linearGradient id="headerLogoGrad" x1="4" y1="4" x2="19" y2="19" gradientUnits="userSpaceOnUse">
                <stop stop-color="#ec4899"/>
                <stop offset="0.5" stop-color="#a855f7"/>
                <stop offset="1" stop-color="#38bdf8"/>
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Title & Subtitle -->
        <div class="sk-header-titles">
          <div class="sk-title-row">
            <h2 class="sk-modal-title">SK Agent <span class="sk-agent-pill">AI</span></h2>
          </div>
          <p class="sk-modal-subtitle">Sunil's AI Assistant &bull; Online</p>
        </div>
      </div>

      <!-- Header Action Controls (Right) -->
      <div class="sk-header-right">
        <!-- Expand / Shrink Size Toggle Button -->
        <button type="button" id="chat-resize-btn" class="sk-header-icon-btn" title="Toggle Size (Compact / Expanded)" aria-label="Resize window">
          <svg id="icon-expand" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <svg id="icon-shrink" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>

        <!-- Options Menu Button (•••) -->
        <div class="sk-options-dropdown-wrap">
          <button type="button" id="chat-options-btn" class="sk-header-icon-btn" aria-label="More options" aria-haspopup="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="5" cy="12" r="2"></circle>
              <circle cx="12" cy="12" r="2"></circle>
              <circle cx="19" cy="12" r="2"></circle>
            </svg>
          </button>
          <div id="chat-options-menu" class="sk-options-menu" aria-hidden="true">
            <button type="button" class="sk-menu-item" id="opt-clear-chat">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
              Clear Conversation
            </button>
            <a href="/tools/appointment" class="sk-menu-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              Book 1:1 Consultation
            </a>
            <a href="mailto:sunilkhobragade@proton.me" class="sk-menu-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              Email Sunil Directly
            </a>
          </div>
        </div>

        <!-- Close Button (✕) -->
        <button type="button" id="chat-close-btn" class="sk-header-icon-btn" aria-label="Close Chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Chat Messages Scroll Container -->
    <main id="chat-messages-container" class="sk-messages-box">
      <!-- Default Bot Greeting Message -->
      <div class="sk-msg-row bot">
        <div class="sk-bubble bot">
          <div class="sk-bubble-content">
            Hi there! I'm <strong>SK Agent</strong>, Sunil Khobragade's AI Assistant. How can I help you today?
          </div>
          <div class="sk-bubble-footer">
            <span class="sk-time-text" id="init-bot-time"></span>
          </div>
        </div>
      </div>

      <!-- Quick Suggestion Chips -->
      <div class="sk-quick-chips" id="quick-chips">
        <button type="button" class="sk-chip-btn" data-query="What are Sunil's core skills and AI expertise?">
          Skills &amp; AI
        </button>
        <button type="button" class="sk-chip-btn" data-query="Tell me about Sunil's top projects.">
          Projects
        </button>
        <button type="button" class="sk-chip-btn" data-query="What is Sunil's work experience?">
          Experience
        </button>
        <button type="button" class="sk-chip-btn" data-query="How can I contact or hire Sunil?">
          Contact / Hire
        </button>
      </div>
    </main>

    <!-- Input Footer Card Container -->
    <footer class="sk-modal-footer">
      <div class="sk-input-card">
        <textarea 
          id="chat-textarea" 
          class="sk-input-field" 
          rows="1" 
          placeholder="Message..."
          aria-label="Message..."
        ></textarea>

        <!-- Bottom Action Bar inside input card -->
        <div class="sk-input-actions">
          <!-- Left Utilities Toolbar -->
          <div class="sk-left-tools">
            <!-- Paperclip -->
            <button type="button" class="sk-tool-btn" id="tool-attach-btn" title="Download Profile Summary" aria-label="Profile">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
              </svg>
            </button>

            <!-- Emoji -->
            <button type="button" class="sk-tool-btn" id="tool-emoji-btn" title="Insert Emoji" aria-label="Emoji">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
              </svg>
            </button>

            <!-- GIF -->
            <button type="button" class="sk-tool-btn" id="tool-gif-btn" title="Explore Projects" aria-label="Projects">
              <span class="sk-gif-text">GIF</span>
            </button>

            <!-- Microphone -->
            <button type="button" class="sk-tool-btn" id="tool-mic-btn" title="Voice Input" aria-label="Voice input">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="22"></line>
              </svg>
            </button>
          </div>

          <!-- Right Send Button -->
          <button 
            type="button" 
            id="chat-send-btn" 
            class="sk-send-btn" 
            aria-label="Send Message" 
            disabled
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </footer>
  </div>
</div>

<style>
  /* ==========================================================================
     Crisp Native Chat Application Theme & Typography
     ========================================================================== */
  
  .sk-chatbot-root {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

    /* Base Light Mode Tokens */
    --sk-chat-bg: #f8fafc;
    --sk-chat-header-bg: #ffffff;
    --sk-chat-border: #e2e8f0;
    --sk-chat-divider: #f1f5f9;
    --sk-chat-messages-bg: #f4f6f8;
    
    /* Native Chat Bubbles */
    --sk-chat-bot-bubble-bg: #ffffff;
    --sk-chat-bot-bubble-text: #0f172a;
    --sk-chat-bot-bubble-border: #e2e8f0;
    --sk-chat-bot-time: #94a3b8;

    --sk-chat-user-bubble-bg: #ffffff;
    --sk-chat-user-bubble-text: #0f172a;
    --sk-chat-user-bubble-border: #cbd5e1;
    --sk-chat-user-time: #94a3b8;

    --sk-chat-input-bg: #ffffff;
    --sk-chat-input-border: #e2e8f0;
    --sk-chat-input-text: #0f172a;
    --sk-chat-placeholder: #94a3b8;
    --sk-chat-title: #0f172a;
    --sk-chat-subtitle: #64748b;
    --sk-chat-icon-btn: #64748b;
    --sk-chat-icon-hover-bg: #f1f5f9;
    --sk-chat-icon-hover-text: #0f172a;
    --sk-chat-chip-bg: #ffffff;
    --sk-chat-chip-border: #e2e8f0;
    --sk-chat-chip-text: #334155;
    --sk-chat-chip-hover-bg: #f1f5f9;
    --sk-chat-chip-hover-border: #94a3b8;
    --sk-chat-chip-hover-text: #0f172a;
    --sk-chat-send-bg: #e2e8f0;
    --sk-chat-send-color: #94a3b8;
    --sk-chat-send-active-bg: #0f172a;
    --sk-chat-send-active-color: #ffffff;
    --sk-chat-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    --sk-chat-launcher-bg: #ffffff;
    --sk-chat-launcher-border: rgba(0, 0, 0, 0.1);
    --sk-chat-brand-badge-bg: #f8fafc;
    --sk-chat-code-bg: rgba(0, 0, 0, 0.05);
    --sk-chat-link: #2563eb;
    --sk-tick-color: #38bdf8;
  }

  /* 🌙 System Preference: Dark Mode */
  @media (prefers-color-scheme: dark) {
    .sk-chatbot-root {
      --sk-chat-bg: #121216;
      --sk-chat-header-bg: #16161b;
      --sk-chat-border: #26262e;
      --sk-chat-divider: #1f1f26;
      --sk-chat-messages-bg: #0d0d10;

      /* Dark Messenger Bubbles */
      --sk-chat-bot-bubble-bg: #18181f;
      --sk-chat-bot-bubble-text: #f1f5f9;
      --sk-chat-bot-bubble-border: #26262e;
      --sk-chat-bot-time: #64748b;

      --sk-chat-user-bubble-bg: #2563eb;
      --sk-chat-user-bubble-text: #ffffff;
      --sk-chat-user-bubble-border: transparent;
      --sk-chat-user-time: rgba(255, 255, 255, 0.7);

      --sk-chat-input-bg: #18181f;
      --sk-chat-input-border: #26262e;
      --sk-chat-input-text: #f1f5f9;
      --sk-chat-placeholder: #64748b;
      --sk-chat-title: #f8fafc;
      --sk-chat-subtitle: #94a3b8;
      --sk-chat-icon-btn: #94a3b8;
      --sk-chat-icon-hover-bg: #22222b;
      --sk-chat-icon-hover-text: #ffffff;
      --sk-chat-chip-bg: #18181f;
      --sk-chat-chip-border: #26262e;
      --sk-chat-chip-text: #cbd5e1;
      --sk-chat-chip-hover-bg: #22222b;
      --sk-chat-chip-hover-border: #3b82f6;
      --sk-chat-chip-hover-text: #ffffff;
      --sk-chat-send-bg: #26262e;
      --sk-chat-send-color: #64748b;
      --sk-chat-send-active-bg: #3b82f6;
      --sk-chat-send-active-color: #ffffff;
      --sk-chat-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
      --sk-chat-launcher-bg: #16161b;
      --sk-chat-launcher-border: #26262e;
      --sk-chat-brand-badge-bg: #22222b;
      --sk-chat-code-bg: rgba(255, 255, 255, 0.08);
      --sk-chat-link: #60a5fa;
      --sk-tick-color: #38bdf8;
    }
  }

  /* Explicit theme attributes */
  [data-theme="dark"] .sk-chatbot-root,
  .sk-chatbot-root.theme-dark {
    --sk-chat-bg: #121216;
    --sk-chat-header-bg: #16161b;
    --sk-chat-border: #26262e;
    --sk-chat-divider: #1f1f26;
    --sk-chat-messages-bg: #0d0d10;
    --sk-chat-bot-bubble-bg: #18181f;
    --sk-chat-bot-bubble-text: #f1f5f9;
    --sk-chat-bot-bubble-border: #26262e;
    --sk-chat-bot-time: #64748b;
    --sk-chat-user-bubble-bg: #2563eb;
    --sk-chat-user-bubble-text: #ffffff;
    --sk-chat-user-bubble-border: transparent;
    --sk-chat-user-time: rgba(255, 255, 255, 0.7);
    --sk-chat-input-bg: #18181f;
    --sk-chat-input-border: #26262e;
    --sk-chat-input-text: #f1f5f9;
    --sk-chat-placeholder: #64748b;
    --sk-chat-title: #f8fafc;
    --sk-chat-subtitle: #94a3b8;
    --sk-chat-icon-btn: #94a3b8;
    --sk-chat-icon-hover-bg: #22222b;
    --sk-chat-icon-hover-text: #ffffff;
    --sk-chat-chip-bg: #18181f;
    --sk-chat-chip-border: #26262e;
    --sk-chat-chip-text: #cbd5e1;
    --sk-chat-chip-hover-bg: #22222b;
    --sk-chat-chip-hover-border: #3b82f6;
    --sk-chat-chip-hover-text: #ffffff;
    --sk-chat-send-bg: #26262e;
    --sk-chat-send-color: #64748b;
    --sk-chat-send-active-bg: #3b82f6;
    --sk-chat-send-active-color: #ffffff;
    --sk-chat-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
    --sk-chat-launcher-bg: #16161b;
    --sk-chat-launcher-border: #26262e;
    --sk-chat-brand-badge-bg: #22222b;
    --sk-chat-code-bg: rgba(255, 255, 255, 0.08);
    --sk-chat-link: #60a5fa;
    --sk-tick-color: #38bdf8;
  }

  [data-theme="light"] .sk-chatbot-root,
  .sk-chatbot-root.theme-light {
    --sk-chat-bg: #f8fafc;
    --sk-chat-header-bg: #ffffff;
    --sk-chat-border: #e2e8f0;
    --sk-chat-divider: #f1f5f9;
    --sk-chat-messages-bg: #f4f6f8;
    --sk-chat-bot-bubble-bg: #ffffff;
    --sk-chat-bot-bubble-text: #0f172a;
    --sk-chat-bot-bubble-border: #e2e8f0;
    --sk-chat-bot-time: #94a3b8;
    --sk-chat-user-bubble-bg: #ffffff;
    --sk-chat-user-bubble-text: #0f172a;
    --sk-chat-user-bubble-border: #cbd5e1;
    --sk-chat-user-time: #94a3b8;
    --sk-chat-input-bg: #ffffff;
    --sk-chat-input-border: #e2e8f0;
    --sk-chat-input-text: #0f172a;
    --sk-chat-placeholder: #94a3b8;
    --sk-chat-title: #0f172a;
    --sk-chat-subtitle: #64748b;
    --sk-chat-icon-btn: #64748b;
    --sk-chat-icon-hover-bg: #f1f5f9;
    --sk-chat-icon-hover-text: #0f172a;
    --sk-chat-chip-bg: #ffffff;
    --sk-chat-chip-border: #e2e8f0;
    --sk-chat-chip-text: #334155;
    --sk-chat-chip-hover-bg: #f1f5f9;
    --sk-chat-chip-hover-border: #94a3b8;
    --sk-chat-chip-hover-text: #0f172a;
    --sk-chat-send-bg: #e2e8f0;
    --sk-chat-send-color: #94a3b8;
    --sk-chat-send-active-bg: #0f172a;
    --sk-chat-send-active-color: #ffffff;
    --sk-chat-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    --sk-chat-launcher-bg: #ffffff;
    --sk-chat-launcher-border: rgba(0, 0, 0, 0.1);
    --sk-chat-brand-badge-bg: #f8fafc;
    --sk-chat-code-bg: rgba(0, 0, 0, 0.05);
    --sk-chat-link: #2563eb;
    --sk-tick-color: #38bdf8;
  }

  /* Compact Floating Launcher Button with "SK" */
  .sk-launcher-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sk-chat-launcher-bg);
    border: 1px solid var(--sk-chat-launcher-border);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.16);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sk-launcher-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.24);
  }

  .sk-launcher-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .sk-launcher-sk {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    user-select: none;
    line-height: 1;
  }

  .sk-icon-close {
    display: none;
    color: var(--sk-chat-title);
  }

  .sk-chatbot-root.is-open .sk-launcher-sk {
    display: none;
  }

  .sk-chatbot-root.is-open .sk-icon-close {
    display: block;
  }

  .sk-status-dot {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid var(--sk-chat-launcher-bg);
  }

  /* Chatbot Modal Container */
  .sk-chat-modal {
    position: absolute;
    bottom: 56px;
    right: 0;
    width: 375px;
    min-width: 310px;
    max-width: calc(100vw - 32px);
    height: 560px;
    min-height: 380px;
    max-height: calc(100vh - 80px);
    background: var(--sk-chat-bg);
    border: 1px solid var(--sk-chat-border);
    border-radius: 16px;
    box-shadow: var(--sk-chat-shadow);
    display: flex;
    flex-direction: column;
    overflow: hidden;
