    try {
      systemPrompt = JSON.parse(wrapper.getAttribute('data-system-prompt') || '""');
    } catch (e) {
      systemPrompt = wrapper.getAttribute('data-system-prompt') || '';
    }

    // =========================================================================
    // Size Switcher Logic (Normal: 380x540, Expanded: 540x660)
    // =========================================================================
    let isExpanded = localStorage.getItem('sk_chatbot_expanded') === 'true';

    function applyWindowSize(expanded) {
      if (!panel || window.innerWidth <= 640) return;
      if (expanded) {
        panel.style.width = '540px';
        panel.style.height = '660px';
        if (sizeIconExpand) sizeIconExpand.style.display = 'none';
        if (sizeIconShrink) sizeIconShrink.style.display = 'block';
      } else {
        panel.style.width = '380px';
        panel.style.height = '540px';
        if (sizeIconExpand) sizeIconExpand.style.display = 'block';
        if (sizeIconShrink) sizeIconShrink.style.display = 'none';
      }
    }

    applyWindowSize(isExpanded);

    sizeToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      isExpanded = !isExpanded;
      localStorage.setItem('sk_chatbot_expanded', isExpanded.toString());
      document.cookie = `sk_chat_expanded=${isExpanded}; max-age=31536000; path=/; SameSite=Lax`;
      applyWindowSize(isExpanded);
    });

    // =========================================================================
    // Intelligent Knowledge Base Predefined Fallback Responder
    // =========================================================================
    function getKnowledgeFallback(query) {
      const q = query.toLowerCase();

      if (q.includes('education') || q.includes('degree') || q.includes('college') || q.includes('university') || q.includes('study') || q.includes('school') || q.includes('qualif')) {
        return "🎓 **Sunil Khobragade's Educational Background**:\n\n• **M.Sc. in Information Security** (2025–Present) | IGNOU, Hyderabad\n  Specializing in cryptography, application security, cloud security posture, and zero-trust architectures.\n\n• **Post Graduate Diploma in Information Security** (2024–2025) | IGNOU, Hyderabad\n  OWASP Top 10, security auditing, vulnerability assessment, and threat modeling.\n\n• **Advanced Diploma in IT, Networking & Cloud Computing** (2019–2022) | NSTI Hyderabad (IBM Aligned)\n  Enterprise Linux, networking protocols, Docker containerization, and cloud infrastructure.\n\n• **Bachelor of Commerce (B.Com)** (2019–2022) | YCMOU\n\n• **Google Cloud Gen AI Academy APAC** Certification in Vertex AI & LLM solutions.\n\nExplore full details on the [Education](/education) page!";
      }

      if (q.includes('work') || q.includes('experience') || q.includes('job') || q.includes('company') || q.includes('career') || q.includes('role') || q.includes('history') || q.includes('intencode')) {
        return "💼 **Sunil's Work Experience & Timeline**:\n\n• **Full-Stack Developer** at Intencode India Pvt. Ltd. (Oct 2022 – Present)\n  Leading full-stack web architecture, high-throughput microservices, API engineering, and automated deployments with Docker & GitHub Actions.\n\n• **Freelance Solutions Architect & Full-Stack Developer** (Jan 2020 – Sep 2022)\n  Engineered 15+ production-grade web applications, booking engines, and payment integrations for international clients.\n\n• **Full-Stack Developer Intern** at IBM India (Sep 2021 – Feb 2022)\n  Modernized cloud-native workflows and microservices.\n\nRead the full story on the [Work](/work) page!";
      }

      if (q.includes('project') || q.includes('built') || q.includes('app') || q.includes('portfolio') || q.includes('demo') || q.includes('pulse') || q.includes('lms')) {
        return "🚀 **Featured Projects by Sunil**:\n\n• **Pulse Chat**: Real-time customer support platform with WebSocket messaging and automated knowledge base AI.\n• **AI-Enabled LMS**: Full-scale education platform featuring interactive classrooms, live streaming, and course management.\n• **E-Commerce Platform**: High-conversion storefront with multi-gateway payments (Stripe, Razorpay, PhonePe) and inventory sync.\n• **Real-Time Appointment Booking**: Concurrency-safe scheduling system with distributed slot locking.\n\nCheck out live demos on the [Projects](/projects) page!";
      }

      if (q.includes('skill') || q.includes('stack') || q.includes('tech') || q.includes('backend') || q.includes('frontend') || q.includes('cloud') || q.includes('node') || q.includes('react') || q.includes('aws') || q.includes('python') || q.includes('database')) {
        return "💻 **Technical Skills & Stack**:\n\n• **Backend**: Node.js (Express, Fastify, Nest.js), PHP (Laravel), Python (Django, FastAPI), Microservices, REST APIs.\n• **Frontend**: React, Next.js, Angular, TypeScript, JavaScript (ES6+), Astro, HTML5, CSS3, TailwindCSS.\n• **Databases & Cache**: PostgreSQL, MySQL, MongoDB, Redis, Query Optimization, Database Indexing.\n• **Cloud & DevOps**: AWS (ECS, Lambda, S3, RDS), Azure, Docker, Kubernetes, Nginx, GitHub Actions CI/CD, Linux.\n• **Payments & Tools**: Stripe, Razorpay, PhonePe, Postman, Bruno, Git.\n\nView the full matrix on the [Education & Skills](/education) page!";
      }

      if (q.includes('blog') || q.includes('article') || q.includes('post') || q.includes('write') || q.includes('writing')) {
        return "✍️ **Technical Blog Articles by Sunil**:\n\n• *Building High-Throughput Microservices with Node.js and Redis*\n• *Architecting Concurrency-Safe Booking Systems*\n• *Zero-Downtime Deployments with Docker and GitHub Actions*\n• *Integrating Multi-Gateway Payments with Clean Architecture*\n\nRead all articles on the [Blog](/blog) page!";
      }

      if (q.includes('hire') || q.includes('contact') || q.includes('book') || q.includes('call') || q.includes('email') || q.includes('cost') || q.includes('rate') || q.includes('estimate') || q.includes('meet')) {
        return "📅 **Get in Touch with Sunil**:\n\n• **Direct Email**: [sunilkhobragade@proton.me](mailto:sunilkhobragade@proton.me)\n• **1:1 Consultation**: Book a Google Calendar meeting on the [Tools & Booking](/tools) page.\n• **Project Cost Estimator**: Calculate budget, timeline, and recommended tech stack instantly on the [Project Estimator](/tools) page!";
      }

      if (q.includes('hi') || q.includes('hello') || q.includes('hey') || q.includes('who are you') || q.includes('what can you do')) {
        return "👋 Hi there! I'm **Sunil's AI Assistant**.\n\nI can answer questions about:\n• 🎓 **Education & Certifications**\n• 💼 **Work Experience & Career Timeline**\n• 🚀 **Featured Projects & Demos**\n• 💻 **Tech Stack & Cloud Architecture**\n• ✍️ **Engineering Blog Posts**\n• 📅 **Booking a Consultation or Project Estimate**\n\nWhat would you like to know?";
      }

      return "Sunil Khobragade is a Senior Full-Stack Developer & Solutions Architect with 6+ years of experience specializing in Node.js, Laravel, Python, React, Next.js, and Cloud Systems.\n\nYou can explore his [Work Experience](/work), [Featured Projects](/projects), [Technical Blog](/blog), or schedule a consultation on the [Tools & Booking](/tools) page!\n\nFeel free to ask about his education, skills, or specific projects!";
    }

    // =========================================================================
    // Forever Conversation Storage (Cookies + LocalStorage)
    // =========================================================================
    const STORAGE_KEY = 'sk_chat_messages_forever';
    let conversationHistory = [];

    function getTimeString(dateObj) {
      const d = dateObj ? new Date(dateObj) : new Date();
      return new Intl.DateTimeFormat('en-US', { hour: '2-digit', minute: '2-digit', hour12: false }).format(d);
    }

    function formatMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\n/g, '<br/>');
    }

    function saveForeverHistory(msgs) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(msgs));
        const simplified = msgs.slice(-10).map(m => ({ r: m.role, c: m.content.slice(0, 100) }));
        document.cookie = `sk_chat_session_msgs=${encodeURIComponent(JSON.stringify(simplified))}; max-age=31536000; path=/; SameSite=Lax`;
      } catch (e) {}
    }

    function loadForeverHistory() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        return JSON.parse(raw);
      } catch (e) {
        return [];
      }
    }

    function renderStoredMessages() {
      const saved = loadForeverHistory();
      if (!saved || saved.length === 0) return;

      if (heroWelcomeCard) heroWelcomeCard.style.display = 'none';

      saved.forEach((msg) => {
        appendMessageUI(msg.role, msg.content, msg.time || getTimeString());
        conversationHistory.push({ role: msg.role === 'bot' ? 'assistant' : 'user', content: msg.content });
      });
    }

    // =========================================================================
    // Proactive Greeting Pop-up
    // =========================================================================
    const RANDOM_GREETINGS = [
      "Good day! Ready to explore Sunil's work? Ask me anything about his projects, experience, or skills.",
      "Looking to build a project or hire a senior engineer? Let's chat!",
      "Curious about Sunil's tech stack, microservices, or cloud architectures? Ask me!",
      "Want to know about Sunil's Information Security degrees or certifications? Ask away!",
      "Need a timeline or cost estimate for your next web app? Click to chat!"
    ];

    function showProactiveGreeting() {
      if (sessionStorage.getItem('sk_greeting_dismissed') === 'true') return;
      if (wrapper.classList.contains('open')) return;

      const randomMsg = RANDOM_GREETINGS[Math.floor(Math.random() * RANDOM_GREETINGS.length)];
      if (dynamicGreeting) dynamicGreeting.textContent = randomMsg;

      setTimeout(() => {
        if (!wrapper.classList.contains('open') && greetingBubble) {
          greetingBubble.style.display = 'flex';
        }
      }, 1800);
    }

    showProactiveGreeting();

    greetingCloseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (greetingBubble) greetingBubble.style.display = 'none';
      sessionStorage.setItem('sk_greeting_dismissed', 'true');
    });

    greetingTextWrap?.addEventListener('click', () => {
      if (greetingBubble) greetingBubble.style.display = 'none';
      sessionStorage.setItem('sk_greeting_dismissed', 'true');
      toggleChat(true);
    });

    // Toggle Chatbot
    function toggleChat(openState) {
      const isCurrentlyOpen = wrapper.classList.contains('open');
      const shouldOpen = openState !== undefined ? openState : !isCurrentlyOpen;
      
      wrapper.classList.toggle('open', shouldOpen);
      if (panel) panel.setAttribute('aria-hidden', (!shouldOpen).toString());
      
      if (shouldOpen) {
        if (greetingBubble) greetingBubble.style.display = 'none';
        sessionStorage.setItem('sk_greeting_dismissed', 'true');
        setTimeout(() => userInput.focus(), 150);
        updateSpamStatus();
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    trigger.addEventListener('click', () => toggleChat());
    closeModalBtn?.addEventListener('click', () => {
      menuDropdown.style.display = 'none';
      toggleChat(false);
    });

    // Three Dots Menu
    menuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menuDropdown) {
        menuDropdown.style.display = menuDropdown.style.display === 'none' ? 'block' : 'none';
      }
    });

    document.addEventListener('click', (e) => {
      if (menuDropdown && !menuDropdown.contains(e.target) && e.target !== menuBtn) {
        menuDropdown.style.display = 'none';
      }
    });

    // Clear Chat Forever
    clearBtn?.addEventListener('click', () => {
      if (menuDropdown) menuDropdown.style.display = 'none';
      localStorage.removeItem(STORAGE_KEY);
      document.cookie = `sk_chat_session_msgs=; max-age=0; path=/;`;
      conversationHistory = [];

      if (messagesContainer) {
        messagesContainer.innerHTML = `
          <div id="sk-hero-welcome-card" class="sk-hero-card">
            <div class="sk-hero-avatar">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 8V4H8"></path>
                <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                <path d="M2 14h2"></path>
                <path d="M20 14h2"></path>
                <path d="M15 13v2"></path>
                <path d="M9 13v2"></path>
              </svg>
            </div>
            <p class="sk-hero-text">
              Chat history reset! Ready to explore?<br/>
              Ask me anything about Sunil's experience, skills &amp; projects.
            </p>
            <div class="sk-hero-meta">
              <span class="sk-hero-time">Just now</span>
              <span class="sk-check-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </div>
          </div>
        `;
      }
    });

    // Send Button Active State
    userInput.addEventListener('input', () => {
      if (userInput.value.trim().length > 0) {
        sendBtn.classList.add('active');
      } else {
        sendBtn.classList.remove('active');
      }
    });

    // Emoji Helper
    emojiBtn?.addEventListener('click', () => {
      const emojis = ['🚀', '✨', '💻', '🎓', '👋', '🔥'];
      const pick = emojis[Math.floor(Math.random() * emojis.length)];
      userInput.value += `${pick} `;
      userInput.focus();
      sendBtn.classList.add('active');
    });

    // Mic Tool
    micBtn?.addEventListener('click', () => {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        userInput.placeholder = "Speech recognition not supported in this browser.";
        setTimeout(() => userInput.placeholder = "Write your answer...", 2500);
        return;
      }
      const recognition = new SpeechRecognition();
      recognition.lang = 'en-US';
      recognition.onstart = () => {
        userInput.placeholder = "Listening...";
      };
      recognition.onresult = (event) => {
        const transcript = event.results[0][0].transcript;
        userInput.value = transcript;
        userInput.placeholder = "Write your answer...";
        sendBtn.classList.add('active');
      };
      recognition.onerror = () => {
        userInput.placeholder = "Write your answer...";
      };
      recognition.start();
    });

    // =========================================================================
    // Anti-Spam & Rate Limiting Engine
    // =========================================================================
    const MAX_MESSAGES_PER_WINDOW = 10;
    const WINDOW_DURATION_MS = 10 * 60 * 1000;
    const MIN_COOLDOWN_MS = 3000;
    let cooldownTimer = null;

    function getRateHistory() {
      try {
        const raw = localStorage.getItem('sk_chat_history_timestamps');
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function recordRateMessage() {
      const now = Date.now();
      const history = getRateHistory().filter((t) => now - t < WINDOW_DURATION_MS);
      history.push(now);
      localStorage.setItem('sk_chat_history_timestamps', JSON.stringify(history));
      document.cookie = `sk_chat_last=${now}; path=/; max-age=600; SameSite=Lax`;
    }

    function checkRateLimit() {
      const now = Date.now();
      const history = getRateHistory().filter((t) => now - t < WINDOW_DURATION_MS);

      if (history.length > 0) {
        const last = history[history.length - 1];
        if (now - last < MIN_COOLDOWN_MS) {
          const remainingSecs = Math.max(1, Math.ceil((MIN_COOLDOWN_MS - (now - last)) / 1000));
          return { 
            allowed: false, 
            isCooldown: true,
            remainingSecs: remainingSecs,
            reason: `Please wait ${remainingSecs}s before sending again.` 
          };
        }
      }

      if (history.length >= MAX_MESSAGES_PER_WINDOW) {
        const oldest = history[0];
        const resetSecs = Math.ceil((WINDOW_DURATION_MS - (now - oldest)) / 1000);
        const resetMins = Math.ceil(resetSecs / 60);
        return { 
          allowed: false, 
          isCooldown: false,
          remainingSecs: resetSecs,
          reason: `Rate limit reached (${MAX_MESSAGES_PER_WINDOW}/10m). Resets in ${resetMins} min.` 
        };
      }

      return { allowed: true, remaining: MAX_MESSAGES_PER_WINDOW - history.length };
    }

    function updateSpamStatus() {
      const status = checkRateLimit();

      if (!status.allowed && rateLimitBanner && rateLimitText) {
        rateLimitText.textContent = status.reason;
        rateLimitBanner.style.display = 'flex';
        sendBtn.disabled = true;

        if (cooldownTimer) clearInterval(cooldownTimer);
        let countdown = status.remainingSecs || 3;
        
        cooldownTimer = setInterval(() => {
          countdown -= 1;
          if (countdown <= 0) {
            clearInterval(cooldownTimer);
            cooldownTimer = null;
            if (rateLimitBanner) rateLimitBanner.style.display = 'none';
            if (sendBtn) sendBtn.disabled = false;
          } else {
            if (rateLimitText) {
              rateLimitText.textContent = status.isCooldown 
                ? `Please wait ${countdown}s before sending again.`
                : status.reason;
            }
          }
        }, 1000);
      } else if (rateLimitBanner) {
        rateLimitBanner.style.display = 'none';
        sendBtn.disabled = false;
        if (cooldownTimer) {
          clearInterval(cooldownTimer);
          cooldownTimer = null;
        }
      }
    }

    // Append Message to UI
    function appendMessageUI(role, text, timeStr) {
      if (heroWelcomeCard) heroWelcomeCard.style.display = 'none';

      const row = document.createElement('div');
      row.className = `sk-msg-row ${role === 'user' ? 'sk-row-user' : 'sk-row-bot'}`;

      if (role === 'bot') {
        const botAvatar = document.createElement('div');
        botAvatar.className = 'sk-bot-avatar';
        botAvatar.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M15 13v2"></path>
            <path d="M9 13v2"></path>
          </svg>
        `;
        row.appendChild(botAvatar);

        const bubble = document.createElement('div');
        bubble.className = 'sk-bubble-bot';

        const contentDiv = document.createElement('div');
        contentDiv.className = 'sk-content';
        contentDiv.innerHTML = formatMarkdown(text);

        const metaRow = document.createElement('div');
        metaRow.className = 'sk-meta';
        metaRow.innerHTML = `
          <span class="sk-time">${timeStr || getTimeString()}</span>
          <span class="sk-check-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        `;

        bubble.appendChild(contentDiv);
        bubble.appendChild(metaRow);
        row.appendChild(bubble);
      } else {
        const bubble = document.createElement('div');
        bubble.className = 'sk-bubble-user';

        const contentDiv = document.createElement('div');
        contentDiv.className = 'sk-content';
        contentDiv.innerHTML = text.replace(/</g, '&lt;').replace(/>/g, '&gt;');

        bubble.appendChild(contentDiv);
        row.appendChild(bubble);
      }

      messagesContainer.appendChild(row);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Add Typing Indicator
    function showTyping() {
      const row = document.createElement('div');
      row.id = 'typing-row';
      row.className = 'sk-msg-row sk-row-bot';
      row.innerHTML = `
        <div class="sk-bot-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M15 13v2"></path>
            <path d="M9 13v2"></path>
          </svg>
        </div>
        <div class="sk-bubble-bot">
          <div class="sk-typing-wave">
            <span class="sk-dot"></span>
            <span class="sk-dot"></span>
            <span class="sk-dot"></span>
          </div>
        </div>
      `;
      messagesContainer.appendChild(row);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function hideTyping() {
      const typing = document.getElementById('typing-row');
      if (typing) typing.remove();
    }

    // Restore forever messages on load
    renderStoredMessages();

    // Form Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = userInput.value.trim();
      if (!message) return;

      const check = checkRateLimit();
      if (!check.allowed) {
        updateSpamStatus();
        return;
      }

      recordRateMessage();
      updateSpamStatus();

      const timeNow = getTimeString();
      appendMessageUI('user', message, timeNow);

      const currentList = loadForeverHistory();
      currentList.push({ role: 'user', content: message, time: timeNow });
      saveForeverHistory(currentList);

      userInput.value = '';
      sendBtn.classList.remove('active');
      showTyping();
      sendBtn.disabled = true;

      conversationHistory.push({ role: 'user', content: message });
      if (conversationHistory.length > 8) {
        conversationHistory = conversationHistory.slice(-8);
      }

      const activeKey = envKey;

      if (!activeKey) {
        hideTyping();
        sendBtn.disabled = false;
        const fallbackReply = getKnowledgeFallback(message);
        const botTime = getTimeString();
        appendMessageUI('bot', fallbackReply, botTime);
        currentList.push({ role: 'bot', content: fallbackReply, time: botTime });
        saveForeverHistory(currentList);
        return;
      }

      // Groq API Call with Auto-Fallback to Predefined Answers if rate limited or failing
      try {
        // Use llama-3.1-8b-instant which has a 5x larger free token limit (500k TPD)
        const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${activeKey}`
          },
          body: JSON.stringify({
            model: 'llama-3.1-8b-instant',
            messages: [
              { role: 'system', content: systemPrompt },
              ...conversationHistory
            ],
            temperature: 0.6,
            max_tokens: 400
          })
        });

        hideTyping();
        sendBtn.disabled = false;

        if (!response.ok) {
          // If Groq API rate limited (429) or failed, seamlessly deliver accurate predefined portfolio answer!
          console.warn('Groq API status', response.status, '- using local knowledge base fallback');
          const fallbackReply = getKnowledgeFallback(message);
          const botTime = getTimeString();
          conversationHistory.push({ role: 'assistant', content: fallbackReply });
          appendMessageUI('bot', fallbackReply, botTime);
          currentList.push({ role: 'bot', content: fallbackReply, time: botTime });
          saveForeverHistory(currentList);
          return;
        }

        const data = await response.json();
        const replyText = data.choices?.[0]?.message?.content || getKnowledgeFallback(message);

        conversationHistory.push({ role: 'assistant', content: replyText });
        const botTime = getTimeString();
        appendMessageUI('bot', replyText, botTime);

        // Store forever
        currentList.push({ role: 'bot', content: replyText, time: botTime });
        saveForeverHistory(currentList);
      } catch (err) {
        hideTyping();
        sendBtn.disabled = false;
        console.warn('Groq fetch error - using local knowledge base fallback:', err);
        const fallbackReply = getKnowledgeFallback(message);
        const botTime = getTimeString();
        conversationHistory.push({ role: 'assistant', content: fallbackReply });
        appendMessageUI('bot', fallbackReply, botTime);
        currentList.push({ role: 'bot', content: fallbackReply, time: botTime });
        saveForeverHistory(currentList);
      }
    });
  }

  setupChatbot();
  document.addEventListener('astro:after-swap', setupChatbot);
  document.addEventListener('astro:page-load', setupChatbot);
</script>
