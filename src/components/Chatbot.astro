</style>

<script>
  (function() {
    // ==========================================
    // 🗄️ IndexedDB Storage Manager for Chat History
    // ==========================================
    const DB_NAME = 'SK_Portfolio_ChatDB';
    const DB_VERSION = 1;
    const STORE_NAME = 'chat_messages';

    function getFormattedTime() {
      const now = new Date();
      return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function openChatDB() {
      return new Promise((resolve) => {
        if (!window.indexedDB) return resolve(null);
        const req = window.indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_NAME)) {
            db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
          }
        };
        req.onsuccess = (e) => resolve(e.target.result);
        req.onerror = () => resolve(null);
      });
    }

    async function saveMessageToDB(role, content, html, timeStr) {
      try {
        const db = await openChatDB();
        if (!db) return;
        const tx = db.transaction(STORE_NAME, 'readwrite');
        const store = tx.objectStore(STORE_NAME);
        store.add({
          role,
          content,
          html,
          time: timeStr || getFormattedTime(),
          timestamp: Date.now()
        });
      } catch (err) {
        console.warn('IndexedDB save failed:', err);
      }
    }

    async function loadMessagesFromDB() {
      try {
        const db = await openChatDB();
        if (!db) return [];
        return new Promise((resolve) => {
          const tx = db.transaction(STORE_NAME, 'readonly');
          const store = tx.objectStore(STORE_NAME);
          const req = store.getAll();
          req.onsuccess = () => resolve(req.result || []);
          req.onerror = () => resolve([]);
        });
      } catch (err) {
        return [];
      }
    }

    async function clearMessagesFromDB() {
      try {
        const db = await openChatDB();
        if (!db) return;
        const tx = db.transaction(STORE_NAME, 'readwrite');
        const store = tx.objectStore(STORE_NAME);
        store.clear();
      } catch (err) {
        console.warn('IndexedDB clear failed:', err);
      }
    }

    // ==========================================
    // 🤖 Native Chat Messenger Controller
    // ==========================================
    function initLinkMateChatbot() {
      const root = document.getElementById('sk-ai-chatbot');
      if (!root) return;

      const trigger = document.getElementById('chatbot-trigger');
      const panel = document.getElementById('chatbot-panel');
      const closeBtn = document.getElementById('chat-close-btn');
      const backBtn = document.getElementById('chat-back-btn');
      const resizeBtn = document.getElementById('chat-resize-btn');
      const iconExpand = document.getElementById('icon-expand');
      const iconShrink = document.getElementById('icon-shrink');
      const optionsBtn = document.getElementById('chat-options-btn');
      const optionsMenu = document.getElementById('chat-options-menu');
      const clearBtn = document.getElementById('opt-clear-chat');
      const exportBtn = document.getElementById('opt-export-transcript');
      const messagesBox = document.getElementById('chat-messages-container');
      const textarea = document.getElementById('chat-textarea');
      const sendBtn = document.getElementById('chat-send-btn');
      const quickChips = document.getElementById('quick-chips');
      const initBotTime = document.getElementById('init-bot-time');

      if (initBotTime) {
        initBotTime.textContent = getFormattedTime();
      }

      // Toolbar Buttons
      const micBtn = document.getElementById('tool-mic-btn');

      // Extract system knowledge
      let systemPrompt = '';
      let knowledgeBase = null;

      try {
        systemPrompt = JSON.parse(root.getAttribute('data-system-prompt') || '""');
        knowledgeBase = JSON.parse(root.getAttribute('data-knowledge') || '{}');
      } catch (e) {
        console.error('Failed to parse chatbot knowledge:', e);
      }

      // Restore saved user width/height preference
      const savedWidth = localStorage.getItem('sk_chat_w');
      const savedHeight = localStorage.getItem('sk_chat_h');
      if (savedWidth && savedHeight && window.innerWidth > 600) {
        panel.style.width = savedWidth + 'px';
        panel.style.height = savedHeight + 'px';
      }

      // Live System OS Theme Sync
      function syncSystemTheme() {
        const docTheme = document.documentElement.getAttribute('data-theme');
        if (docTheme === 'dark') {
          root.classList.add('theme-dark');
          root.classList.remove('theme-light');
        } else if (docTheme === 'light') {
          root.classList.add('theme-light');
          root.classList.remove('theme-dark');
        } else {
          const isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (isDark) {
            root.classList.add('theme-dark');
            root.classList.remove('theme-light');
          } else {
            root.classList.add('theme-light');
            root.classList.remove('theme-dark');
          }
        }
      }

      syncSystemTheme();
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncSystemTheme);
      }

      // Initialize Conversation Context
      let messages = [
        { role: 'system', content: systemPrompt }
      ];

      // Double Checkmark SVG for User Message
      const doubleTickSvg = `
        <span class="sk-ticks-icon" title="Delivered">
          <svg width="13" height="10" viewBox="0 0 16 11" fill="none">
            <path d="M11 1.5L4.5 8L1.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.5 1.5L8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      `;

      // Restore Conversation from IndexedDB
      loadMessagesFromDB().then((saved) => {
        if (saved && saved.length > 0) {
          messagesBox.innerHTML = '';
          saved.forEach((msg) => {
            messages.push({ role: msg.role, content: msg.content });
            if (msg.role === 'user') {
              const row = document.createElement('div');
              row.className = 'sk-msg-row user';
              row.innerHTML = `
                <div class="sk-bubble user">
                  <div class="sk-bubble-content">${escapeHtml(msg.content)}</div>
                </div>
              `;
              messagesBox.appendChild(row);
            } else if (msg.role === 'assistant') {
              const row = document.createElement('div');
              row.className = 'sk-msg-row bot';
              row.innerHTML = `
                <div class="sk-bubble bot">
                  <div class="sk-bubble-content">${msg.html || formatMarkdown(msg.content)}</div>
                </div>
                <div class="sk-msg-sublabel">SK Agent &bull; ${msg.time || getFormattedTime()}</div>
              `;
              messagesBox.appendChild(row);
            }
          });
          scrollToBottom();
        }
      });

      // Resize / Expand Toggle
      if (resizeBtn) {
        resizeBtn.addEventListener('click', () => {
          const isExpanded = panel.classList.toggle('is-expanded');
          if (isExpanded) {
            iconExpand.style.display = 'none';
            iconShrink.style.display = 'block';
          } else {
            iconExpand.style.display = 'block';
            iconShrink.style.display = 'none';
          }
          scrollToBottom();
        });
      }

      // Multi-Directional Resize Handles
      function setupResizeDrag(handleEl, resizeX, resizeY) {
        if (!handleEl) return;
        let isResizing = false;
        let startX, startY, startWidth, startHeight;

        handleEl.addEventListener('mousedown', (e) => {
          isResizing = true;
          panel.classList.remove('is-expanded');
          startX = e.clientX;
          startY = e.clientY;
          startWidth = parseInt(document.defaultView.getComputedStyle(panel).width, 10);
          startHeight = parseInt(document.defaultView.getComputedStyle(panel).height, 10);
          document.documentElement.addEventListener('mousemove', doDrag, false);
          document.documentElement.addEventListener('mouseup', stopDrag, false);
          e.preventDefault();
        });

        function doDrag(e) {
          if (!isResizing) return;
          if (resizeX) {
            const newWidth = startWidth + (e.clientX - startX);
            if (newWidth > 310 && newWidth < (window.innerWidth - 30)) {
              panel.style.width = newWidth + 'px';
              localStorage.setItem('sk_chat_w', newWidth);
            }
          }
          if (resizeY) {
            const newHeight = startHeight - (e.clientY - startY);
            if (newHeight > 380 && newHeight < (window.innerHeight - 70)) {
              panel.style.height = newHeight + 'px';
              localStorage.setItem('sk_chat_h', newHeight);
            }
          }
        }

        function stopDrag() {
          isResizing = false;
          document.documentElement.removeEventListener('mousemove', doDrag, false);
          document.documentElement.removeEventListener('mouseup', stopDrag, false);
        }
      }

      setupResizeDrag(document.getElementById('resize-handle-corner'), true, true);
      setupResizeDrag(document.getElementById('resize-handle-top'), false, true);
      setupResizeDrag(document.getElementById('resize-handle-right'), true, false);

      // Toggle Chatbot Window
      function toggleChat(forceOpen) {
        const isOpen = root.classList.contains('is-open');
        const nextState = typeof forceOpen === 'boolean' ? forceOpen : !isOpen;

        if (nextState) {
          root.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          panel.setAttribute('aria-hidden', 'false');
          setTimeout(() => textarea.focus(), 150);
        } else {
          root.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          panel.setAttribute('aria-hidden', 'true');
          if (optionsMenu) optionsMenu.classList.remove('show');
        }
      }

      trigger.addEventListener('click', () => toggleChat());
      closeBtn.addEventListener('click', () => toggleChat(false));
      backBtn.addEventListener('click', () => toggleChat(false));

      // Options Dropdown
      if (optionsBtn && optionsMenu) {
        optionsBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          optionsMenu.classList.toggle('show');
        });

        document.addEventListener('click', () => {
          optionsMenu.classList.remove('show');
        });
      }

      // Clear Chat
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          messages = [{ role: 'system', content: systemPrompt }];
          clearMessagesFromDB();
          const t = getFormattedTime();
          messagesBox.innerHTML = `
            <div class="sk-msg-row bot">
              <div class="sk-bubble bot">
                <div class="sk-bubble-content">
                  Chat cleared! How can I help you today with Sunil's experience, projects, or technical questions?
                </div>
              </div>
              <div class="sk-msg-sublabel">SK Agent &bull; ${t}</div>
            </div>
          `;
          if (optionsMenu) optionsMenu.classList.remove('show');
        });
      }

      // Export Transcript
      if (exportBtn) {
        exportBtn.addEventListener('click', async () => {
          try {
            const savedMsgs = await loadMessagesFromDB();
            let transcriptText = `# 💬 SK Agent — Conversation Transcript\n`;
            transcriptText += `Date: ${new Date().toLocaleString()}\n`;
            transcriptText += `Assistant: SK Agent (Sunil Khobragade's AI Assistant)\n`;
            transcriptText += `Portfolio: https://sk-builds.vercel.app\n`;
            transcriptText += `==================================================\n\n`;

            if (savedMsgs && savedMsgs.length > 0) {
              savedMsgs.forEach((msg) => {
                const sender = msg.role === 'user' ? '👤 User' : '🤖 SK Agent';
                const time = msg.time ? ` [${msg.time}]` : '';
                transcriptText += `${sender}${time}:\n${msg.content}\n\n`;
              });
            } else {
              const rows = messagesBox.querySelectorAll('.sk-msg-row');
              rows.forEach((row) => {
                const isUser = row.classList.contains('user');
                const sender = isUser ? '👤 User' : '🤖 SK Agent';
                const content = row.querySelector('.sk-bubble-content')?.innerText?.trim() || '';
                if (content) {
                  transcriptText += `${sender}:\n${content}\n\n`;
                }
              });
            }

            transcriptText += `==================================================\n`;
            transcriptText += `Connect with Sunil Khobragade:\n`;
            transcriptText += `• Email: sunilkhobragade@proton.me\n`;
            transcriptText += `• Phone: +91 74989 50562\n`;
            transcriptText += `• Book Consultation: https://sk-builds.vercel.app/tools/appointment\n`;
            transcriptText += `• GitHub: https://github.com/naman-mahi\n`;

            const blob = new Blob([transcriptText], { type: 'text/markdown;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            const dateStr = new Date().toISOString().slice(0, 10);
            a.href = url;
            a.download = `sk_agent_transcript_${dateStr}.md`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          } catch (err) {
            console.error('Failed to export transcript:', err);
          }
          if (optionsMenu) optionsMenu.classList.remove('show');
        });
      }

      // Input change handler
      textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 90) + 'px';

        if (textarea.value.trim().length > 0) {
          sendBtn.classList.add('active');
          sendBtn.removeAttribute('disabled');
        } else {
          sendBtn.classList.remove('active');
          sendBtn.setAttribute('disabled', 'true');
        }
      });

      // Submit on Enter
      textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          handleSendMessage();
        }
      });

      sendBtn.addEventListener('click', handleSendMessage);

      // Quick Suggestion Chips
      if (quickChips) {
        quickChips.addEventListener('click', (e) => {
          const chip = e.target.closest('.sk-chip-btn');
          if (!chip) return;
          const query = chip.getAttribute('data-query');
          if (query) {
            textarea.value = query;
            sendBtn.classList.add('active');
            sendBtn.removeAttribute('disabled');
            handleSendMessage();
          }
        });
      }

      // Voice Input (Web Speech API) with Live Real-Time Transcription
      if (micBtn) {
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
          const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
          const recognition = new SpeechRec();
          recognition.continuous = true;
          recognition.interimResults = true;
          recognition.lang = 'en-US';
          let isRecording = false;
          let finalTranscript = '';

          recognition.onstart = () => {
            isRecording = true;
            micBtn.classList.add('recording');
            textarea.setAttribute('placeholder', 'Listening... speak now');
            finalTranscript = textarea.value;
          };

          recognition.onresult = (event) => {
            let interimTranscript = '';
            for (let i = event.resultIndex; i < event.results.length; ++i) {
              if (event.results[i].isFinal) {
                finalTranscript += (finalTranscript ? ' ' : '') + event.results[i][0].transcript.trim();
              } else {
                interimTranscript += event.results[i][0].transcript;
              }
            }
            // Update textarea live as the user speaks!
            const currentText = (finalTranscript + (interimTranscript ? ' ' + interimTranscript : '')).trim();
            textarea.value = currentText;
            textarea.style.height = 'auto';
            textarea.style.height = Math.min(textarea.scrollHeight, 90) + 'px';

            if (currentText.length > 0) {
              sendBtn.classList.add('active');
              sendBtn.removeAttribute('disabled');
            }
          };

          recognition.onerror = (e) => {
            console.warn('Speech recognition error:', e);
            isRecording = false;
            micBtn.classList.remove('recording');
            textarea.setAttribute('placeholder', 'Message...');
          };

          recognition.onend = () => {
            isRecording = false;
            micBtn.classList.remove('recording');
            textarea.setAttribute('placeholder', 'Message...');
            if (textarea.value.trim().length > 0) {
              sendBtn.classList.add('active');
              sendBtn.removeAttribute('disabled');
            }
          };

          micBtn.addEventListener('click', () => {
            if (isRecording) {
              recognition.stop();
            } else {
              try {
                recognition.start();
              } catch (err) {
                console.warn('Speech recognition start failed:', err);
              }
            }
          });
        } else {
          micBtn.addEventListener('click', () => {
            alert('Voice input is not supported in this browser. Please try Chrome, Edge, or Safari.');
          });
        }
      }

      // Message UI Elements
      function appendUserMessage(text) {
        const row = document.createElement('div');
        row.className = 'sk-msg-row user';
        row.innerHTML = `
          <div class="sk-bubble user">
            <div class="sk-bubble-content">${escapeHtml(text)}</div>
          </div>
        `;
        messagesBox.appendChild(row);
        scrollToBottom();
      }

      function createStreamingBotMessage() {
        const timeStr = getFormattedTime();
        const row = document.createElement('div');
        row.className = 'sk-msg-row bot';
        
        const bubble = document.createElement('div');
        bubble.className = 'sk-bubble bot';
        
        const contentDiv = document.createElement('div');
        contentDiv.className = 'sk-bubble-content';
        contentDiv.innerHTML = '';
        
        const subLabel = document.createElement('div');
        subLabel.className = 'sk-msg-sublabel';
        subLabel.innerHTML = `SK Agent &bull; ${timeStr}`;

        bubble.appendChild(contentDiv);
        row.appendChild(bubble);
        row.appendChild(subLabel);
        messagesBox.appendChild(row);

        scrollToBottom();
        return { contentDiv, timeStr };
      }

      function appendBotMessage(html, rawContent) {
        const timeStr = getFormattedTime();
        const row = document.createElement('div');
        row.className = 'sk-msg-row bot';
        row.innerHTML = `
          <div class="sk-bubble bot">
            <div class="sk-bubble-content">${html}</div>
          </div>
          <div class="sk-msg-sublabel">SK Agent &bull; ${timeStr}</div>
        `;
        messagesBox.appendChild(row);
        scrollToBottom();
        saveMessageToDB('assistant', rawContent || html, html, timeStr);
      }

      function showTypingIndicator() {
        const row = document.createElement('div');
        row.className = 'sk-msg-row bot';
        row.id = 'sk-typing';
        row.innerHTML = `
          <div class="sk-bubble bot sk-typing-indicator">
            <span class="sk-typing-dot"></span>
            <span class="sk-typing-dot"></span>
            <span class="sk-typing-dot"></span>
          </div>
        `;
        messagesBox.appendChild(row);
        scrollToBottom();
      }

      function removeTypingIndicator() {
        const typing = document.getElementById('sk-typing');
        if (typing) typing.remove();
      }

      function scrollToBottom() {
        messagesBox.scrollTop = messagesBox.scrollHeight;
      }

      // Robust Clean Markdown Formatter
      function formatMarkdown(text) {
        if (!text) return '';

        // 1. Sanitize already generated HTML <a> tags
        let clean = text.replace(/<a\s+(?:[^>]*?\s+)?href="([^"]*)"[^>]*>(.*?)<\/a>/gi, '[$2]($1)');

        // 2. Escape dangerous scripts
        clean = clean
          .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
          .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '');

        // 3. Headers
        clean = clean.replace(/^#{1,6}\s*(.+)$/gm, '<strong>$1</strong>');

        // 4. Code Blocks
        clean = clean.replace(/```([a-zA-Z]*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>');
        clean = clean.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');

        // 5. Inline Code
        clean = clean.replace(/`([^`]+)`/g, '<code>$1</code>');

        // 6. Markdown Tables
        clean = clean.replace(/((?:^|\n)\|[^\n]+\|(?:\r?\n\|[^\n]+\|)+)/g, (match) => {
          const lines = match.trim().split(/\r?\n/).map(l => l.trim()).filter(Boolean);
          if (lines.length < 2) return match;

          const isSeparator = (line) => /^\|(?:\s*:?-+:?\s*\|)+$/.test(line);
          let html = '<div class="sk-table-wrap"><table class="sk-table">';
          let startIndex = 0;

          if (isSeparator(lines[1])) {
            const headers = lines[0].split('|').slice(1, -1).map(h => h.trim());
            html += '<thead><tr>';
            headers.forEach(h => {
              html += `<th>${h}</th>`;
            });
            html += '</tr></thead>';
            startIndex = 2;
          }

          html += '<tbody>';
          for (let i = startIndex; i < lines.length; i++) {
            if (isSeparator(lines[i])) continue;
            const cells = lines[i].split('|').slice(1, -1).map(c => c.trim());
            if (cells.length > 0) {
              html += '<tr>';
              cells.forEach(c => {
                html += `<td>${c}</td>`;
              });
              html += '</tr>';
            }
          }
          html += '</tbody></table></div>';
          return '\n' + html + '\n';
        });

        // 7. Bold & Italic
        clean = clean.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        clean = clean.replace(/\*(.*?)\*/g, '<em>$1</em>');

        // 8. Markdown Links: [Text](URL)
        clean = clean.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');

        // 9. Bullet points
        clean = clean.replace(/^[-*]\s+(.+)$/gm, '• $1');

        // 10. Line breaks (preserve html tags cleanly)
        clean = clean.replace(/\n\n/g, '<br><br>').replace(/\n/g, '<br>');

        return clean;
      }

      function escapeHtml(unsafe) {
        return unsafe
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // Live LLM Request with Brevity Instruction
      async function handleSendMessage() {
        const text = textarea.value.trim();
        if (!text) return;

        const userTime = getFormattedTime();
        appendUserMessage(text);
        saveMessageToDB('user', text, "", userTime);

        textarea.value = '';
        textarea.style.height = 'auto';
        sendBtn.classList.remove('active');
        sendBtn.setAttribute('disabled', 'true');

        messages.push({ role: 'user', content: text });
        showTypingIndicator();

        // Secure Server-side AI Proxy (Zero client API keys)
        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages })
          });

          if (res.ok && res.body) {
            removeTypingIndicator();
            const { contentDiv, timeStr } = createStreamingBotMessage();
            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let fullResponse = '';
            let buffer = '';

            while (true) {
              const { done, value } = await reader.read();
              if (done) break;

              buffer += decoder.decode(value, { stream: true });
              const lines = buffer.split('\n');
              buffer = lines.pop() || '';

              for (const line of lines) {
                const trimmed = line.trim();
                if (!trimmed || trimmed === 'data: [DONE]') continue;
                if (trimmed.startsWith('data: ')) {
                  try {
                    const json = JSON.parse(trimmed.slice(6));
                    const token = json.choices?.[0]?.delta?.content || '';
                    if (token) {
                      fullResponse += token;
                      contentDiv.innerHTML = formatMarkdown(fullResponse);
                      scrollToBottom();
                    }
                  } catch (e) {}
                }
              }
            }

            if (fullResponse.trim().length > 0) {
              messages.push({ role: 'assistant', content: fullResponse });
              saveMessageToDB('assistant', fullResponse, formatMarkdown(fullResponse), timeStr);
              return;
            }
          }
        } catch (err) {
          console.warn('Backend chat service unreachable, using smart offline knowledge engine:', err);
        }

        // Offline Smart Knowledge Base Fallback
        setTimeout(() => {
          removeTypingIndicator();
          generateSmartResponse(text);
        }, 350);
      }

      // Short & Meaningful Offline Knowledge Engine
      function generateSmartResponse(query) {
        const q = query.toLowerCase();
        let reply = "";

        if (q.includes('skill') || q.includes('stack') || q.includes('technolog') || q.includes('ai agent') || q.includes('rag')) {
          reply = `• <strong>AI &amp; GenAI:</strong> AI Agents (LangGraph, CrewAI), RAG pipelines, Vector DBs (pgvector, Pinecone).<br>
• <strong>Full-Stack:</strong> Node.js, Python (FastAPI), React 19, Next.js, Laravel.<br>
• <strong>Cloud &amp; DevOps:</strong> Docker, Kubernetes, AWS, CI/CD automation.<br><br>
See full stack on <a href="/tech-stack">Tech Stack &rarr;</a>`;
        } else if (q.includes('project') || q.includes('portfolio') || q.includes('work done') || q.includes('pulse') || q.includes('lms') || q.includes('booking') || q.includes('e-commerce')) {
          reply = `• <a href="/projects/pulse-chat"><strong>Pulse Chat</strong></a>: AI customer support with real-time WebSockets.<br>
• <a href="/projects/ai-enabled-lms"><strong>AI-Enabled LMS</strong></a>: Educational platform with Vertex AI.<br>
• <a href="/projects/e-commerce-platform"><strong>E-Commerce Platform</strong></a>: Multi-gateway payments (Stripe/Razorpay).<br>
• <a href="/projects/real-time-appointment-booking"><strong>Appointment Booking</strong></a>: Concurrency-safe Redis locking.<br><br>
Explore all on <a href="/projects">Projects &rarr;</a>`;
        } else if (q.includes('experience') || q.includes('career') || q.includes('intencode') || q.includes('job') || q.includes('company')) {
          reply = `• <strong>Intencode India</strong> (2022–Present): Full-Stack Dev leading microservices and CI/CD.<br>
• <strong>Freelance Solutions Architect</strong> (2020–2022): Built 15+ enterprise web platforms.<br>
• <strong>IBM India Intern</strong> (2021–2022): Enhanced internal tools with Node &amp; Angular.<br><br>
Full career details on <a href="/work">Work Experience &rarr;</a>`;
        } else if (q.includes('contact') || q.includes('hire') || q.includes('email') || q.includes('phone') || q.includes('book') || q.includes('call') || q.includes('rate') || q.includes('cost')) {
          reply = `• <strong>Email:</strong> <a href="mailto:sunilkhobragade@proton.me">sunilkhobragade@proton.me</a><br>
• <strong>Phone:</strong> <a href="tel:+917498950562">+91 74989 50562</a><br>
• <strong>1:1 Consultation:</strong> <a href="/tools/appointment">Book on Google Calendar &rarr;</a><br>
• <strong>Project Estimator:</strong> <a href="/tools/estimator">Estimate Project Cost &rarr;</a>`;
        } else if (q.includes('education') || q.includes('degree') || q.includes('certif') || q.includes('college')) {
          reply = `• <strong>M.Sc. Information Security</strong> (2025–Present) | IGNOU<br>
• <strong>PG Diploma Information Security</strong> (2024–2025) | IGNOU<br>
• <strong>Adv. Diploma IT &amp; Cloud</strong> (2019–2022) | NSTI Hyderabad (IBM)<br>
• <strong>B.Com</strong> (2019–2022) | YCMOU`;
        } else {
          reply = `I am specifically designed to answer questions about <strong>Sunil Khobragade</strong> and his portfolio.<br><br>
Feel free to ask about Sunil's <a href="/projects">Projects</a>, <a href="/tech-stack">Tech Stack</a>, <a href="/work">Work Experience</a>, or <a href="/tools/appointment">Hiring / 1:1 Consultation</a>!`;
        }

        messages.push({ role: 'assistant', content: reply });
        appendBotMessage(reply, reply);
      }
    }

    // Initialize on Idle to preserve 100/100 Core Web Vitals & sub-1.2s LCP
    const runOnIdle = () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initLinkMateChatbot, { timeout: 2000 });
      } else {
        setTimeout(initLinkMateChatbot, 1000);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runOnIdle);
    } else {
      runOnIdle();
    }
    document.addEventListener('astro:after-swap', runOnIdle);
  })();
</script>
