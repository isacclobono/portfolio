---
import { CHATBOT_SYSTEM_PROMPT } from '../data/chatbotKnowledge';

const defaultSystemPrompt = JSON.stringify(CHATBOT_SYSTEM_PROMPT);
const envGroqKey = import.meta.env.PUBLIC_GROQ_API_KEY || '';
---

<!-- Floating AI Chatbot Container (Left-Side) -->
<div id="sk-ai-chatbot" class="sk-chatbot-root" data-system-prompt={defaultSystemPrompt} data-env-key={envGroqKey}>
  
  <!-- Proactive Floating Greeting Callout Bubble -->
  <div id="chatbot-greeting-bubble" class="sk-greeting-callout" style="display: none;">
    <div class="sk-greeting-content" id="greeting-text-wrap">
      <div class="sk-greeting-avatar-mini">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8V4H8"></path>
          <rect width="16" height="12" x="4" y="8" rx="2"></rect>
          <path d="M2 14h2"></path>
          <path d="M20 14h2"></path>
          <path d="M15 13v2"></path>
          <path d="M9 13v2"></path>
        </svg>
      </div>
      <div class="sk-greeting-body">
        <div class="sk-greeting-title">AI assistant</div>
        <p class="sk-greeting-text" id="greeting-dynamic-message">
          Good day! Ready to explore Sunil's work? Ask me anything about his projects, experience, or skills.
        </p>
      </div>
    </div>
    <button type="button" id="greeting-close-btn" class="sk-greeting-close-btn" aria-label="Dismiss greeting">
      &times;
    </button>
  </div>

  <!-- Floating Launcher Button -->
  <button 
    type="button" 
    id="chatbot-trigger" 
    class="sk-launcher-btn"
    aria-label="Open AI Assistant"
    title="Chat with Sunil's AI Assistant"
  >
    <div class="sk-launcher-icon-wrap">
      <!-- AI Bot Icon (Visible when closed) -->
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sk-icon-bot">
        <path d="M12 8V4H8"></path>
        <rect width="16" height="12" x="4" y="8" rx="2"></rect>
        <path d="M2 14h2"></path>
        <path d="M20 14h2"></path>
        <path d="M15 13v2"></path>
        <path d="M9 13v2"></path>
      </svg>
      <!-- Close Icon (Visible when open) -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sk-icon-close">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>
    <span class="sk-launcher-status-dot"></span>
  </button>

  <!-- Main AI Assistant Window Modal -->
  <div id="chatbot-panel" class="sk-chat-window" aria-hidden="true">
    
    <!-- Top Header -->
    <div class="sk-chat-header">
      <div class="sk-header-left">
        <h3 class="sk-chat-title">AI assistant</h3>
      </div>

      <div class="sk-header-right">
        <!-- Size Switcher Button (Expand / Normal) -->
        <button type="button" id="chat-size-toggle-btn" class="sk-header-btn" title="Toggle Size (Normal / Expanded)" aria-label="Toggle Size">
          <svg id="size-icon-expand" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <svg id="size-icon-shrink" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <polyline points="4 14 10 14 10 20"></polyline>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="14" y1="10" x2="21" y2="3"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>

        <!-- Today Pill Badge -->
        <div class="sk-date-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Today</span>
        </div>

        <!-- Three Dots Options Menu -->
        <div class="sk-menu-wrap">
          <button type="button" id="chat-menu-btn" class="sk-header-btn" title="Options" aria-label="Options Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <circle cx="12" cy="12" r="2"></circle>
              <circle cx="19" cy="12" r="2"></circle>
              <circle cx="5" cy="12" r="2"></circle>
            </svg>
          </button>
          <div id="chat-menu-dropdown" class="sk-menu-dropdown" style="display: none;">
            <button type="button" id="chat-clear-btn" class="sk-dropdown-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"></path>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              </svg>
              Clear Conversation
            </button>
            <button type="button" id="chat-close-modal-btn" class="sk-dropdown-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
              Close Assistant
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Chat Messages Stream Container -->
    <div id="chat-messages-container" class="sk-messages-box">
      
      <!-- Welcome Card (Shown if history is empty) -->
      <div id="sk-hero-welcome-card" class="sk-hero-card">
        <div class="sk-hero-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M15 13v2"></path>
            <path d="M9 13v2"></path>
          </svg>
        </div>
        <p class="sk-hero-text">
          Good day, are you ready to explore?<br/>
          Ask me anything about Sunil's experience, skills &amp; projects.
        </p>
        <div class="sk-hero-meta">
          <span class="sk-hero-time">Just now</span>
          <span class="sk-check-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </div>
      </div>

    </div>

    <!-- Rate Limit / Spam Notification Bar (Auto-dismisses) -->
    <div id="rate-limit-banner" class="sk-rate-banner" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="rate-limit-text">Please wait 3s before sending again.</span>
    </div>

    <!-- Input Card Box (Themed) -->
    <div class="sk-input-wrapper">
      <form id="chat-input-form" class="sk-input-card">
        
        <!-- Text Input Row -->
        <div class="sk-input-top-row">
          <span class="sk-caret-indicator"></span>
          <input 
            type="text" 
            id="chat-user-input" 
            class="sk-real-input" 
            placeholder="Write your answer..." 
            maxlength="350"
            required
            autocomplete="off"
          />
        </div>

        <!-- Actions Bottom Row -->
        <div class="sk-input-actions-row">
          <div class="sk-actions-left">
            <!-- Voice Mic Tool Button -->
            <button type="button" class="sk-tool-btn" title="Voice Input" id="mic-tool-btn" aria-label="Voice Input">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="22"></line>
              </svg>
            </button>

            <!-- Emoji Tool Button -->
            <button type="button" class="sk-tool-btn" title="Insert Emoji" id="emoji-tool-btn" aria-label="Insert Emoji">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
              </svg>
            </button>
          </div>

          <div class="sk-actions-right">
            <!-- Round Send Button with Arrow -->
            <button type="submit" id="chat-send-btn" class="sk-send-btn" aria-label="Send Message">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="19" x2="12" y2="5"></line>
                <polyline points="5 12 12 5 19 12"></polyline>
              </svg>
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</div>

<style is:global>
  /* -------------------------------------------------------------------------
     Theme-Integrated Styles (Uses CSS Tokens from global.css)
     ------------------------------------------------------------------------- */

  /* Root Wrapper on Bottom-Left */
  #sk-ai-chatbot.sk-chatbot-root {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    right: auto;
    z-index: 99999;
    font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Inter', sans-serif);
  }

  /* Proactive Greeting Callout */
  #sk-ai-chatbot .sk-greeting-callout {
    position: absolute;
    bottom: 68px;
    left: 0;
    right: auto;
    width: 290px;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg, 16px);
    padding: 0.85rem 1rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
    cursor: pointer;
    animation: skGreetingPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    z-index: 90;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  #sk-ai-chatbot .sk-greeting-callout:hover {
    transform: translateY(-2px);
    border-color: var(--border-card-hover);
  }

  @keyframes skGreetingPop {
    from { opacity: 0; transform: translateY(12px) scale(0.92); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  #sk-ai-chatbot .sk-greeting-content {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    flex: 1;
  }

  #sk-ai-chatbot .sk-greeting-avatar-mini {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  #sk-ai-chatbot .sk-greeting-title {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  #sk-ai-chatbot .sk-greeting-text {
    font-size: 0.775rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  #sk-ai-chatbot .sk-greeting-close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 2px;
    transition: color 0.15s ease;
  }

  #sk-ai-chatbot .sk-greeting-close-btn:hover {
    color: var(--text-primary);
  }

  /* -------------------------------------------------------------------------
     Floating Launcher Button (Matches Theme)
     ------------------------------------------------------------------------- */
  #sk-ai-chatbot .sk-launcher-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1.5px solid var(--border-card);
    color: var(--text-primary);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #sk-ai-chatbot .sk-launcher-btn:hover {
    transform: scale(1.1) translateY(-2px);
    border-color: var(--border-card-hover);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
  }

  #sk-ai-chatbot .sk-launcher-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 24px;
    height: 24px;
  }

  #sk-ai-chatbot .sk-icon-bot,
  #sk-ai-chatbot .sk-icon-close {
    color: var(--text-primary);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #sk-ai-chatbot .sk-icon-bot {
    display: block;
    opacity: 1;
  }

  #sk-ai-chatbot .sk-icon-close {
    display: none;
    opacity: 0;
  }

  #sk-ai-chatbot.open .sk-icon-bot {
    display: none;
    opacity: 0;
  }

  #sk-ai-chatbot.open .sk-icon-close {
    display: block;
    opacity: 1;
  }

  #sk-ai-chatbot .sk-launcher-status-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--accent-green, #22c55e);
    border: 2px solid var(--bg-card);
  }

  /* -------------------------------------------------------------------------
     Main Chat Window (Theme-Integrated & Fully Resizable)
     ------------------------------------------------------------------------- */
  #sk-ai-chatbot .sk-chat-window {
    display: none;
    position: absolute;
    bottom: 68px;
    left: 0;
    right: auto;
    width: 380px;
    height: 540px;
    min-width: 320px;
    max-width: min(720px, calc(100vw - 2rem));
    min-height: 420px;
    max-height: min(850px, calc(100vh - 100px));
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg, 20px);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    flex-direction: column;
    overflow: hidden;
    animation: skModalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1), height 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes skModalIn {
    from { opacity: 0; transform: translateY(14px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  #sk-ai-chatbot.open .sk-chat-window {
    display: flex;
  }

  /* -------------------------------------------------------------------------
     Header
     ------------------------------------------------------------------------- */
  #sk-ai-chatbot .sk-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.15rem 0.85rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  #sk-ai-chatbot .sk-chat-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.3px;
  }

  #sk-ai-chatbot .sk-header-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  #sk-ai-chatbot .sk-header-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  #sk-ai-chatbot .sk-header-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-card-hover);
    background: var(--bg-card-hover);
  }

  #sk-ai-chatbot .sk-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 9999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.725rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  #sk-ai-chatbot .sk-date-badge svg {
    color: var(--text-primary);
  }

  #sk-ai-chatbot .sk-menu-wrap {
    position: relative;
  }

  #sk-ai-chatbot .sk-menu-dropdown {
    position: absolute;
    top: 34px;
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md, 10px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    padding: 0.35rem;
    z-index: 50;
    min-width: 165px;
    animation: skMenuFade 0.15s ease-out;
  }

  @keyframes skMenuFade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #sk-ai-chatbot .sk-dropdown-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm, 6px);
    color: var(--text-secondary);
    font-size: 0.775rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  #sk-ai-chatbot .sk-dropdown-item:hover {
    color: var(--text-primary);
    background: var(--bg-pill);
  }

  /* -------------------------------------------------------------------------
     Messages Stream Box
     ------------------------------------------------------------------------- */
  #sk-ai-chatbot .sk-messages-box {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    scroll-behavior: smooth;
    background: var(--bg-primary);
  }

  /* Welcome Card */
  #sk-ai-chatbot .sk-hero-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.2rem 0.5rem 0.5rem;
  }

  #sk-ai-chatbot .sk-hero-avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  #sk-ai-chatbot .sk-hero-text {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-primary);
    margin: 0 0 0.65rem;
    font-weight: 500;
    max-width: 280px;
  }

  #sk-ai-chatbot .sk-hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--bg-pill);
    border-radius: 9999px;
    padding: 2px 8px;
  }

  #sk-ai-chatbot .sk-hero-time {
    font-size: 0.675rem;
    color: var(--text-muted);
  }

  #sk-ai-chatbot .sk-check-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--text-primary);
    color: var(--bg-primary);
    border-radius: 50%;
    width: 13px;
    height: 13px;
  }

  /* -------------------------------------------------------------------------
     Dynamic Message Rows (AI Left, User Right Stacked)
     ------------------------------------------------------------------------- */
  #sk-ai-chatbot .sk-msg-row {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    width: 100%;
  }

  #sk-ai-chatbot .sk-row-bot {
    justify-content: flex-start;
  }

  #sk-ai-chatbot .sk-row-user {
    justify-content: flex-end;
  }

  #sk-ai-chatbot .sk-bot-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  #sk-ai-chatbot .sk-bubble-bot {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    padding: 0.75rem 0.95rem;
    max-width: 84%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  #sk-ai-chatbot .sk-bubble-bot .sk-content {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  #sk-ai-chatbot .sk-bubble-bot .sk-content a {
