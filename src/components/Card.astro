---
interface Props {
  href: string;
  title: string;
  description?: string;
  date?: string;
  tags?: string[];
  metric?: string;
  demoUrl?: string;
  repoUrl?: string;
  target?: string;
  rel?: string;
}

const { 
  href, 
  title, 
  description, 
  date, 
  tags = [], 
  metric, 
  demoUrl, 
  repoUrl,
  target,
  rel
} = Astro.props;

const isExternal = href.startsWith('http://') || href.startsWith('https://');
const linkTarget = target !== undefined ? target : (isExternal ? '_blank' : undefined);
const linkRel = rel !== undefined ? rel : (isExternal ? 'noopener noreferrer' : undefined);
---

<a href={href} class="card-link group" target={linkTarget} rel={linkRel}>
  <div class="card-content">
    <div class="card-header-row">
      <div class="card-title">{title}</div>
      {metric && (
        <span class="card-metric-badge">
          {metric}
        </span>
      )}
    </div>

    {description && <p class="card-description">{description}</p>}

    {tags && tags.length > 0 && (
      <div class="card-tags-list">
        {tags.slice(0, 5).map((tag) => (
          <span class="card-tag-pill">{tag}</span>
        ))}
      </div>
    )}
  </div>

  <div class="card-arrow" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </div>
</a>


