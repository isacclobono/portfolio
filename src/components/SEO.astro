---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  publishDate?: Date;
  modifiedDate?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description = SITE.DESCRIPTION,
  image = SITE.OG_IMAGE || '/og-image.svg',
  noindex = false,
  type = 'website',
  publishDate,
  modifiedDate,
  tags = [],
  author = SITE.AUTHOR,
} = Astro.props;

// Determine clean site URL and canonical URL
const rawBase = Astro.site ? Astro.site.toString() : (Astro.url.origin || SITE.URL);
const siteUrl = rawBase.replace(/\/$/, '');

// Format Page Title cleanly
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const pageTitle = isHomePage
  ? `${SITE.AUTHOR} — ${SITE.ROLE}`
  : (title ? (title.includes(SITE.AUTHOR) ? title : `${title} | ${SITE.AUTHOR}`) : `${SITE.AUTHOR} — ${SITE.ROLE}`);

// Canonical URL (standardize trailing slash according to Astro config)
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Absolute image URL
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

// Keywords array to string
const keywordsList = [...(SITE.KEYWORDS || []), ...(tags || [])];
const keywordsString = Array.from(new Set(keywordsList)).join(', ');

// Construct Dynamic Breadcrumb Hierarchy for Schema.org
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbElements = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${siteUrl}/`
  }
];

let accumulatedPath = '';
pathSegments.forEach((segment, idx) => {
  accumulatedPath += `/${segment}`;
  const isLast = idx === pathSegments.length - 1;
  const name = isLast && title ? title : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": name,
    "item": `${siteUrl}${accumulatedPath}`
  });
});

// Comprehensive Schema.org Graph
const schemaGraph: any[] = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": `${siteUrl}/`,
    "name": SITE.TITLE,
    "description": SITE.DESCRIPTION,
    "publisher": {
      "@id": `${siteUrl}/#person`
    },
    "inLanguage": "en-US"
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    "name": SITE.AUTHOR,
    "jobTitle": SITE.ROLE,
    "url": `${siteUrl}/`,
    "image": imageUrl,
    "email": `mailto:${SITE.EMAIL}`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hyderabad",
      "addressCountry": "India"
    },
    "sameAs": [
      SITE.GITHUB,
      SITE.LINKEDIN,
      SITE.TWITTER
    ].filter(Boolean),
    "knowsAbout": [
      "Full-Stack Web Development",
      "Node.js", "TypeScript", "React", "Next.js", "Angular", "Astro",
      "PHP", "Laravel", "Python", "Django", "FastAPI",
      "Microservices Architecture", "System Design", "Distributed Systems",
      "PostgreSQL", "MySQL", "MongoDB", "Redis", "Elasticsearch",
      "Amazon Web Services (AWS)", "Microsoft Azure", "Docker", "Kubernetes", "CI/CD Automation",
      "AI Integrations", "Google Cloud Vertex AI", "Payment Gateways (Stripe, Razorpay, PhonePe)"
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "RTM Nagpur University"
    }
  },
  {
    "@type": "ProfessionalService",
    "@id": `${siteUrl}/#service`,
    "name": SITE.BRAND,
    "url": `${siteUrl}/`,
    "logo": `${siteUrl}/favicon.svg`,
    "image": imageUrl,
    "description": SITE.DESCRIPTION,
    "telephone": "+91-0000000000",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hyderabad",
      "addressCountry": "India"
    },
    "founder": {
      "@id": `${siteUrl}/#person`
    },
    "areaServed": "Worldwide",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Software Engineering & Solutions Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Full-Stack Web Development",
            "description": "Production-ready, responsive, and high-performance web applications built with modern web technologies."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cloud Architecture & Microservices Consulting",
            "description": "Designing fault-tolerant distributed backends, REST/GraphQL APIs, database scaling, and CI/CD pipelines."
          }
        }
      ]
    }
  }
];

// Add Breadcrumbs schema for all pages
if (breadcrumbElements.length > 1) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": breadcrumbElements
  });
}

// Add Article schema for Blog Posts
if (type === 'article') {
  schemaGraph.push({
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    "isPartOf": {
      "@id": `${siteUrl}/#website`
    },
    "headline": title || pageTitle,
    "description": description,
    "inLanguage": "en-US",
    "mainEntityOfPage": canonicalUrl,
    "datePublished": publishDate ? publishDate.toISOString() : undefined,
    "dateModified": (modifiedDate || publishDate) ? (modifiedDate || publishDate)!.toISOString() : undefined,
    "image": imageUrl,
    "author": {
      "@id": `${siteUrl}/#person`
    },
    "publisher": {
      "@id": `${siteUrl}/#person`
    },
    "keywords": tags.length > 0 ? tags.join(', ') : undefined
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};

const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="keywords" content={keywordsString} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Robots Indexing & Search Engine Optimization -->
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="bingbot" content={robotsContent} />

<!-- Open Graph / Facebook / LinkedIn / Discord / WhatsApp -->
<meta property="og:site_name" content={SITE.BRAND} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content="en_US" />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SITE.AUTHOR} />}
{type === 'article' && <meta property="article:section" content="Software Engineering" />}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.TWITTER_HANDLE} />
<meta name="twitter:creator" content={SITE.TWITTER_HANDLE} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={pageTitle} />

<!-- Web App Manifest & Discovery Feeds -->
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.BRAND} RSS Feed`} href={`${siteUrl}/rss.xml`} />
<link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />

<!-- Mobile & Browser Theme Configuration -->
<meta name="application-name" content={SITE.BRAND} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={SITE.BRAND} />
<meta name="format-detection" content="telephone=no" />

<!-- Structured Data JSON-LD for Search Engines -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
