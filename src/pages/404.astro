---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';

const popularRoutes = [
  {
    title: "Work Experience",
    desc: "6+ years full-stack & AI engineering career timeline",
    href: "/work",
    icon: "briefcase"
  },
  {
    title: "Featured Projects",
    desc: "Production microservices, AI agents, and web apps",
    href: "/projects",
    icon: "rocket"
  },
  {
    title: "Developer Tools Suite",
    desc: "In-browser Project Estimator, JWT, SQL, and Cron utilities",
    href: "/tools",
    icon: "wrench"
  },
  {
    title: "Technical Articles",
    desc: "System design, high-concurrency Redis, and payments",
    href: "/blog",
    icon: "file-text"
  },
  {
    title: "1:1 Consultation",
    desc: "Schedule architecture discovery on Google Calendar",
    href: "/tools/appointment",
    icon: "calendar"
  },
  {
    title: "System Status",
    desc: "Real-time edge uptime and service health logs",
    href: "/status",
    icon: "activity"
  }
];
---

<Layout 
  title="404 — Page Not Found | SK Builds" 
  description="The requested page could not be located. Explore Sunil Khobragade's portfolio, featured projects, articles, and developer tools." 
  currentPath="/404"
  noindex={true}
>
  <div class="error-page-wrapper">
    <!-- Top Header -->
    <header class="error-header-block">
      <div class="error-pill-badge">
        <span class="pulse-dot-red"></span>
        HTTP 404 &bull; ROUTE_NOT_FOUND
      </div>
      <h1 class="error-main-title">Page Not Found</h1>
      <p class="error-description">
        The requested resource or endpoint could not be found. It may have been moved, renamed, or is temporarily unavailable.
      </p>
    </header>

    <!-- Diagnostics Card (Adapts to Light and Dark Theme) -->
    <div class="diagnostic-card" aria-hidden="true">
      <div class="diag-header">
        <div class="diag-dots">
          <span class="dot d-red"></span>
          <span class="dot d-yellow"></span>
          <span class="dot d-green"></span>
        </div>
        <span class="diag-filename">route-diagnostic.log</span>
      </div>
      <div class="diag-body">
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> GET <span class="diag-path" id="client-requested-path">/current-route</span> HTTP/2.0
        </div>
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Host: <span class="diag-host">sunilkhobragade.pages.dev</span>
        </div>
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Status: <span class="diag-error">404 Not Found</span> &bull; <span class="diag-dim">0.42ms TTFB</span>
        </div>
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Resolution: <span class="diag-success">Select a valid canonical route below</span><span class="diag-cursor">_</span>
        </div>
      </div>
    </div>

    <!-- Main Action Buttons -->
    <div class="error-actions-group">
      <Button href="/" variant="primary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Return to Homepage</span>
      </Button>

      <Button href="/tools" variant="secondary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        <span>Open Developer Tools</span>
      </Button>

      <a href="mailto:skhobragade993@gmail.com" class="error-report-link">
        Report broken link &rarr;
      </a>
    </div>

    <!-- Canonical Destinations Section -->
    <section class="hubs-section">
      <div class="hubs-header">
        <h2 class="hubs-title">Canonical Destinations</h2>
        <span class="hubs-badge">6 Available Hubs</span>
      </div>

      <div class="hubs-grid">
        {popularRoutes.map((r) => (
          <a href={r.href} class="hub-card">
            <div class="hub-icon-box">
              {r.icon === 'briefcase' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {r.icon === 'rocket' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                  <path d="M12 9v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                </svg>
              )}
              {r.icon === 'wrench' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              )}
              {r.icon === 'file-text' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/>
                </svg>
              )}
              {r.icon === 'calendar' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                </svg>
              )}
              {r.icon === 'activity' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                </svg>
              )}
            </div>

            <div class="hub-text-content">
              <span class="hub-card-title">{r.title}</span>
              <span class="hub-card-desc">{r.desc}</span>
            </div>

            <svg class="hub-arrow-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  (function() {
    const pathEl = document.getElementById('client-requested-path');
    if (pathEl && typeof window !== 'undefined') {
      pathEl.textContent = window.location.pathname || '/requested-route';
    }
  })();
</script>

<style>
  .error-page-wrapper {
    max-width: 820px;
    margin: 1.5rem auto 5rem auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Header */
  .error-header-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .error-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    width: auto;
  }

  .pulse-dot-red {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.8);
  }

  .error-main-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .error-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 620px;
    line-height: 1.6;
  }

  /* Diagnostic Card (Supports Light and Dark) */
  .diagnostic-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: var(--font-mono, monospace);
  }

  .diag-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-card);
  }

  .diag-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .d-red { background: #ef4444; }
  .d-yellow { background: #eab308; }
  .d-green { background: #10b981; }

  .diag-filename {
    font-size: 0.725rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-left: 4px;
  }

  .diag-body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.825rem;
  }

  .diag-line {
    margin: 0;
    line-height: 1.45;
  }

  .diag-dim { color: var(--text-muted); }
  .diag-path { color: #f43f5e; font-weight: 600; }
  .diag-host { color: #0284c7; }
  .diag-error { color: #ef4444; font-weight: 700; }
  .diag-success { color: #10b981; font-weight: 600; }

  .diag-cursor {
    animation: blinkDiagCursor 1s infinite;
    color: #10b981;
  }

  @keyframes blinkDiagCursor {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Action Buttons with Generous Spacing */
  .error-actions-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 1rem 0;
  }

  .error-report-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .error-report-link:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  /* Canonical Hubs Section */
  .hubs-section {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .hubs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hubs-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .hubs-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.85rem;
  }

  .hub-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    padding: 0.95rem 1.15rem;
    text-decoration: none !important;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .hub-card:hover {
    border-color: #3b82f6;
    background: var(--bg-card-hover, var(--bg-card));
    transform: translateY(-1px);
  }

  .hub-card:hover .hub-arrow-icon {
    transform: translateX(3px);
    color: #3b82f6;
  }

  .hub-card:hover .hub-card-title {
    color: #3b82f6;
  }

  .hub-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    flex-shrink: 0;
  }

  .hub-text-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .hub-card-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease;
    text-decoration: none !important;
  }

  .hub-card-desc {
    font-size: 0.775rem;
    color: var(--text-secondary);
    line-height: 1.35;
    text-decoration: none !important;
  }

  .hub-arrow-icon {
    color: var(--text-muted);
    transition: transform 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }
</style>
