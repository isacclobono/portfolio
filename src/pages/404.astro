---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
---

<Layout 
  title="404 — Page Not Found | SK Builds" 
  description="The page you are looking for does not exist or has been moved. Explore Sunil Khobragade's projects, articles, and developer tools." 
  currentPath="/404"
  noindex={true}
>
  <div class="error-container">
    <div class="error-visual">
      <span class="error-code-badge">404 Error</span>
      <h1 class="error-headline">Lost in the Matrix</h1>
      <p class="error-message">
        The page or resource you are looking for might have been moved, renamed, or temporarily unavailable.
      </p>
    </div>

    <!-- Quick Navigation Suggestions -->
    <div class="error-actions">
      <Button href="/" variant="primary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Return to Home
      </Button>

      <Button href="/projects" variant="secondary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 9v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
        </svg>
        View Projects
      </Button>

      <Button href="/tools" variant="secondary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        Developer Tools
      </Button>
    </div>

    <!-- Popular Hub Cards -->
    <div class="error-suggestions">
      <h2 class="suggestions-title">Popular Destinations</h2>
      <div class="suggestions-grid">
        <a href="/work" class="suggestion-card">
          <span class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
          </span>
          <div class="card-text">
            <strong>Work Experience</strong>
            <span>6+ years full-stack &amp; AI engineering history</span>
          </div>
        </a>

        <a href="/blog" class="suggestion-card">
          <span class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/>
            </svg>
          </span>
          <div class="card-text">
            <strong>Technical Articles</strong>
            <span>System design, microservices, and RAG</span>
          </div>
        </a>

        <a href="/tools/appointment" class="suggestion-card">
          <span class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
            </svg>
          </span>
          <div class="card-text">
            <strong>Book 1:1 Consultation</strong>
            <span>Schedule direct architecture discovery</span>
          </div>
        </a>

        <a href="/status" class="suggestion-card">
          <span class="card-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </span>
          <div class="card-text">
            <strong>System Status</strong>
            <span>Real-time uptime and infrastructure health</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    max-width: 680px;
    margin: 2rem auto 5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.5rem;
  }

  .error-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .error-code-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .error-headline {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .error-message {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 520px;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .error-suggestions {
    width: 100%;
    text-align: left;
    margin-top: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
  }

  .suggestions-title {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
    text-align: center;
  }

  .suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.85rem;
  }

  .suggestion-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 0.9rem 1.1rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .suggestion-card:hover {
    border-color: #3b82f6;
    transform: translateY(-1px);
    background: var(--bg-hover, var(--bg-surface));
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    flex-shrink: 0;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .card-text strong {
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .card-text span {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
</style>
