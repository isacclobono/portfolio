---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';

const services = [
  {
    name: "Edge CDN & Global Hosting",
    description: "Cloudflare Edge network, static asset delivery, and SSL termination",
    status: "Operational",
    uptime: "99.99%",
    iconType: "globe"
  },
  {
    name: "SK Agent AI Copilot (Groq LPU API)",
    description: "Fast LLM streaming inference engine & semantic knowledge routing",
    status: "Operational",
    uptime: "99.95%",
    iconType: "zap"
  },
  {
    name: "Google Calendar & Meet Sync",
    description: "1:1 Architecture consultation booking and calendar scheduling",
    status: "Operational",
    uptime: "100.0%",
    iconType: "calendar"
  },
  {
    name: "Developer Tools Suite",
    description: "In-browser client-side utilities (Estimator, JWT Decoder, SQL, Cron)",
    status: "Operational",
    uptime: "100.0%",
    iconType: "wrench"
  },
  {
    name: "IndexedDB Local Chat Storage",
    description: "Client-side private conversation database (SK_Portfolio_ChatDB)",
    status: "Operational",
    uptime: "100.0%",
    iconType: "database"
  }
];

const metrics = [
  { label: "Core Web Vitals", value: "100 / 100", change: "Optimal" },
  { label: "Average Edge Latency", value: "< 25ms", change: "Global CDN" },
  { label: "LLM Streaming Speed", value: "~300 tok/s", change: "Groq LPU" },
  { label: "Monthly Uptime", value: "99.99%", change: "Last 90 days" }
];
---

<Layout 
  title="System Status | SK Builds" 
  description="Real-time operational status, uptime metrics, and service health for Sunil Khobragade's portfolio and developer tools suite." 
  currentPath="/status"
>
  <Breadcrumb items={[
    { label: 'System Status' }
  ]} />

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <Button href="/" variant="back" size="sm">
      Back to home
    </Button>
  </div>

  <div class="status-container">
    <!-- Main Status Hero Card -->
    <div class="status-hero-card">
      <div class="status-pulse-wrap">
        <span class="pulse-dot"></span>
        <span class="pulse-ring"></span>
      </div>
      <div class="status-hero-text">
        <h1 class="status-hero-title">All Systems Operational</h1>
        <p class="status-hero-subtitle">All infrastructure, AI engines, and developer services are running smoothly with zero active incidents.</p>
      </div>
    </div>

    <!-- Performance Metrics Bar -->
    <div class="metrics-grid">
      {metrics.map(m => (
        <div class="metric-card">
          <span class="metric-label">{m.label}</span>
          <span class="metric-value">{m.value}</span>
          <span class="metric-change">{m.change}</span>
        </div>
      ))}
    </div>

    <!-- Live Services Breakdown -->
    <section class="services-section">
      <h2 class="section-title">Core Services Health</h2>
      <div class="services-list">
        {services.map(svc => (
          <div class="service-row">
            <div class="service-left">
              <span class="service-icon-wrap">
                {svc.iconType === 'globe' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
                  </svg>
                )}
                {svc.iconType === 'zap' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                )}
                {svc.iconType === 'calendar' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                  </svg>
                )}
                {svc.iconType === 'wrench' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                  </svg>
                )}
                {svc.iconType === 'database' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>
                  </svg>
                )}
              </span>
              <div class="service-info">
                <h3 class="service-name">{svc.name}</h3>
                <p class="service-desc">{svc.description}</p>
              </div>
            </div>
            <div class="service-right">
              <span class="service-uptime">{svc.uptime}</span>
              <span class="service-status-pill">
                <span class="dot-green"></span>
                {svc.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Past Incidents -->
    <section class="incidents-section">
      <h2 class="section-title">Recent Activity &amp; Uptime History</h2>
      <div class="incident-card empty-state">
        <div class="check-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div>
          <strong>No incidents reported in the last 90 days.</strong>
          <p>Zero downtime across edge deployments, AI query endpoints, and client booking tools.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .status-container {
    max-width: 820px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Status Hero Card */
  .status-hero-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 1rem;
    padding: 1.5rem 1.75rem;
  }

  .status-pulse-wrap {
    position: relative;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pulse-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #10b981;
    z-index: 2;
  }

  .pulse-ring {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.4);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .status-hero-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
  }

  .status-hero-subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .metric-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
  }

  .metric-change {
    font-size: 0.75rem;
    color: #10b981;
    font-weight: 600;
  }

  /* Services Section */
  .section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    transition: border-color 0.15s ease;
  }

  .service-row:hover {
    border-color: var(--border-hover, #3b82f6);
  }

  .service-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .service-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    flex-shrink: 0;
  }

  .service-name {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.15rem 0;
  }

  .service-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .service-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .service-uptime {
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-secondary);
  }

  .service-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    padding: 4px 9px;
    border-radius: 9999px;
  }

  .dot-green {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  /* Incident Section */
  .empty-state {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .check-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .empty-state strong {
    font-size: 0.9rem;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.15rem;
  }

  .empty-state p {
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 600px) {
    .service-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .service-right {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--border-color);
      padding-top: 0.5rem;
    }
  }
</style>
