---
import Layout from '../layouts/Layout.astro';
import TechStackPage from './tech-stack.astro';
---

<meta http-equiv="refresh" content="0;url=/tech-stack" />
<script is:inline>
  window.location.replace('/tech-stack');
</script>

<Layout title="Redirecting to Tech Stack | SK Builds" currentPath="/uses" noindex={true}>
  <div style="max-width: 600px; margin: 4rem auto; text-align: center; padding: 2rem;">
    <p style="color: var(--text-secondary);">Redirecting to <a href="/tech-stack" style="color: var(--text-primary); font-weight: 600;">/tech-stack</a>...</p>
  </div>
</Layout>
