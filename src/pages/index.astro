---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../data/site';
import { TECHNICAL_SKILLS, EDUCATION } from '../data/skills';

// Fetch dynamic collections
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const blogs = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const workEntries = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={SITE.AUTHOR} currentPath="/">
  <!-- Introduction Hero Section -->
  <section class="hero-section" style="margin-bottom: 2rem;">
    <!-- Live Availability Badge -->
    <div class="availability-badge">
      <span class="beacon-pulse" aria-hidden="true"></span>
      <span>Available for AI Architecture &amp; Senior Engineering</span>
    </div>

    <h1 style="font-size: 2.15rem; font-weight: 800; margin-bottom: 0.4rem; letter-spacing: -0.03em; line-height: 1.2;">
      Sunil Khobragade
    </h1>
    <p style="font-size: 1.05rem; color: var(--text-primary); font-weight: 600; margin-bottom: 0.85rem; letter-spacing: -0.01em;">
      {SITE.ROLE} &bull; <span style="color: var(--text-muted); font-weight: 400;">{SITE.LOCATION}</span>
    </p>
    <p style="margin-bottom: 1.25rem; font-size: 0.95rem; line-height: 1.65; color: var(--text-secondary);">
      {SITE.BIO}
    </p>

    <!-- Sleek Social & Contact Badges -->
    <SocialLinks />

    <!-- Hero Conversion CTA Engine -->
    <div class="hero-cta-group">
      <a href="/tools/appointment" class="btn-hero btn-hero-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Book Consultation</span>
      </a>

      <a href="/tools" class="btn-hero btn-hero-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span>Developer Tools</span>
      </a>

      <button type="button" id="hero-open-ai-chat" class="btn-hero btn-hero-ai cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8V4H8"></path>
          <rect width="16" height="12" x="4" y="8" rx="2"></rect>
          <path d="M2 14h2"></path>
          <path d="M20 14h2"></path>
          <path d="M15 13v2"></path>
          <path d="M9 13v2"></path>
        </svg>
        <span>Ask AI Copilot</span>
      </button>
    </div>
  </section>

  <!-- Bento Key Engineering Highlights Grid -->
  <section class="bento-stats-grid" aria-label="Key Engineering Highlights">
    <div class="bento-stat-card">
      <div class="bento-stat-value">6+ Yrs</div>
      <div class="bento-stat-label">Engineering Exp</div>
    </div>
    <div class="bento-stat-card">
      <div class="bento-stat-value">100%</div>
      <div class="bento-stat-label">Strict TypeScript</div>
    </div>
    <div class="bento-stat-card">
      <div class="bento-stat-value">&lt; 25ms</div>
      <div class="bento-stat-label">Edge Latency</div>
    </div>
    <div class="bento-stat-card">
      <div class="bento-stat-value">300+ t/s</div>
      <div class="bento-stat-label">Groq AI Inference</div>
    </div>
  </section>

  <!-- Technical Skills Section -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.25rem;">
      <h2>Technical Skills</h2>
      <a href="/tech-stack" class="see-all-link">Explore full stack &rarr;</a>
    </div>
    <div class="skills-grid">
      {TECHNICAL_SKILLS.map((cat) => (
        <div class="skill-card">
          <div class="skill-category-title">{cat.title}</div>
          <div class="skill-pill-list">
            {cat.skills.map((skill) => (
              <span class="skill-pill">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects Section (Dynamic) -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
      <h2>Recent Projects</h2>
      <a href="/projects" class="see-all-link">See all projects &rarr;</a>
    </div>
    <div class="projects-list" style="margin-top: 0;">
      {projects.map((project) => (
        <Card 
          href={`/projects/${project.id}`}
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- Work Experience Section (Clean Preview: Title, Company, Timeline - No Bullets) -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
      <h2>Work Experience</h2>
      <a href="/work" class="see-all-link">See all work &rarr;</a>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {workEntries.map((entry) => (
        <div class="work-item" style="margin-bottom: 0;">
          <div class="work-period">{entry.data.dateStart} – {entry.data.dateEnd}</div>
          <div class="work-company">{entry.data.role}</div>
          <div class="work-role" style="margin-bottom: 0;">
            {entry.data.company} {entry.data.location ? `• ${entry.data.location}` : ''}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Education & Training Section (Clean Preview) -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
      <h2>Education & Certifications</h2>
      <a href="/education" class="see-all-link">View all education &rarr;</a>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {EDUCATION.slice(0, 2).map((edu) => (
        <div class="work-item" style="margin-bottom: 0;">
          <div class="work-period">{edu.period}</div>
          <div class="work-company">{edu.degree}</div>
          <div class="work-role" style="margin-bottom: 0;">{edu.institution}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent Blog Posts Section (Dynamic) -->
  <section style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
      <h2>Recent Blog Posts</h2>
      <a href="/blog" class="see-all-link">See all posts &rarr;</a>
    </div>
    <div class="projects-list" style="margin-top: 0;">
      {blogs.map((b) => (
        <Card 
          href={`/blog/${b.id}`}
          title={b.data.title}
          description={b.data.description}
          tags={b.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- Freelance Inquiries, Estimator & Consultation CTA -->
  <section style="margin-bottom: 3rem;">
    <div class="skill-card" style="padding: 1.4rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
        <div>
          <div style="font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.35rem;">
            Looking for a Freelance Senior Developer?
          </div>
          <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
            Calculate your project's technical architecture, get a timeline estimate, or book a 1:1 consultation call on Google Calendar.
          </p>
        </div>
        <a href="/tools" class="action-btn btn-primary" style="margin: 0; padding: 0.45rem 0.9rem; font-size: 0.825rem;">
          Open Tools &amp; Booking &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Connect Section -->
  <section style="margin-bottom: 1.5rem;">
    <h2>Let's Connect</h2>
    <p>
      If you want to get in touch with me about a new project or just want to say hi, reach out via email at <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a> or connect with me on <a href={SITE.LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a> and <a href={SITE.GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </section>
</Layout>

<script>
  function setupHeroAiTrigger() {
    const aiBtn = document.getElementById('hero-open-ai-chat');
    if (!aiBtn) return;
    aiBtn.addEventListener('click', () => {
      // Find chatbot trigger and open it
      const chatbotTrigger = document.querySelector('#chatbot-trigger') as HTMLButtonElement | null;
      if (chatbotTrigger) {
        chatbotTrigger.click();
      } else {
        const toggleBtn = document.querySelector('.chatbot-toggle-btn') as HTMLButtonElement | null;
        if (toggleBtn) toggleBtn.click();
      }
    });
  }

  setupHeroAiTrigger();
  document.addEventListener('astro:after-swap', setupHeroAiTrigger);
</script>
