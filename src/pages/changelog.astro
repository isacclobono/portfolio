---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';

const releases = [
  {
    version: "v2.6.0",
    date: "September 2026",
    badge: "Astro 6 → 7 Upgrade",
    badgeType: "launch",
    summary: "Major framework upgrade from Astro 6 to Astro 7 (v7.2+) powered by Vite 6 and Content Layer.",
    items: [
      "Upgraded core framework dependencies to Astro v7.2.0 and @astrojs/mdx v7.0.5.",
      "Migrated content architecture to official Astro 7 Content Layer API (src/content.config.ts) with glob() loaders.",
      "Adopted Vite 6 build pipeline with sub-second hot module reloading (HMR) and optimized static asset hashing.",
      "Streamlined Server-Sent Events (SSE) AI inference pipelines for ultra-fast response streaming."
    ]
  },
  {
    version: "v2.5.0",
    date: "September 2026",
    badge: "PWA & Architecture Suite",
    badgeType: "primary",
    summary: "Full Progressive Web App (PWA) offline installation, complete HTTP error page suite, and /tech-stack blueprint.",
    items: [
      "Implemented full Progressive Web App (PWA) with Service Worker (/sw.js), offline caching, and 4 quick launch shortcuts.",
      "Launched dedicated /tech-stack blueprint detailing AI inference engines, cloud hosting, and database technologies.",
      "Added complete HTTP diagnostic error suite: 401 Unauthorized, 403 Forbidden, 404 Not Found, 500 Server Error, and 503 Maintenance.",
      "Removed default link underlines across the entire design system in favor of crisp hover state transitions."
    ]
  },
  {
    version: "v2.4.0",
    date: "September 2026",
    badge: "Major Feature Release",
    badgeType: "primary",
    summary: "Google Calendar & Meet synchronization, Status monitor, Tech Stack (/tech-stack) page, and Privacy/Terms compliance.",
    items: [
      "Integrated live Google Calendar & Google Meet sync into /tools/appointment with dynamic UTC time calculations.",
      "Added /status page with live infrastructure metrics, edge CDN latency, and uptime logs.",
      "Published Google API User Data Policy compliant Privacy Policy and Terms of Service.",
      "Updated domain to https://sunilkhobragade.pages.dev across canonical headers and sitemap."
    ]
  },
  {
    version: "v2.3.0",
    date: "September 2026",
    badge: "AI & UI Upgrade",
    badgeType: "accent",
    summary: "SK Agent AI Copilot overhaul: WhatsApp messenger bubbles, compact 12.5px typography, and IndexedDB local storage.",
    items: [
      "Connected Groq LPU streaming inference (300+ tok/s) with dual-engine offline semantic fallback.",
      "Implemented WhatsApp-style left/right bubble layout with local timestamps and delivery checkmarks.",
      "Added persistent IndexedDB storage (SK_Portfolio_ChatDB) so chat history survives page reloads.",
      "Added multi-edge drag resizing and 1-click expand/collapse modal controls with localStorage memory.",
      "Enhanced system prompt into a developer copilot capable of writing Python, Node.js, and SQL snippets."
    ]
  },
  {
    version: "v2.2.0",
    date: "August 2026",
    badge: "Developer Tools Suite",
    badgeType: "feature",
    summary: "Launched in-browser client-side developer utility suite.",
    items: [
      "Launched interactive Project Cost & Timeline Estimator with live breakdown and printable PDF export.",
      "Built client-side JWT Token Decoder with header/payload inspection and expiry timer.",
      "Added instant SQL Formatter & Beautifier supporting PostgreSQL, MySQL, and SQLite dialects.",
      "Added Cron Expression Generator with human-readable English schedule translation."
    ]
  },
  {
    version: "v2.1.0",
    date: "August 2026",
    badge: "SEO & 100/100 Core Web Vitals",
    badgeType: "perf",
    summary: "Technical SEO overhaul, Schema.org Graph, and sub-second edge performance.",
    items: [
      "Implemented comprehensive Schema.org JSON-LD structured data (Person, WebSite, BlogPosting, Service).",
      "Added dynamic /llms.txt endpoint for AI search crawlers and LLM indexing.",
      "Optimized zero-runtime JavaScript overhead for 100/100 Lighthouse and Core Web Vitals score.",
      "Added RSS 2.0 dynamic XML feed and automated XML sitemap generation."
    ]
  },
  {
    version: "v2.0.0",
    date: "July 2026",
    badge: "Astro 5 → 6 Upgrade",
    badgeType: "launch",
    summary: "Upgraded core portfolio architecture from Astro 5 to Astro 6 with enhanced Islands rendering.",
    items: [
      "Upgraded from Astro 5 to Astro 6 with unified server actions and static prerendering optimizations.",
      "Implemented responsive vanilla CSS token design system with seamless Dark/Light theme switching.",
      "Structured work experience timeline, featured engineering case studies, and technical blog."
    ]
  },
  {
    version: "v1.6.0",
    date: "January 2025",
    badge: "AI & Vector Search",
    badgeType: "feature",
    summary: "Integrated pgvector embeddings and Retrieval-Augmented Generation (RAG).",
    items: [
      "Configured PostgreSQL pgvector HNSW indexing for instant semantic document retrieval.",
      "Created technical articles on production RAG pipelines and vector database trade-offs."
    ]
  },
  {
    version: "v1.4.0",
    date: "February 2024",
    badge: "Real-Time Infrastructure",
    badgeType: "perf",
    summary: "WebSocket clustering and high-concurrency event stream scaling.",
    items: [
      "Architected distributed WebSocket clustering with Redis Pub/Sub for sub-10ms messaging.",
      "Published research benchmarks on handling 100k concurrent client socket connections."
    ]
  },
  {
    version: "v1.2.0",
    date: "June 2023",
    badge: "CI/CD & DevOps Automation",
    badgeType: "launch",
    summary: "Blue-green container deployment pipeline with GitHub Actions.",
    items: [
      "Automated zero-downtime containerized deployments on Docker and Nginx reverse proxies.",
      "Published technical guides on Transactional Outbox patterns and high-throughput Node.js microservices."
    ]
  },
  {
    version: "v1.0.0",
    date: "March 2022",
    badge: "Initial Release",
    badgeType: "launch",
    summary: "Initial release of Sunil Khobragade's engineering portfolio and technical writing publication.",
    items: [
      "Launched initial engineering publication focusing on event-driven microservices, RabbitMQ, and PostgreSQL query tuning.",
      "Established foundational clean architecture principles for full-stack web platforms."
    ]
  }
];
---

<Layout 
  title="Engineering Changelog & Release Notes | SK Builds" 
  description="Chronological record of releases, framework migrations (Astro 5 to 6, 6 to 7), AI copilot upgrades, and engineering milestones from 2022 to 2026." 
  currentPath="/changelog"
>
  <Breadcrumb items={[
    { label: 'Engineering Changelog' }
  ]} />

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <Button href="/" variant="back" size="sm">
      Back to home
    </Button>
  </div>

  <div class="changelog-container">
    <header class="changelog-header">
      <div class="changelog-badge-pill">
        <span class="badge-dot"></span>
        PLATFORM &amp; ARCHITECTURE LOG &bull; 2022 – 2026
      </div>
      <h1 class="changelog-title">Engineering Changelog</h1>
      <p class="changelog-subtitle">A chronological record of architectural milestones, framework migrations (Astro 5 → 6 → 7), AI copilot upgrades, and platform optimizations.</p>
    </header>

    <div class="timeline">
      {releases.map((rel) => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-card">
            <div class="release-header">
              <div class="version-row">
                <span class="version-tag">{rel.version}</span>
                <span class="release-date">{rel.date}</span>
              </div>
              <span class={`release-badge ${rel.badgeType}`}>{rel.badge}</span>
            </div>

            <p class="release-summary">{rel.summary}</p>

            <ul class="release-list">
              {rel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .changelog-container {
    max-width: 820px;
    margin: 0 auto 4rem auto;
  }

  .changelog-header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .changelog-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .changelog-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
  }

  .changelog-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Timeline Tree */
  .timeline {
    position: relative;
    padding-left: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 5px;
    width: 2px;
    background: var(--border-color);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -1.75rem;
    top: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow: 0 0 0 3px var(--bg-primary);
    z-index: 2;
  }

  .timeline-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.85rem;
    padding: 1.35rem 1.5rem;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .timeline-card:hover {
    border-color: #3b82f6;
    background: var(--bg-card-hover, var(--bg-card));
    transform: translateY(-1px);
  }

  .release-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .version-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .version-tag {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
  }

  .release-date {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .release-badge {
    font-size: 0.725rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .release-badge.primary {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
  }

  .release-badge.accent {
    background: rgba(168, 85, 247, 0.12);
    color: #a855f7;
  }

  .release-badge.feature {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
  }

  .release-badge.perf {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
  }

  .release-badge.launch {
    background: rgba(236, 72, 153, 0.12);
    color: #ec4899;
  }

  .release-summary {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
  }

  .release-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .release-list li {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
