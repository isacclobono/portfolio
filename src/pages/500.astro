---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
---

<Layout 
  title="500 — Server Error | SK Builds" 
  description="An unexpected error occurred while processing your request. Please try again or return to the homepage." 
  currentPath="/500"
  noindex={true}
>
  <div class="error-container">
    <div class="error-visual">
      <span class="error-code-badge">500 Server Error</span>
      <h1 class="error-headline">Something Went Wrong</h1>
      <p class="error-message">
        We encountered an unexpected issue while serving this request. Our system monitoring has been alerted.
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="error-actions">
      <Button href="/" variant="primary" size="md">
        Return to Home
      </Button>

      <Button href="/status" variant="secondary" size="md">
        🟢 Check System Status
      </Button>

      <a href="mailto:skhobragade993@gmail.com" class="action-link-btn">
        Report Issue
      </a>
    </div>
  </div>
</Layout>

<style>
  .error-container {
    max-width: 620px;
    margin: 4rem auto 6rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2.25rem;
  }

  .error-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .error-code-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .error-headline {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .error-message {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 480px;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-link-btn {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: underline;
    padding: 0.5rem 0.75rem;
    transition: color 0.15s ease;
  }

  .action-link-btn:hover {
    color: var(--text-primary);
  }
</style>
