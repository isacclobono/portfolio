---
import ErrorLayout from '../layouts/ErrorLayout.astro';
---

<ErrorLayout
  code="401"
  status="UNAUTHORIZED"
  title="Authentication Required"
  description="You do not have valid authentication credentials or bearer tokens to access this protected resource."
  accentColor="blue"
  primaryHref="/"
  primaryLabel="Return to Homepage"
  secondaryHref="/tools/jwt-decoder"
  secondaryLabel="Inspect JWT Token"
  secondaryIcon="jwt"
/>
