---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group posts by Year dynamically
const postsByYear = allPosts.reduce<Record<string, typeof allPosts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => b.localeCompare(a));

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
};

const blogCategories = [
  { label: 'All Articles', key: 'all' },
  { label: 'AI & LLMs', key: 'ai' },
  { label: 'Distributed Systems & Microservices', key: 'microservices' },
  { label: 'Databases & Performance', key: 'database' },
  { label: 'Edge & Web Architecture', key: 'web' },
];
---

<Layout 
  title="Technical Articles & Publications | SK Builds" 
  description="Deep-dives on distributed systems, real-time microservices, AI pipelines, database indexing, and web performance by Sunil Khobragade." 
  currentPath="/blog"
>
  <Breadcrumb items={[{ label: 'Blog & Articles' }]} />

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <Button href="/" variant="back" size="sm">
      Back to home
    </Button>
  </div>

  <div class="blog-index-container">
    <!-- Header Block -->
    <header class="blog-header">
      <div class="blog-pill-badge">
        <span class="badge-dot"></span>
        PUBLICATIONS &bull; 2022 – 2026
      </div>
      <h1 class="blog-main-title">Technical Articles</h1>
      <p class="blog-subtitle">
        Deep-dives on distributed systems, real-time microservices, AI pipelines, PostgreSQL optimization, and zero-JS web architectures.
      </p>
    </header>

    <!-- Interactive Category Filter Bar -->
    <div class="filter-pill-bar" id="blog-filters">
      {blogCategories.map((cat, idx) => (
        <button 
          type="button" 
          class:list={["filter-pill-btn", { active: idx === 0 }]}
          data-filter={cat.key}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Articles Grouped by Year -->
    <div class="years-stream" id="blog-years-stream">
      {years.map((year) => (
        <section class="year-block" data-year={year}>
          <div class="year-header">
            <h2 class="year-title">{year}</h2>
            <span class="year-count">{postsByYear[year].length} {postsByYear[year].length === 1 ? 'Article' : 'Articles'}</span>
          </div>

          <div class="posts-list">
            {postsByYear[year].map((post) => {
              const tags = post.data.tags || [];
              const tagsString = (tags.join(' ') + ' ' + post.data.title).toLowerCase();
              let category = 'all';
              if (tagsString.includes('ai') || tagsString.includes('llm') || tagsString.includes('groq') || tagsString.includes('agent') || tagsString.includes('langgraph') || tagsString.includes('rag')) {
                category += ' ai';
              }
              if (tagsString.includes('microservice') || tagsString.includes('redis') || tagsString.includes('rabbitmq') || tagsString.includes('booking') || tagsString.includes('websocket') || tagsString.includes('outbox')) {
                category += ' microservices';
              }
              if (tagsString.includes('postgresql') || tagsString.includes('pgvector') || tagsString.includes('database') || tagsString.includes('query') || tagsString.includes('multi-tenant')) {
                category += ' database';
              }
              if (tagsString.includes('astro') || tagsString.includes('edge') || tagsString.includes('cloudflare') || tagsString.includes('zero-js') || tagsString.includes('web') || tagsString.includes('payment') || tagsString.includes('docker')) {
                category += ' web';
              }

              return (
                <a href={`/blog/${post.id}`} class="post-card" data-category={category}>
                  <div class="post-main-content">
                    <div class="post-meta-row">
                      <span class="post-date">{formatDate(post.data.date)}</span>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="post-tags-inline">
                          {post.data.tags.slice(0, 3).map((tag) => (
                            <span class="post-tag-pill">{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>

                    <h3 class="post-title">{post.data.title}</h3>
                    <p class="post-desc">{post.data.description}</p>
                  </div>

                  <div class="post-arrow-box" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .blog-index-container {
    max-width: 820px;
    margin: 0 auto 5rem auto;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* Header */
  .blog-header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .blog-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(59, 130, 246, 0.08);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.22);
    padding: 4px 12px;
    border-radius: 9999px;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .blog-main-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .blog-subtitle {
    font-size: 0.975rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 660px;
    line-height: 1.6;
  }

  /* Years Stream */
  .years-stream {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .year-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .year-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-color);
  }

  .year-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
    margin: 0;
  }

  .year-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Posts List */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    padding: 1.15rem 1.35rem;
    text-decoration: none !important;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .post-card:hover {
    border-color: #3b82f6;
    background: var(--bg-card-hover, var(--bg-card));
    transform: translateY(-1px);
  }

  .post-card:hover .post-arrow-box {
    transform: translateX(3px);
    color: #3b82f6;
  }

  .post-card:hover .post-title {
    color: #3b82f6;
  }

  .post-main-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: 0.775rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-muted);
  }

  .post-tags-inline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-tag-pill {
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    color: var(--text-secondary);
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .post-arrow-box {
    color: var(--text-muted);
    transition: transform 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .post-card {
      padding: 1rem;
    }
  }
</style>

<script>
  function setupBlogFilters() {
    const filterButtons = document.querySelectorAll('#blog-filters .filter-pill-btn');
    const postCards = document.querySelectorAll('#blog-years-stream .post-card') as NodeListOf<HTMLElement>;
    const yearBlocks = document.querySelectorAll('#blog-years-stream .year-block') as NodeListOf<HTMLElement>;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || 'all';

        postCards.forEach((card) => {
          const category = card.getAttribute('data-category') || '';
          if (filter === 'all' || category.includes(filter)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Hide year blocks if all children are hidden
        yearBlocks.forEach((block) => {
          const visiblePosts = block.querySelectorAll('.post-card:not([style*="display: none"])');
          if (visiblePosts.length === 0) {
            block.style.display = 'none';
          } else {
            block.style.display = 'flex';
          }
        });
      });
    });
  }

  setupBlogFilters();
  document.addEventListener('astro:after-swap', setupBlogFilters);
</script>
