---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
---

<Layout 
  title="503 — Service Unavailable | SK Builds" 
  description="The service is temporarily undergoing scheduled maintenance or experiencing capacity constraints." 
  currentPath="/503"
  noindex={true}
>
  <div class="error-page-wrapper">
    <header class="error-header-block">
      <div class="error-pill-badge yellow">
        <span class="pulse-dot-yellow"></span>
        HTTP 503 &bull; SERVICE_UNAVAILABLE
      </div>
      <h1 class="error-main-title">Temporary Maintenance</h1>
      <p class="error-description">
        The system is currently undergoing brief scheduled maintenance or experiencing high traffic. Services will restore automatically in a few moments.
      </p>
    </header>

    <!-- Diagnostics Card -->
    <div class="diagnostic-card" aria-hidden="true">
      <div class="diag-header">
        <div class="diag-dots">
          <span class="dot d-red"></span>
          <span class="dot d-yellow"></span>
          <span class="dot d-green"></span>
        </div>
        <span class="diag-filename">maintenance-window.log</span>
      </div>
      <div class="diag-body">
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Edge Status: <span class="diag-amber">MAINTENANCE_DRAIN_ACTIVE</span>
        </div>
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Automated Recovery: <span class="diag-success">Active Health Checks (Interval: 15s)</span>
        </div>
        <div class="diag-line">
          <span class="diag-dim">&gt;</span> Action: <span class="diag-host">Verify /status for live infrastructure telemetry</span>
        </div>
      </div>
    </div>

    <!-- Action Buttons with Generous Spacing -->
    <div class="error-actions-group">
      <Button href="/" variant="primary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Return to Homepage</span>
      </Button>

      <Button href="/status" variant="secondary" size="md">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
        </svg>
        <span>Live System Status</span>
      </Button>

      <a href="mailto:skhobragade993@gmail.com" class="error-report-link">
        Contact Engineering Support &rarr;
      </a>
    </div>
  </div>
</Layout>

<style>
  .error-page-wrapper {
    max-width: 780px;
    margin: 2.5rem auto 6rem auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .error-header-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .error-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.775rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(234, 179, 8, 0.08);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    width: auto;
  }

  .pulse-dot-yellow {
    width: 6.5px;
    height: 6.5px;
    border-radius: 50%;
    background: #eab308;
    box-shadow: 0 0 6px rgba(234, 179, 8, 0.8);
  }

  .error-main-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .error-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 620px;
    line-height: 1.6;
  }

  .diagnostic-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: var(--font-mono, monospace);
  }

  .diag-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-card);
  }

  .diag-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .d-red { background: #ef4444; }
  .d-yellow { background: #eab308; }
  .d-green { background: #10b981; }

  .diag-filename {
    font-size: 0.725rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-left: 4px;
  }

  .diag-body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.825rem;
  }

  .diag-line {
    margin: 0;
    line-height: 1.45;
  }

  .diag-dim { color: var(--text-muted); }
  .diag-amber { color: #eab308; font-weight: 600; }
  .diag-host { color: #0284c7; }
  .diag-success { color: #10b981; font-weight: 600; }

  .error-actions-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 1rem 0;
  }

  .error-report-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .error-report-link:hover {
    color: var(--text-primary);
  }
</style>
