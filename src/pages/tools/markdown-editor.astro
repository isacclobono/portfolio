---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Interactive Markdown Editor & Live HTML Preview | SK Builds" 
  description="Client-side Markdown editor with instant live HTML rendering, word counts, and formatting actions." 
  currentPath="/tools/markdown-editor"
>
  <Breadcrumb items={[
    { label: 'Tools', href: '/tools' },
    { label: 'Markdown Editor' }
  ]} />

  <Button href="/tools" variant="back" size="sm">
    Back to tools
  </Button>

  <div style="margin: 1.5rem 0 2rem;">
    <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
      Markdown Editor &amp; Live HTML Preview
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      Write, format, and preview Markdown in real-time with zero latency. Export clean HTML or download formatted markdown files.
    </p>
  </div>

  <div class="tool-card">
    <!-- Toolbar -->
    <div class="md-toolbar">
      <div class="md-btn-group">
        <button type="button" class="md-tool-btn" data-tag="bold" title="Bold (Ctrl+B)"><b>B</b></button>
        <button type="button" class="md-tool-btn" data-tag="italic" title="Italic (Ctrl+I)"><i>I</i></button>
        <button type="button" class="md-tool-btn" data-tag="h1" title="Heading 1">H1</button>
        <button type="button" class="md-tool-btn" data-tag="h2" title="Heading 2">H2</button>
        <button type="button" class="md-tool-btn" data-tag="quote" title="Quote">&ldquo;</button>
        <button type="button" class="md-tool-btn" data-tag="code" title="Code Block">&lt;/&gt;</button>
        <button type="button" class="md-tool-btn" data-tag="link" title="Link">&#128279;</button>
        <button type="button" class="md-tool-btn" data-tag="table" title="Table">&#8862;</button>
        <button type="button" class="md-tool-btn" data-tag="task" title="Task List">&#9745;</button>
      </div>

      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span id="md-stats-badge" class="status-pill status-ready">0 words &bull; 0 chars</span>
        <button type="button" id="btn-copy-html" class="action-btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">
          Copy HTML
        </button>
        <button type="button" id="btn-clear-md" class="action-btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">
          Clear
        </button>
      </div>
    </div>

    <!-- Dual Editor & Preview Workspace -->
    <div class="tool-dual-grid">
      <!-- Input -->
      <div class="code-box-wrapper">
        <div class="code-box-header">
          <span class="code-box-title">Markdown Source</span>
        </div>
        <textarea 
          id="md-input" 
          class="code-textarea" 
          style="height: 420px;"
          placeholder="Type or paste Markdown here..."
          spellcheck="false"
        ></textarea>
      </div>

      <!-- Live Preview -->
      <div class="code-box-wrapper">
        <div class="code-box-header">
          <span class="code-box-title">Live Rendered HTML</span>
          <span class="status-pill status-ready">Live Sync</span>
        </div>
        <div id="md-preview-output" class="md-rendered-preview"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tool-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .md-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.85rem;
  }

  .md-btn-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .md-tool-btn {
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .md-tool-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-card-hover);
  }

  .tool-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .tool-dual-grid {
      grid-template-columns: 1fr;
    }
  }

  .code-box-wrapper {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.85rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-card);
  }

  [data-theme="light"] .code-box-header {
    background: rgba(0, 0, 0, 0.04);
  }

  .code-box-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .code-textarea {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0.85rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.55;
    outline: none;
    resize: vertical;
    box-sizing: border-box;
  }

  .md-rendered-preview {
    height: 420px;
    overflow: auto;
    padding: 1rem;
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.65;
    box-sizing: border-box;
  }

  .md-rendered-preview h1, .md-rendered-preview h2, .md-rendered-preview h3 {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .md-rendered-preview pre {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .md-rendered-preview code {
    font-family: var(--font-mono);
    background: var(--bg-pill);
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 0.825rem;
  }

  .md-rendered-preview blockquote {
    border-left: 3px solid var(--accent-blue);
    margin: 0.75rem 0;
    padding-left: 0.85rem;
    color: var(--text-muted);
  }

  .md-rendered-preview table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.75rem 0;
  }

  .md-rendered-preview th, .md-rendered-preview td {
    border: 1px solid var(--border-card);
    padding: 0.4rem 0.6rem;
    font-size: 0.825rem;
  }

  .status-pill {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .status-ready {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
  }
</style>

<script>
  function setupMarkdownEditor() {
    const inputEl = document.getElementById('md-input') as HTMLTextAreaElement | null;
    const previewEl = document.getElementById('md-preview-output');
    const statsBadge = document.getElementById('md-stats-badge');
    const copyHtmlBtn = document.getElementById('btn-copy-html');
    const clearBtn = document.getElementById('btn-clear-md');
    const toolBtns = document.querySelectorAll('.md-tool-btn');

    if (!inputEl || !previewEl) return;

    function renderMarkdown(md: string): string {
      if (!md) return '<p style="color: var(--text-muted); font-style: italic;">Live preview will appear here...</p>';

      let html = md
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Code blocks
      html = html.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>');

      // Inline code
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

      // Headings
      html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

      // Blockquotes
      html = html.replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>');

      // Bold & Italic
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');
      html = html.replace(/__([^_]+)__/g, '<strong>$1</strong>');
      html = html.replace(/_([^_]+)_/g, '<em>$1</em>');

      // Links
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); text-decoration: underline;">$1</a>');

      // Task lists
      html = html.replace(/^- \[x\] (.*$)/gim, '<div style="display: flex; gap: 0.4rem; align-items: center;"><input type="checkbox" checked disabled /> <span>$1</span></div>');
      html = html.replace(/^- \[ \] (.*$)/gim, '<div style="display: flex; gap: 0.4rem; align-items: center;"><input type="checkbox" disabled /> <span>$1</span></div>');

      // Unordered lists
      html = html.replace(/^- (.*$)/gim, '<li>$1</li>');

      // Paragraphs
      html = html.replace(/\n\n/g, '<br/><br/>');

      return html;
    }

    function update() {
      const text = inputEl.value;
      previewEl.innerHTML = renderMarkdown(text);

      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      const chars = text.length;
      if (statsBadge) {
        statsBadge.textContent = `${words} words • ${chars} chars`;
      }
    }

    const defaultSample = `# 🚀 High-Throughput Distributed Microservices

Welcome to the **SK Builds Markdown Editor**!

## ✨ Key Architectural Features
- **Low Latency**: Sub-10ms response times with Redis caching.
- **Strict Typing**: 100% End-to-end TypeScript validation.
- **RAG Workflows**: High-density embeddings with \`pgvector\`.

> "Simplicity is prerequisite for reliability." — Edsger W. Dijkstra

### 📋 Deployment Checklist
- [x] Docker multi-stage container optimization
- [x] Cloudflare edge SSL & DNS routing
- [ ] Automated rollback validation

\`\`\`typescript
export async function getHealthStatus(): Promise<{ status: string }> {
  return { status: 'healthy' };
}
\`\`\`
`;

    inputEl.value = defaultSample;
    update();

    inputEl.addEventListener('input', update);

    toolBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        const start = inputEl.selectionStart;
        const end = inputEl.selectionEnd;
        const selected = inputEl.value.substring(start, end);

        let replacement = '';
        if (tag === 'bold') replacement = `**${selected || 'bold text'}**`;
        else if (tag === 'italic') replacement = `*${selected || 'italic text'}*`;
        else if (tag === 'h1') replacement = `\n# ${selected || 'Heading 1'}\n`;
        else if (tag === 'h2') replacement = `\n## ${selected || 'Heading 2'}\n`;
        else if (tag === 'quote') replacement = `\n> ${selected || 'Quote'}\n`;
        else if (tag === 'code') replacement = `\n\`\`\`typescript\n${selected || '// code here'}\n\`\`\`\n`;
        else if (tag === 'link') replacement = `[${selected || 'Link Title'}](https://example.com)`;
        else if (tag === 'table') replacement = `\n| Column 1 | Column 2 |\n| :--- | :--- |\n| Value A | Value B |\n`;
        else if (tag === 'task') replacement = `\n- [ ] ${selected || 'New Task Item'}\n`;

        inputEl.setRangeText(replacement, start, end, 'end');
        update();
        inputEl.focus();
      });
    });

    copyHtmlBtn?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(previewEl.innerHTML);
      const prev = copyHtmlBtn.textContent;
      copyHtmlBtn.textContent = 'HTML Copied!';
      setTimeout(() => { copyHtmlBtn.textContent = prev; }, 1600);
    });

    clearBtn?.addEventListener('click', () => {
      inputEl.value = '';
      update();
    });
  }

  setupMarkdownEditor();
  document.addEventListener('astro:after-swap', setupMarkdownEditor);
</script>
