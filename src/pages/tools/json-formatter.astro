---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="JSON Formatter, Validator & Minifier | SK Builds" 
  description="Format, beautify, validate, and minify JSON payloads with real-time error detection, sorted keys, and size metrics. 100% client-side privacy." 
  currentPath="/tools/json-formatter"
>
  <Breadcrumb items={[
    { label: 'Tools', href: '/tools' },
    { label: 'JSON Formatter' }
  ]} />

  <Button href="/tools" variant="back" size="sm">
    Back to tools
  </Button>

  <div style="margin: 1.5rem 0 2rem;">
    <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.025em;">
      JSON Formatter &amp; Validator
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      Beautify, validate, sort, and minify JSON payloads with instant error detection and payload analytics. Executes 100% locally in your browser.
    </p>
  </div>

  <div class="tool-card">
    <!-- Action Toolbar -->
    <div class="toolbar-row">
      <div class="toolbar-group">
        <label for="indent-select" style="font-size: 0.775rem; font-weight: 600; color: var(--text-muted);">Indent:</label>
        <select id="indent-select" class="tool-select">
          <option value="2">2 Spaces</option>
          <option value="4">4 Spaces</option>
          <option value="tab">Tab</option>
        </select>

        <button type="button" id="btn-format" class="btn-tool-action btn-primary-tool">Beautify</button>
        <button type="button" id="btn-minify" class="btn-tool-action">Minify</button>
        <button type="button" id="btn-sort" class="btn-tool-action">Sort Keys</button>
      </div>

      <div class="toolbar-group">
        <button type="button" id="btn-sample" class="btn-tool-action">Sample JSON</button>
        <button type="button" id="btn-clear" class="btn-tool-action">Clear</button>
        <button type="button" id="btn-copy" class="btn-tool-action btn-copy-highlight">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-text">Copy</span>
        </button>
      </div>
    </div>

    <!-- Error Banner -->
    <div id="json-error-banner" class="error-banner" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="json-error-message">Invalid JSON syntax</span>
    </div>

    <!-- Textarea Editor -->
    <div class="editor-wrap">
      <textarea 
        id="json-textarea" 
        class="json-code-input" 
        rows="16" 
        placeholder='Paste unformatted JSON here (e.g. {"name":"Sunil","role":"Architect","skills":["Astro","TypeScript","Node.js"]})'
        spellcheck="false"
      ></textarea>
    </div>

    <!-- Metrics Footer -->
    <div class="metrics-bar">
      <div class="metric-pill">
        <span class="metric-label">Status:</span>
        <span id="metric-status" class="metric-value status-valid">Valid JSON</span>
      </div>
      <div class="metric-pill">
        <span class="metric-label">Size:</span>
        <span id="metric-size" class="metric-value">0 B</span>
      </div>
      <div class="metric-pill">
        <span class="metric-label">Lines:</span>
        <span id="metric-lines" class="metric-value">0</span>
      </div>
      <div class="metric-pill">
        <span class="metric-label">Keys:</span>
        <span id="metric-keys" class="metric-value">0</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tool-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg, 12px);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toolbar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .tool-select {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    border-radius: var(--radius-sm, 6px);
    padding: 0.35rem 0.6rem;
    font-size: 0.775rem;
    font-family: inherit;
    outline: none;
    cursor: pointer;
  }

  .btn-tool-action {
    background: var(--bg-pill, rgba(255, 255, 255, 0.06));
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.775rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-tool-action:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-card-hover);
  }

  .btn-primary-tool {
    background-color: var(--accent-blue, #38bdf8);
    color: #0f172a;
    border-color: var(--accent-blue, #38bdf8);
    font-weight: 700;
  }

  .btn-primary-tool:hover {
    background-color: #0284c7;
    color: #fff;
  }

  .btn-copy-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .error-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #ef4444;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.8rem;
    font-family: var(--font-mono, monospace);
  }

  .editor-wrap {
    width: 100%;
  }

  .json-code-input {
    width: 100%;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
    line-height: 1.55;
    padding: 1rem;
    box-sizing: border-box;
    resize: vertical;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .json-code-input:focus {
    border-color: var(--accent-blue, #38bdf8);
  }

  .metrics-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
    flex-wrap: wrap;
  }

  .metric-pill {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.775rem;
  }

  .metric-label {
    color: var(--text-muted);
  }

  .metric-value {
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
    font-weight: 600;
  }

  .status-valid {
    color: #10b981;
  }

  .status-invalid {
    color: #ef4444;
  }
</style>

<script>
  function initJsonFormatter() {
    const textarea = document.getElementById('json-textarea') as HTMLTextAreaElement;
    const indentSelect = document.getElementById('indent-select') as HTMLSelectElement;
    const btnFormat = document.getElementById('btn-format');
    const btnMinify = document.getElementById('btn-minify');
    const btnSort = document.getElementById('btn-sort');
    const btnSample = document.getElementById('btn-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const copyText = document.getElementById('copy-text');
    const errorBanner = document.getElementById('json-error-banner');
    const errorMessage = document.getElementById('json-error-message');
    const metricStatus = document.getElementById('metric-status');
    const metricSize = document.getElementById('metric-size');
    const metricLines = document.getElementById('metric-lines');
    const metricKeys = document.getElementById('metric-keys');

    function getIndent(): number | string {
      const val = indentSelect?.value || '2';
      if (val === 'tab') return '\t';
      return parseInt(val, 10) || 2;
    }

    function sortObjectKeys(obj: any): any {
      if (Array.isArray(obj)) {
        return obj.map(sortObjectKeys);
      } else if (obj !== null && typeof obj === 'object') {
        const sorted: Record<string, any> = {};
        Object.keys(obj).sort().forEach((key) => {
          sorted[key] = sortObjectKeys(obj[key]);
        });
        return sorted;
      }
      return obj;
    }

    function countKeys(obj: any): number {
      let count = 0;
      if (Array.isArray(obj)) {
        obj.forEach((item) => { count += countKeys(item); });
      } else if (obj !== null && typeof obj === 'object') {
        count += Object.keys(obj).length;
        Object.values(obj).forEach((val) => { count += countKeys(val); });
      }
      return count;
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / 1048576).toFixed(2) + ' MB';
    }

    function updateMetrics(parsed: any | null, text: string) {
      const bytes = new Blob([text]).size;
      const lines = text ? text.split('\n').length : 0;
      if (metricSize) metricSize.textContent = formatBytes(bytes);
      if (metricLines) metricLines.textContent = lines.toString();

      if (parsed !== null) {
        if (metricStatus) {
          metricStatus.textContent = 'Valid JSON';
          metricStatus.className = 'metric-value status-valid';
        }
        if (metricKeys) metricKeys.textContent = countKeys(parsed).toString();
        if (errorBanner) errorBanner.style.display = 'none';
      } else if (text.trim()) {
        if (metricStatus) {
          metricStatus.textContent = 'Syntax Error';
          metricStatus.className = 'metric-value status-invalid';
        }
        if (metricKeys) metricKeys.textContent = '0';
      } else {
        if (metricStatus) {
          metricStatus.textContent = 'Empty';
          metricStatus.className = 'metric-value';
        }
        if (metricKeys) metricKeys.textContent = '0';
        if (errorBanner) errorBanner.style.display = 'none';
      }
    }

    function formatJson() {
      if (!textarea) return;
      const text = textarea.value.trim();
      if (!text) {
        updateMetrics(null, '');
        return;
      }

      try {
        const parsed = JSON.parse(text);
        const indent = getIndent();
        const formatted = JSON.stringify(parsed, null, indent);
        textarea.value = formatted;
        updateMetrics(parsed, formatted);
      } catch (err: any) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = err.message || 'Invalid JSON syntax.';
          errorBanner.style.display = 'flex';
        }
        updateMetrics(null, text);
      }
    }

    function minifyJson() {
      if (!textarea) return;
      const text = textarea.value.trim();
      if (!text) return;

      try {
        const parsed = JSON.parse(text);
        const minified = JSON.stringify(parsed);
        textarea.value = minified;
        updateMetrics(parsed, minified);
      } catch (err: any) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = err.message || 'Invalid JSON syntax.';
          errorBanner.style.display = 'flex';
        }
        updateMetrics(null, text);
      }
    }

    function sortJson() {
      if (!textarea) return;
      const text = textarea.value.trim();
      if (!text) return;

      try {
        const parsed = JSON.parse(text);
        const sorted = sortObjectKeys(parsed);
        const indent = getIndent();
        const output = JSON.stringify(sorted, null, indent);
        textarea.value = output;
        updateMetrics(sorted, output);
      } catch (err: any) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = err.message || 'Invalid JSON syntax.';
          errorBanner.style.display = 'flex';
        }
        updateMetrics(null, text);
      }
    }

    btnFormat?.addEventListener('click', formatJson);
    btnMinify?.addEventListener('click', minifyJson);
    btnSort?.addEventListener('click', sortJson);

    textarea?.addEventListener('input', () => {
      if (!textarea) return;
      const text = textarea.value.trim();
      if (!text) {
        updateMetrics(null, '');
        return;
      }
      try {
        const parsed = JSON.parse(text);
        updateMetrics(parsed, text);
      } catch (err: any) {
        updateMetrics(null, text);
      }
    });

    btnSample?.addEventListener('click', () => {
      textarea.value = JSON.stringify({
        project: "SK Builds Platform",
        version: "2.10.0",
        author: {
          name: "Sunil Khobragade",
          role: "Senior Full-Stack & AI Solutions Architect",
          location: "Hyderabad, India"
        },
        services: ["Multi-Agent Orchestration", "pgvector RAG Pipelines", "High-Throughput Microservices"],
        infrastructure: {
          runtime: "Node.js 22 LTS",
          database: "PostgreSQL 16",
          caching: "Redis Cluster",
          cloud: ["AWS", "Cloudflare"]
        },
        stats: {
          uptime: 99.99,
          requestsPerSecond: 54000,
          p99LatencyMs: 3.8
        }
      }, null, 2);
      formatJson();
    });

    btnClear?.addEventListener('click', () => {
      textarea.value = '';
      updateMetrics(null, '');
    });

    btnCopy?.addEventListener('click', () => {
      if (!textarea?.value) return;
      navigator.clipboard.writeText(textarea.value).then(() => {
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy';
        }, 2000);
      });
    });

    // Populate sample on initial load if empty
    if (textarea && !textarea.value) {
      btnSample?.click();
    }
  }

  document.addEventListener('DOMContentLoaded', initJsonFormatter);
</script>
