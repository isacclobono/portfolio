---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Card from '../../components/Card.astro';
---

<Layout 
  title="Developer Utilities & Architecture Suite | SK Builds" 
  description="Collection of interactive developer tools, JSON to TypeScript generators, Regex visualizers, UUID generators, and system calculators by Sunil Khobragade." 
  currentPath="/tools"
>
  <Breadcrumb items={[{ label: 'Tools' }]} />

  <div style="margin-bottom: 2.25rem;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; letter-spacing: -0.025em;">
      Developer Utilities &amp; Architecture Tools
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      High-utility interactive tools for software engineers, full-stack architects, and startup founders. 100% client-side privacy.
    </p>
  </div>

  <!-- Data, Types & Parsing -->
  <section style="margin-bottom: 2.75rem;">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.45rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-blue);">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      <span>Data, Types &amp; Query Utilities</span>
    </h2>
    <div class="projects-list" style="margin-top: 0;">
      <Card 
        href="/tools/json-to-ts"
        title="JSON to TypeScript Interface Generator"
        description="Convert raw JSON or API payloads into strictly typed TypeScript interfaces and types with instant export and formatting."
        tags={["TypeScript", "JSON", "Types", "Formatter"]}
      />
      <Card 
        href="/tools/url-parser"
        title="URL Parser & Query Parameters Builder"
        description="Inspect, decompose, and construct complex URLs and query strings with real-time bidirectional editing and JSON export."
        tags={["URL", "Query Params", "Parser", "REST"]}
      />
      <Card 
        href="/tools/jwt-decoder"
        title="JWT Token Decoder & Inspector"
        description="Client-side JSON Web Token debugger and payload inspector with expiration verification and zero tracking."
        tags={["JWT", "Auth", "Security", "Claims"]}
      />
      <Card 
        href="/tools/sql-formatter"
        title="SQL Formatter & Query Optimizer"
        description="Beautify and capitalize raw SQL queries with instant index and query performance recommendations."
        tags={["SQL", "PostgreSQL", "Optimization"]}
      />
      <Card 
        href="/tools/diff-viewer"
        title="Code & Text Diff Inspector"
        description="Semantic side-by-side and inline line diff comparison for code snippets, JSON objects, and SQL scripts."
        tags={["Diff", "Code Review", "Comparison"]}
      />
      <Card 
        href="/tools/curl-converter"
        title="cURL to Code Converter (Fetch, Axios, Python, Go)"
        description="Convert curl commands into JavaScript Fetch, Axios, Python Requests, Node.js, and Go client code with 1-click copy."
        tags={["cURL", "Fetch", "Axios", "Python", "Go"]}
      />
      <Card 
        href="/tools/json-formatter"
        title="JSON Formatter, Validator & Minifier"
        description="Beautify, validate, sort, and minify JSON payloads with instant error detection and payload analytics."
        tags={["JSON", "Formatter", "Validator", "Minifier"]}
      />
    </div>
  </section>

  <!-- Frontend, CSS & Content Design -->
  <section style="margin-bottom: 2.75rem;">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.45rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-purple);">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m4.93 4.93 4.24 4.24"></path>
        <path d="m14.83 9.17 4.24-4.24"></path>
        <path d="m14.83 14.83 4.24 4.24"></path>
        <path d="m9.17 14.83-4.24 4.24"></path>
      </svg>
      <span>Frontend, Design &amp; Content Tools</span>
    </h2>
    <div class="projects-list" style="margin-top: 0;">
      <Card 
        href="/tools/markdown-editor"
        title="Markdown Editor & Live HTML Preview"
        description="Write, format, and preview Markdown in real-time with zero latency. Export clean HTML or download markdown files."
        tags={["Markdown", "HTML", "WYSIWYG", "Content"]}
      />
      <Card 
        href="/tools/box-shadow-generator"
        title="CSS Box Shadow & Glassmorphism Generator"
        description="Design sleek multi-layered shadows, elevation presets, and frosted glassmorphic UI cards visually with instant CSS export."
        tags={["CSS", "Glassmorphism", "Box Shadow", "UI Design"]}
      />
      <Card 
        href="/tools/color-contrast"
        title="WCAG Color Contrast & Accessibility Checker"
        description="Verify WCAG 2.1 AA & AAA compliance ratios for text, buttons, and UI components in real-time."
        tags={["WCAG 2.1", "Accessibility", "Color Contrast", "UI/UX"]}
      />
      <Card 
        href="/tools/svg-optimizer"
        title="SVG to CSS Data URI & React JSX Converter"
        description="Convert raw SVGs into optimized CSS background data-URIs, Base64 strings, and typed React / Next.js JSX components."
        tags={["SVG", "React", "TSX", "Data URI", "CSS"]}
      />
      <Card 
        href="/tools/html-entity-encoder"
        title="HTML Entity Encoder, Decoder & Sanitizer"
        description="Safely escape and unescape HTML characters for XSS defense, convert to decimal/hex entities, and strip tags."
        tags={["HTML", "Entities", "XSS", "Sanitizer"]}
      />
    </div>
  </section>

  <!-- Cryptography, Tokens & Regex -->
  <section style="margin-bottom: 2.75rem;">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.45rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-green);">
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Cryptography, Regex &amp; Background Workers</span>
    </h2>
    <div class="projects-list" style="margin-top: 0;">
      <Card 
        href="/tools/regex-tester"
        title="Interactive Regex Tester & Visualizer"
        description="Test, debug, and inspect regular expressions with real-time match highlighting, group capture, and developer presets."
        tags={["Regex", "Patterns", "Validation"]}
      />
      <Card 
        href="/tools/base64-encoder"
        title="Base64, URL & Hash Swiss-Army Utility"
        description="Encode/decode Base64 and URLs, and compute hardware-accelerated SHA-256 and SHA-512 hashes via WebCrypto."
        tags={["Base64", "SHA-256", "Crypto", "URL"]}
      />
      <Card 
        href="/tools/uuid-generator"
        title="UUID & Cryptographic Token Generator"
        description="Generate cryptographically secure UUID v4, time-ordered UUID v7, NanoIDs, and API secret keys in bulk."
        tags={["UUID v4", "UUID v7", "NanoID", "API Keys"]}
      />
      <Card 
        href="/tools/cron-generator"
        title="Cron Schedule Generator & Translator"
        description="Construct standard cron schedule expressions with human-readable explanations for background workers and schedulers."
        tags={["Cron", "DevOps", "Background Jobs"]}
      />
      <Card 
        href="/tools/timestamp-converter"
        title="Unix Epoch Timestamp & Date Converter"
        description="Convert Unix timestamps in seconds, milliseconds, and microseconds to UTC, ISO 8601, and local time with live ticker."
        tags={["Unix", "Timestamp", "Epoch", "Date", "UTC"]}
      />
      <Card 
        href="/tools/chmod-calculator"
        title="Linux Chmod Permissions Calculator"
        description="Calculate Linux file and directory permissions between octal values (755, 644) and symbolic notation (rwxr-xr-x)."
        tags={["Linux", "Chmod", "Permissions", "POSIX", "DevOps"]}
      />
    </div>
  </section>

  <!-- Project Planning & Architecture Consultation -->
  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.45rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-purple);">
        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>Project Planning &amp; Architecture Consultation</span>
    </h2>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <Card 
        href="/tools/estimator"
        title="Project Scope & Architecture Estimator"
        description="Interactive calculator to plan your web app's architecture, choose tech stacks, estimate delivery timelines, and generate a freelance proposal."
        tags={["Architecture", "Scope", "Timeline", "Cost"]}
      />
      <Card 
        href="/tools/appointment"
        title="Book 1:1 Consultation (Calendly)"
        description="Schedule a 1:1 system design, architecture discovery, or code review video call with instant Calendly scheduling."
        tags={["Consultation", "1:1 Call", "Calendly"]}
      />
    </div>
  </section>
</Layout>
