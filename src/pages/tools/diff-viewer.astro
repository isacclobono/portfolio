---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Button from '../../components/Button.astro';
---

<Layout 
  title="Code & Text Diff Checker | SK Builds" 
  description="Client-side code, SQL, JSON, and text diff comparator with visual line-by-line syntax highlight additions and deletions." 
  currentPath="/tools/diff-viewer"
>
  <Breadcrumb items={[
    { label: 'Tools', href: '/tools' },
    { label: 'Diff Checker' }
  ]} />

  <Button href="/tools" variant="back" size="sm">
    Back to tools
  </Button>

  <div style="margin: 1.5rem 0 2rem;">
    <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
      Code &amp; Text Diff Inspector
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
      Compare two blocks of code, JSON payloads, SQL scripts, or prose text side-by-side. 100% computed in your browser without transmitting sensitive data.
    </p>
  </div>

  <div class="tool-card">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span id="diff-stats-badge" class="status-pill status-ready">+2 additions &bull; -1 deletions</span>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="button" id="btn-load-diff-sample" class="action-btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">
          Load Sample
        </button>
        <button type="button" id="btn-swap-diff" class="action-btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">
          Swap Inputs
        </button>
        <button type="button" id="btn-clear-diff" class="action-btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">
          Clear
        </button>
      </div>
    </div>

    <!-- Dual Input Workspace Grid -->
    <div class="tool-dual-grid">
      <!-- Original Text -->
      <div class="code-box-wrapper">
        <div class="code-box-header">
          <span class="code-box-title">Original (Before)</span>
        </div>
        <textarea 
          id="diff-input-left" 
          class="code-textarea"
          placeholder="Paste original code or text here..."
          spellcheck="false"
        ></textarea>
      </div>

      <!-- Modified Text -->
      <div class="code-box-wrapper">
        <div class="code-box-header">
          <span class="code-box-title">Modified (After)</span>
        </div>
        <textarea 
          id="diff-input-right" 
          class="code-textarea"
          placeholder="Paste updated code or text here..."
          spellcheck="false"
        ></textarea>
      </div>
    </div>

    <!-- Unified Visual Diff Output -->
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
        <label style="font-size: 0.825rem; font-weight: 600; color: var(--text-primary);">
          Unified Visual Comparison:
        </label>
        <button type="button" id="copy-diff-btn" class="copy-pill-btn cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span id="copy-diff-text">Copy Unified Diff</span>
        </button>
      </div>

      <div id="diff-visual-box" class="diff-viewer-wrapper"></div>
    </div>
  </div>
</Layout>

<style>
  .tool-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tool-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .tool-dual-grid {
      grid-template-columns: 1fr;
    }
  }

  .code-box-wrapper {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.85rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-card);
  }

  [data-theme="light"] .code-box-header {
    background: rgba(0, 0, 0, 0.04);
  }

  .code-box-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .code-textarea {
    width: 100%;
    height: 180px;
    background: transparent;
    border: none;
    padding: 0.85rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.5;
    outline: none;
    resize: vertical;
    box-sizing: border-box;
  }

  .diff-viewer-wrapper {
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 0.5rem 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.5;
  }

  :global(.diff-line) {
    display: flex;
    align-items: center;
    padding: 0.15rem 0.85rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  :global(.diff-line-added) {
    background-color: rgba(34, 197, 94, 0.12);
    color: #4ade80;
  }

  :global(.diff-line-deleted) {
    background-color: rgba(239, 68, 68, 0.12);
    color: #f87171;
  }

  :global(.diff-line-unchanged) {
    color: var(--text-secondary);
  }

  :global(.diff-line-prefix) {
    width: 24px;
    user-select: none;
    font-weight: 700;
    flex-shrink: 0;
  }

  .status-pill {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .status-ready {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .copy-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 4px;
    color: var(--text-secondary);
    font-size: 0.725rem;
    transition: all var(--transition-fast);
  }

  .copy-pill-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-card-hover);
  }
</style>

<script>
  function setupDiffViewer() {
    const leftInput = document.getElementById('diff-input-left') as HTMLTextAreaElement | null;
    const rightInput = document.getElementById('diff-input-right') as HTMLTextAreaElement | null;
    const visualBox = document.getElementById('diff-visual-box');
    const statsBadge = document.getElementById('diff-stats-badge');
    const loadSampleBtn = document.getElementById('btn-load-diff-sample');
    const swapBtn = document.getElementById('btn-swap-diff');
    const clearBtn = document.getElementById('btn-clear-diff');
    const copyBtn = document.getElementById('copy-diff-btn');
    const copyText = document.getElementById('copy-diff-text');

    if (!leftInput || !rightInput || !visualBox) return;

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function computeDiff() {
      const leftLines = leftInput.value.split('\n');
      const rightLines = rightInput.value.split('\n');

      let additions = 0;
      let deletions = 0;
      let unchanged = 0;

      const outputHtml: string[] = [];

      // Simple Longest Common Subsequence line diff
      const matrix: number[][] = Array(leftLines.length + 1).fill(0).map(() => Array(rightLines.length + 1).fill(0));

      for (let i = 1; i <= leftLines.length; i++) {
        for (let j = 1; j <= rightLines.length; j++) {
          if (leftLines[i - 1] === rightLines[j - 1]) {
            matrix[i][j] = matrix[i - 1][j - 1] + 1;
          } else {
            matrix[i][j] = Math.max(matrix[i - 1][j], matrix[i][j - 1]);
          }
        }
      }

      let i = leftLines.length;
      let j = rightLines.length;
      const diffLines: { type: 'added' | 'deleted' | 'unchanged'; text: string }[] = [];

      while (i > 0 || j > 0) {
        if (i > 0 && j > 0 && leftLines[i - 1] === rightLines[j - 1]) {
          diffLines.unshift({ type: 'unchanged', text: leftLines[i - 1] });
          unchanged++;
          i--;
          j--;
        } else if (j > 0 && (i === 0 || matrix[i][j - 1] >= matrix[i - 1][j])) {
          diffLines.unshift({ type: 'added', text: rightLines[j - 1] });
          additions++;
          j--;
        } else if (i > 0 && (j === 0 || matrix[i][j - 1] < matrix[i - 1][j])) {
          diffLines.unshift({ type: 'deleted', text: leftLines[i - 1] });
          deletions++;
          i--;
        }
      }

      if (statsBadge) {
        statsBadge.textContent = `+${additions} additions • -${deletions} deletions • ${unchanged} unchanged`;
      }

      visualBox.innerHTML = diffLines.map((line) => {
        let prefix = ' ';
        let cls = 'diff-line-unchanged';
        if (line.type === 'added') {
          prefix = '+';
          cls = 'diff-line-added';
        } else if (line.type === 'deleted') {
          prefix = '-';
          cls = 'diff-line-deleted';
        }

        return `<div class="diff-line ${cls}"><span class="diff-line-prefix">${prefix}</span><span>${escapeHtml(line.text)}</span></div>`;
      }).join('');
    }

    leftInput.addEventListener('input', computeDiff);
    rightInput.addEventListener('input', computeDiff);

    const sampleLeft = `async function handlePayment(orderId, amount) {
  const result = await db.query('SELECT * FROM orders WHERE id = $1', [orderId]);
  if (!result.rows[0]) throw new Error('Order not found');
  return stripe.charges.create({ amount });
}`;

    const sampleRight = `async function handlePayment(orderId, amount, idempotencyKey) {
  const result = await db.query('SELECT * FROM orders WHERE id = $1', [orderId]);
  if (!result.rows[0]) throw new Error('Order not found');
  const lock = await redis.set(\`lock:\${orderId}\`, '1', 'NX', 'EX', 30);
  if (!lock) throw new Error('Concurrent payment detected');
  return stripe.paymentIntents.create({ amount }, { idempotencyKey });
}`;

    function loadSample() {
      leftInput.value = sampleLeft;
      rightInput.value = sampleRight;
      computeDiff();
    }

    loadSampleBtn?.addEventListener('click', loadSample);

    swapBtn?.addEventListener('click', () => {
      const temp = leftInput.value;
      leftInput.value = rightInput.value;
      rightInput.value = temp;
      computeDiff();
    });

    clearBtn?.addEventListener('click', () => {
      leftInput.value = '';
      rightInput.value = '';
      computeDiff();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = Array.from(visualBox.querySelectorAll('.diff-line')).map(l => l.textContent).join('\n');
      if (!text) return;
      await navigator.clipboard.writeText(text);
      if (copyText) {
        const prev = copyText.textContent;
        copyText.textContent = 'Copied!';
        setTimeout(() => { copyText.textContent = prev; }, 1600);
      }
    });

    if (!leftInput.value && !rightInput.value) {
      loadSample();
    } else {
      computeDiff();
    }
  }

  setupDiffViewer();
  document.addEventListener('astro:after-swap', setupDiffViewer);
</script>
