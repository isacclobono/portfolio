---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';

const lastUpdated = "October 12, 2026";
---

<Layout 
  title="Privacy Policy | Sunil Khobragade (SK Builds)" 
  description="Official Privacy Policy and data protection compliance for Sunil Khobragade's software engineering portfolio, Calendly 1:1 scheduling, developer tools, and consulting services." 
  currentPath="/privacy"
>
  <Breadcrumb items={[
    { label: 'Privacy Policy' }
  ]} />

  <div class="legal-top-nav">
    <Button href="/" variant="back" size="sm">
      Back to home
    </Button>

    <div class="legal-meta-badges">
      <span class="legal-badge-pill">Production Ready</span>
      <span class="legal-badge-pill highlight">GDPR &bull; CCPA &bull; DPDP 2023</span>
    </div>
  </div>

  <article class="legal-page">
    <header class="legal-header">
      <div class="legal-badge">Official Privacy Statement</div>
      <h1 class="legal-title">Privacy Policy</h1>
      <p class="legal-subtitle">Last updated: {lastUpdated} &bull; Effective immediately across all SK Builds web properties</p>
    </header>

    <div class="legal-content">
      <!-- 1. Operator & Scope -->
      <section class="legal-section">
        <h2>1. Operator Identity &amp; Scope</h2>
        <p>
          This Privacy Policy governs the collection, processing, and protection of personal data by <strong>Sunil Khobragade</strong>, operating under the professional banner <strong>SK Builds</strong> ("we", "us", or "our"), across our primary website (<a href="https://sunilkhobragade.pages.dev">https://sunilkhobragade.pages.dev</a>), in-browser developer utilities (<code>/tools</code>), and 1:1 consultation booking platform (<code>/tools/appointment</code>).
        </p>
        <p>
          We are committed to the principle of <em>Privacy by Design</em>. We collect only the minimum information strictly necessary to provide software engineering services, coordinate technical consultations, and operate client-side utilities without intrusive profiling or third-party data broker sharing.
        </p>
      </section>

      <!-- 2. Calendly Scheduling API Integration -->
      <section class="legal-section">
        <h2>2. 1:1 Technical Consultations &amp; Calendly Scheduling API</h2>
        <p>
          We provide a real-time scheduling interface on <code>/tools/appointment</code> enabling prospective clients, engineering teams, and recruiters to book 1:1 technical discovery and architecture review sessions directly with Sunil Khobragade.
        </p>
        
        <div class="legal-callout">
          <div class="callout-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div class="callout-body">
            <strong>Direct Calendly REST API Integration Disclosure:</strong>
            <p>
              When you submit a consultation request, booking details (full name, email address, meeting agenda/notes, and chosen start time) are transmitted directly to the official <a href="https://calendly.com/privacy" target="_blank" rel="noopener noreferrer">Calendly REST API</a> (<code>POST /invitees</code>) using authorized host credentials to create the appointment and issue automated Google Meet confirmation links.
            </p>
          </div>
        </div>

        <ul class="styled-list">
          <li><strong>Information Collected:</strong> Your full name, email address, company/project context, and selected UTC time slot.</li>
          <li><strong>Purpose:</strong> Coordinating the scheduled meeting, verifying attendee availability, and providing rescheduling or cancellation links.</li>
          <li><strong>Zero Credential Harvesting:</strong> We never access, request, or store your private calendar credentials, Google account passwords, or personal contacts.</li>
          <li><strong>Strict Non-Commercial Use:</strong> Consultation intake details are used solely for the scheduled discussion and are never sold, rented, or distributed to advertisers.</li>
        </ul>
      </section>

      <!-- 3. In-Browser Developer Utilities -->
      <section class="legal-section">
        <h2>3. In-Browser Developer Tools (100% Client-Side Execution)</h2>
        <p>
          Our platform includes an extensive suite of 20+ developer utilities (such as the Project Estimator, JSON to TypeScript Converter, SQL Formatter, Regex Tester, JWT Decoder, Unix Timestamp Converter, and Base64 Encoder).
        </p>

        <div class="info-grid">
          <div class="info-card">
            <h3 class="card-icon-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 22 4"/></svg>
              Zero Server-Side Transmission
            </h3>
            <p>
              All developer tools execute strictly inside your local web browser's JavaScript V8 engine. Code snippets, JSON payloads, JWT headers, and database queries are never transmitted to our backend or stored on our servers.
            </p>
          </div>

          <div class="info-card">
            <h3 class="card-icon-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
              Project Estimator
            </h3>
            <p>
              Values entered into the <a href="/tools/estimator">Project Estimator</a> (timeline, complexity, tech stack choices) remain in browser state and are not saved unless you explicitly copy or send them via email.
            </p>
          </div>

          <div class="info-card">
            <h3 class="card-icon-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
              AI Assistant (SK Agent)
            </h3>
            <p>
              Conversations with the AI copilot are processed in real-time for technical responses and cached locally in your device's browser <strong>IndexedDB</strong>. You can clear conversation history at any time.
            </p>
          </div>
        </div>
      </section>

      <!-- 4. Cookies & Browser Storage -->
      <section class="legal-section">
        <h2>4. Browser Storage &amp; Cookie Disclosure</h2>
        <p>
          We operate an analytics-clean, ad-free environment. We do not use third-party marketing cookies, cross-site trackers, or advertising pixels. Minimal local browser storage is used exclusively for functional preferences:
        </p>
        <ul class="styled-list">
          <li><code>theme</code> (localStorage): Preserves your preferred Dark or Light interface appearance.</li>
          <li><code>sk_chat_w</code> &amp; <code>sk_chat_h</code> (localStorage): Stores custom user-adjusted dimensions of the floating copilot window.</li>
          <li><code>SK_Portfolio_ChatDB</code> (IndexedDB): Persists your interactive conversation history on your device so you do not lose context across sessions.</li>
        </ul>
      </section>

      <!-- 5. Data Security & Hosting -->
      <section class="legal-section">
        <h2>5. Technical Security &amp; Infrastructure</h2>
        <p>
          Our web platform is hosted on global edge infrastructure (Cloudflare Pages) with enterprise-grade security protocols:
        </p>
        <ul class="styled-list">
          <li><strong>Transport Layer Security:</strong> Enforced HTTPS/TLS 1.3 encryption across all network requests.</li>
          <li><strong>Content Security Policy (CSP):</strong> Strict headers preventing cross-site scripting (XSS), code injection, and unauthorized iframe embedding.</li>
          <li><strong>DDoS Protection &amp; Edge WAF:</strong> Automated traffic filtering protecting the site against distributed denial-of-service and bot exploits.</li>
        </ul>
      </section>

      <!-- 6. Legal Rights (GDPR / CCPA / DPDP) -->
      <section class="legal-section">
        <h2>6. International Privacy Rights (GDPR, CCPA/CPRA &amp; DPDP)</h2>
        <p>
          Regardless of your geographical location, you retain full sovereignty over your personal data:
        </p>
        <ul class="styled-list">
          <li><strong>Right to Access &amp; Portability:</strong> You may request a summary of any contact information provided during consultation bookings.</li>
          <li><strong>Right to Rectification &amp; Erasure:</strong> You may request immediate deletion or correction of your booking details from our communication logs.</li>
          <li><strong>Right to Opt-Out:</strong> We do not sell or share personal data with third-party brokers.</li>
        </ul>
      </section>

      <!-- 7. Contact Information -->
      <section class="legal-section contact-box">
        <h2>7. Data Protection Inquiries &amp; Contact</h2>
        <p>
          If you have questions regarding this Privacy Policy, wish to exercise your data protection rights, or need clarification regarding consultation records, please contact Sunil Khobragade directly:
        </p>
        <div class="contact-details">
          <div><strong>Consultant &amp; Operator:</strong> Sunil Khobragade (SK Builds)</div>
          <div><strong>Primary Inquiries Email:</strong> <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a></div>
          <div><strong>Direct Phone:</strong> <a href="tel:+917498950562">+91 74989 50562</a></div>
          <div><strong>Location:</strong> Hyderabad, Telangana, India</div>
          <div><strong>Official Website:</strong> <a href="https://sunilkhobragade.pages.dev">https://sunilkhobragade.pages.dev</a></div>
        </div>
      </section>
    </div>
  </article>
</Layout>

<style>
  .legal-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .legal-meta-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .legal-badge-pill {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .legal-badge-pill.highlight {
    color: #3b82f6;
    border-color: rgba(59, 130, 246, 0.3);
  }

  .legal-page {
    max-width: 820px;
    margin: 0 auto 4rem auto;
  }

  .legal-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .legal-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .legal-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .legal-subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .legal-section h2 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.75rem 0;
  }

  .legal-section p {
    margin: 0 0 0.75rem 0;
  }

  .styled-list {
    margin: 0.5rem 0 1rem 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .styled-list li strong {
    color: var(--text-primary);
  }

  .legal-content a {
    color: #3b82f6;
    text-decoration: underline;
    font-weight: 500;
  }

  .legal-content code {
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 0.15rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.85em;
    font-family: var(--font-mono, monospace);
    color: var(--text-primary);
  }

  .legal-callout {
    display: flex;
    gap: 1rem;
    background: transparent;
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-left: 3px solid #3b82f6;
    padding: 1.2rem;
    border-radius: 0.6rem;
    margin: 1.25rem 0;
  }

  .callout-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .callout-body strong {
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.35rem;
  }

  .callout-body p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .info-card {
    background: transparent;
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    padding: 1.2rem;
    transition: border-color 0.15s ease;
  }

  .info-card:hover {
    border-color: rgba(59, 130, 246, 0.4);
  }

  .card-icon-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
  }

  .info-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  .contact-box {
    background: transparent;
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.85rem;
    font-size: 0.9rem;
  }

  .contact-details strong {
    color: var(--text-primary);
  }
</style>
