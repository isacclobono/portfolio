---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
import { WORK_EXPERIENCE } from '../data/work';
import { TECHNICAL_SKILLS, EDUCATION, TRAININGS } from '../data/skills';
---

<Layout 
  title="Resume & Curriculum Vitae | Sunil Khobragade" 
  description="Senior Full-Stack Developer & AI Solutions Architect resume. 6+ years building distributed systems, LLM orchestration, microservices, and high-concurrency cloud architectures."
  currentPath="/resume"
>
  <div class="print-hide-btn" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
    <Breadcrumb items={[{ label: 'Resume / CV' }]} />

    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button 
        type="button" 
        id="print-resume-btn" 
        class="action-btn btn-primary cursor-pointer"
        style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.95rem; font-size: 0.85rem;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect width="12" height="8" x="6" y="14"></rect>
        </svg>
        <span>Print / Save PDF</span>
      </button>

      <Button href="/" variant="back" size="sm">
        Back to home
      </Button>
    </div>
  </div>

  <div class="resume-sheet">
    <!-- Header -->
    <header class="resume-header">
      <div>
        <h1 style="font-size: 1.85rem; font-weight: 800; margin: 0 0 0.35rem 0; letter-spacing: -0.025em; color: var(--text-primary);">
          {SITE.AUTHOR}
        </h1>
        <div style="font-size: 1.05rem; font-weight: 600; color: var(--accent-blue); margin-bottom: 0.5rem;">
          {SITE.ROLE}
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary); display: flex; flex-wrap: wrap; gap: 0.85rem; align-items: center;">
          <span>📍 {SITE.LOCATION}</span>
          <span>&bull;</span>
          <a href={`mailto:${SITE.EMAIL}`} style="color: var(--text-primary); text-decoration: underline;">{SITE.EMAIL}</a>
          <span>&bull;</span>
          <a href={SITE.LINKEDIN} target="_blank" rel="noopener noreferrer" style="color: var(--text-primary);">LinkedIn</a>
          <span>&bull;</span>
          <a href={SITE.GITHUB} target="_blank" rel="noopener noreferrer" style="color: var(--text-primary);">GitHub</a>
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <section>
      <div class="resume-section-title">Executive Summary</div>
      <p style="font-size: 0.9rem; line-height: 1.65; color: var(--text-secondary); margin: 0;">
        {SITE.BIO}
      </p>
    </section>

    <!-- Technical Skills -->
    <section>
      <div class="resume-section-title">Technical Expertise</div>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {TECHNICAL_SKILLS.map((cat) => (
          <div style="font-size: 0.875rem; line-height: 1.5;">
            <strong style="color: var(--text-primary); font-weight: 600;">{cat.title}:</strong>{' '}
            <span style="color: var(--text-secondary);">{cat.skills.join(', ')}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Professional Experience -->
    <section>
      <div class="resume-section-title">Professional Work Experience</div>
      <div style="display: flex; flex-direction: column; gap: 1.75rem;">
        {WORK_EXPERIENCE.map((job) => (
          <div class="resume-experience-item">
            <div class="resume-item-headline">
              <div>
                <span class="resume-role-title">{job.role}</span>
                <span style="color: var(--text-muted); margin: 0 0.35rem;">&bull;</span>
                <span class="resume-company-name">{job.company}</span>
                {job.location && (
                  <span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 0.4rem;">({job.location})</span>
                )}
              </div>
              <div class="resume-timeline-badge">{job.period}</div>
            </div>
            <ul class="resume-bullet-list">
              {job.points.map((pt) => (
                <li style="margin-bottom: 0.4rem;">{pt}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Education & Certifications -->
    <section>
      <div class="resume-section-title">Education &amp; Credentials</div>
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {EDUCATION.map((edu) => (
          <div>
            <div class="resume-item-headline">
              <div>
                <span class="resume-role-title">{edu.degree}</span>
                <span style="color: var(--text-muted); margin: 0 0.35rem;">&bull;</span>
                <span class="resume-company-name">{edu.institution}</span>
              </div>
              <div class="resume-timeline-badge">{edu.period}</div>
            </div>
            {edu.points && edu.points.length > 0 && (
              <ul class="resume-bullet-list">
                {edu.points.map((pt) => (
                  <li style="margin-bottom: 0.25rem;">{pt}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Specialized AI Training -->
    <section>
      <div class="resume-section-title">Specialized AI &amp; Cloud Programs</div>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        {TRAININGS.map((tr) => (
          <div>
            <div class="resume-item-headline">
              <div>
                <span class="resume-role-title">{tr.title}</span>
                <span style="color: var(--text-muted); margin: 0 0.35rem;">&bull;</span>
                <span class="resume-company-name">{tr.issuer}</span>
              </div>
            </div>
            <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0.35rem 0 0.5rem 0;">
              {tr.description}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupPrintHandler() {
    const printBtn = document.getElementById('print-resume-btn');
    if (!printBtn) return;
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }

  setupPrintHandler();
  document.addEventListener('astro:after-swap', setupPrintHandler);
</script>
