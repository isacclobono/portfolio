<script>
  function setupTechStackInteractions() {
    const tabs = document.querySelectorAll('.stack-tab');
    const searchInput = document.getElementById('stack-search-input');
    const categories = document.querySelectorAll('.category-block');
    const techCards = document.querySelectorAll('.tech-row-card');

    if (!tabs || !categories.length) return;

    let currentFilter = 'all';

    function filterTechItems() {
      const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

      categories.forEach((cat) => {
        const catId = cat.getAttribute('data-category-id') || '';
        const matchesCategory = currentFilter === 'all' || currentFilter === catId;

        if (!matchesCategory) {
          cat.classList.add('is-hidden');
          return;
        }

        let hasVisibleCards = false;
        const cards = cat.querySelectorAll('.tech-row-card');

        cards.forEach((card) => {
          if (!query) {
            card.classList.remove('is-hidden');
            hasVisibleCards = true;
            return;
          }

          const name = card.getAttribute('data-tech-name') || '';
          const tag = card.getAttribute('data-tech-tag') || '';
          const role = card.getAttribute('data-tech-role') || '';
          const used = card.getAttribute('data-tech-used') || '';
          const combined = `${name} ${tag} ${role} ${used}`;

          if (combined.includes(query)) {
            card.classList.remove('is-hidden');
            hasVisibleCards = true;
          } else {
            card.classList.add('is-hidden');
          }
        });

        if (hasVisibleCards) {
          cat.classList.remove('is-hidden');
        } else {
          cat.classList.add('is-hidden');
        }
      });
    }

    // Category Tabs click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        filterTechItems();
      });
    });

    // Live search input
    if (searchInput) {
      searchInput.addEventListener('input', filterTechItems);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTechStackInteractions);
  } else {
    setupTechStackInteractions();
  }
  document.addEventListener('astro:after-swap', setupTechStackInteractions);
</script>
