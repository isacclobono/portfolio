---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';

const stats = [
  { label: "Engineering Career", value: "6+ Years", highlight: "Full-Stack & AI Systems" },
  { label: "Type Safety Standard", value: "100%", highlight: "End-to-End TypeScript" },
  { label: "Edge Delivery Latency", value: "< 25ms", highlight: "Cloudflare 300+ PoPs" },
  { label: "AI Inference Velocity", value: "300+ tok/s", highlight: "Groq Cloud LPU" }
];

const categories = [
  {
    id: "ai-agents",
    categoryName: "AI Models, LLMs & Multi-Agent Frameworks",
    categoryIconType: "bot",
    categoryDesc: "Production AI inference engines, multi-agent orchestration graphs, and high-density vector retrieval.",
    items: [
      {
        name: "Groq Cloud LPU API",
        url: "https://groq.com",
        tag: "Inference Engine",
        level: "Daily Driver",
        usedIn: "Pulse Chat & AI Copilot",
        role: "Powers sub-120ms TTFT streaming AI inference (300+ tokens/sec) using Llama 3.3, Qwen 2.5, and DeepSeek models."
      },
      {
        name: "LangGraph & CrewAI",
        url: "https://www.langchain.com/langgraph",
        tag: "Agentic Systems",
        level: "Advanced",
        usedIn: "AI-Enabled LMS",
        role: "Orchestrates cyclic multi-agent state machines, self-correction reasoning loops, memory retention, and tool calling."
      },
      {
        name: "pgvector & Pinecone",
        url: "https://github.com/pgvector/pgvector",
        tag: "Vector Database",
        level: "Production",
        usedIn: "Enterprise RAG",
        role: "Indexes high-density embeddings (HNSW cosine distance) for hybrid BM25 + dense vector semantic retrieval."
      },
      {
        name: "Google Vertex AI & Gemini",
        url: "https://cloud.google.com/vertex-ai",
        tag: "Foundation Models",
        level: "Certified",
        usedIn: "AI-Enabled LMS",
        role: "APAC GenAI Academy certified integration for multimodal processing, document embeddings, and context caching."
      },
      {
        name: "Ollama & Local LLMs",
        url: "https://ollama.com",
        tag: "Local Inference",
        level: "Prototyping",
        usedIn: "Private Workflows",
        role: "On-premise model execution (Qwen, Mistral, Llama) for privacy-first benchmarking and zero-egress workflows."
      }
    ]
  },
  {
    id: "backend-languages",
    categoryName: "Backend Runtimes, Languages & Microservices",
    categoryIconType: "server",
    categoryDesc: "High-throughput asynchronous runtimes, strictly typed APIs, and event-driven microservice backends.",
    items: [
      {
        name: "Node.js (v20+ LTS)",
        url: "https://nodejs.org",
        tag: "Runtime",
        level: "6+ Yrs Exp",
        usedIn: "Pulse Chat & Booking",
        role: "Event-loop backend architectures, streaming REST microservices, WebSocket clustering, and background job queues."
      },
      {
        name: "Python (3.12)",
        url: "https://www.python.org",
        tag: "Language",
        level: "Advanced",
        usedIn: "FastAPI & AI Pipelines",
        role: "Asynchronous REST backends, LangChain agent harnesses, data transformation pipelines, and ML inference services."
      },
      {
        name: "TypeScript (Strict Mode)",
        url: "https://www.typescriptlang.org",
        tag: "Core Standard",
        level: "100% Strict",
        usedIn: "All Projects",
        role: "Zero-any policy, end-to-end schema validation (Zod), and type-safe contract interfaces between client and server."
      },
      {
        name: "FastAPI & Fastify",
        url: "https://fastapi.tiangolo.com",
        tag: "API Framework",
        level: "Production",
        usedIn: "Microservices",
        role: "Low-overhead asynchronous HTTP/WebSocket services with automatic OpenAPI docs and high-throughput serialization."
      },
      {
        name: "Laravel (PHP 8.3)",
        url: "https://laravel.com",
        tag: "MVC Framework",
        level: "Enterprise",
        usedIn: "E-Commerce Platform",
        role: "Robust MVC architecture, Eloquent ORM, database migrations, queue workers, and multi-gateway billing logic."
      }
    ]
  },
  {
    id: "data-storage",
    categoryName: "Databases, Caching & Message Brokers",
    categoryIconType: "database",
    categoryDesc: "ACID transactional databases, in-memory distributed locks, and message queue backbones.",
    items: [
      {
        name: "PostgreSQL 16",
        url: "https://www.postgresql.org",
        tag: "Relational DB",
        level: "Core Standard",
        usedIn: "All Production Apps",
        role: "Row-Level Security (RLS) multi-tenancy, JSONB querying, B-tree/GIN indexing, and ACID transaction guarantees."
      },
      {
        name: "Redis (Cluster & Redlock)",
        url: "https://redis.io",
        tag: "In-Memory DB",
        level: "Production",
        usedIn: "Appointment Booking",
        role: "Sub-millisecond caching, rate-limiting, session management, Pub/Sub channels, and Redlock distributed mutexes."
      },
      {
        name: "RabbitMQ",
        url: "https://www.rabbitmq.com",
        tag: "Message Broker",
        level: "Architectural",
        usedIn: "Event-Driven Services",
        role: "Topic/Direct exchange routing topologies, dead-letter queues (DLQ), and consumer backpressure flow control."
      },
      {
        name: "MongoDB",
        url: "https://www.mongodb.com",
        tag: "NoSQL DB",
        level: "Production",
        usedIn: "Chat Telemetry",
        role: "Flexible document store for chat transcripts, event audit logs, and high-velocity unstructured payloads."
      }
    ]
  },
  {
    id: "frontend-web",
    categoryName: "Frontend Engines, Browsers & Web APIs",
    categoryIconType: "zap",
    categoryDesc: "Zero-JS static site generators, component frameworks, client-side storage, and native browser APIs.",
    items: [
      {
        name: "Astro 7 (v7.2+)",
        url: "https://astro.build",
        tag: "Static & SSR",
        level: "Daily Driver",
        usedIn: "Portfolio & Docs",
        role: "Islands architecture with Content Layer API, Vite 8 build engine, native Rust compiler, and zero-JS baseline."
      },
      {
        name: "React 19 & Next.js 15",
        url: "https://react.dev",
        tag: "UI Library",
        level: "5+ Yrs Exp",
        usedIn: "Pulse Chat & LMS",
        role: "Server Components, optimistic UI mutations, concurrent mode, and interactive real-time client dashboards."
      },
      {
        name: "TailwindCSS (v4 / Vite)",
        url: "https://tailwindcss.com",
        tag: "Styling Engine",
        level: "Standard",
        usedIn: "Modern UIs",
        role: "Atomic utility compilation with CSS custom property tokens powering fluid Dark and Light theme adaptability."
      },
      {
        name: "Web Speech API",
        url: "https://developer.mozilla.org/en-US/docs/Web/API/Web_Speech_API",
        tag: "Browser Audio",
        level: "Native API",
        usedIn: "SK Agent Voice",
        role: "Continuous hands-free speech-to-text transcription streaming live directly inside the chatbot input field."
      },
      {
        name: "IndexedDB API",
        url: "https://developer.mozilla.org/en-US/docs/Web/API/IndexedDB_API",
        tag: "Client Storage",
        level: "Native API",
        usedIn: "Offline ChatDB",
        role: "Client-side private database storing chat history, modal dimension states, and offline telemetry locally."
      }
    ]
  },
  {
    id: "cloud-devops",
    categoryName: "Cloud Infrastructure, DevOps & Security",
    categoryIconType: "cloud",
    categoryDesc: "Global edge CDN delivery, Docker containerization, CI/CD automation, and cybersecurity protocols.",
    items: [
      {
        name: "Cloudflare Pages & Edge Workers",
        url: "https://pages.cloudflare.com",
        tag: "Global Edge CDN",
        level: "Production",
        usedIn: "Portfolio & Edge APIs",
        role: "Sub-25ms global TTFB across 300+ edge Points of Presence (PoPs) with HTTP/3, TLS 1.3, and DDoS mitigation."
      },
      {
        name: "Docker & Docker Compose",
        url: "https://www.docker.com",
        tag: "Containers",
        level: "Standard",
        usedIn: "Microservices",
        role: "Multi-stage reproducible container builds, service network isolation, and local development clusters."
      },
      {
        name: "Amazon Web Services (AWS)",
        url: "https://aws.amazon.com",
        tag: "Cloud Provider",
        level: "Production",
        usedIn: "Enterprise Storage",
        role: "S3 asset buckets, EC2 compute instances, RDS PostgreSQL multi-AZ deployments, and IAM least-privilege security."
      },
      {
        name: "GitHub Actions CI/CD",
        url: "https://github.com/features/actions",
        tag: "Automation",
        level: "Standard",
        usedIn: "All Repositories",
        role: "Automated linting, TypeScript type-checking, container security vulnerability scanning, and blue-green releases."
      },
      {
        name: "Information Security (OWASP)",
        url: "https://owasp.org",
        tag: "Security Standard",
        level: "M.Sc. Specialized",
        usedIn: "All Architectures",
        role: "Specialized in Cryptography, HMAC webhook signature verification, JWT claims sanitization, and RBAC audits."
      }
    ]
  },
  {
    id: "workstation-gear",
    categoryName: "Workstation Hardware, OS & Developer Tooling",
    categoryIconType: "monitor",
    categoryDesc: "Physical workstation hardware, terminal setup, and development ergonomics for peak productivity.",
    items: [
      {
        name: "High-Performance Workstation",
        url: "https://www.intel.com",
        tag: "Rig Hardware",
        level: "32GB RAM",
        usedIn: "Local Engineering",
        role: "Multi-core processor with 32GB high-speed memory and NVMe PCIe 4.0 SSD for sub-second builds and Docker clusters."
      },
      {
        name: "Dual 4K IPS Displays",
        url: "https://www.lg.com",
        tag: "Display Setup",
        level: "3840x2160",
        usedIn: "Multi-Window Flow",
        role: "Split layout for concurrent IDE coding, live terminal tracing, and browser responsive viewport previews."
      },
      {
        name: "Keychron Mechanical Keyboard",
        url: "https://www.keychron.com",
        tag: "Peripherals",
        level: "Tactile",
        usedIn: "Daily Driver",
        role: "Tactile mechanical switches tuned for high-speed typing accuracy, code navigation, and ergonomic endurance."
      },
      {
        name: "Logitech MX Master 3S",
        url: "https://www.logitech.com",
        tag: "Ergonomics",
        level: "MagSpeed",
        usedIn: "Daily Driver",
        role: "Quiet-click electromagnetic scrolling mouse with custom workspace switching gestures."
      }
    ]
  }
];

const architecturePrinciples = [
  {
    icon: "shield",
    title: "100% Strict Type Safety",
    desc: "End-to-end TypeScript interfaces and Zod runtime schema validation eliminate whole classes of production runtime exceptions before deployment."
  },
  {
    icon: "zap",
    title: "Zero-JS Baseline & Edge Delivery",
    desc: "Ship zero client-side JavaScript by default via Astro 7 Islands, serving pre-rendered HTML from 300+ Cloudflare edge PoPs in under 25ms."
  },
  {
    icon: "lock",
    title: "Concurrency-Safe Data Mutation",
    desc: "Distributed Redis Redlock mutexes and PostgreSQL SELECT FOR UPDATE locks guarantee zero double-bookings or race conditions under high concurrent loads."
  },
  {
    icon: "layers",
    title: "Dual-Write Atomicity Guarantees",
    desc: "Transactional Outbox pattern combined with Change Data Capture (CDC) ensures database state and event-stream brokers remain perfectly synchronized."
  }
];
---

<Layout 
  title="Tech Stack & Systems Architecture | SK Builds" 
  description="Comprehensive breakdown of the programming languages, cloud infrastructure, AI models, vector stores, and developer utilities used by Sunil Khobragade." 
  currentPath="/tech-stack"
>
  <Breadcrumb items={[
    { label: 'Tech Stack & Architecture' }
  ]} />

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <Button href="/" variant="back" size="sm">
      Back to home
    </Button>
  </div>

  <article class="stack-page-wrapper">
    <!-- Hero Header -->
    <header class="stack-hero-header">
      <div class="hero-badge-pill">
        <span class="badge-dot"></span>
        ENGINEERING BLUEPRINT &bull; PRODUCTION TECH &bull; 2026
      </div>
      <h1 class="stack-main-title">Tech Stack &amp; Architecture</h1>
      <p class="stack-hero-subtitle">
        A transparent breakdown of the programming languages, cloud infrastructure, AI models, vector stores, and developer utilities powering Sunil Khobragade's production builds.
      </p>
    </header>

    <!-- Key Metrics Grid -->
    <div class="stack-stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <span class="stat-label">{s.label}</span>
          <span class="stat-value">{s.value}</span>
          <span class="stat-highlight">{s.highlight}</span>
        </div>
      ))}
    </div>

    <!-- Interactive Filter & Live Search Bar -->
    <div class="stack-interactive-bar">
      <!-- Category Filter Tabs -->
      <div class="stack-filter-tabs" id="stack-tabs" role="tablist">
        <button type="button" class="stack-tab active" data-filter="all">All ({categories.reduce((acc, c) => acc + c.items.length, 0)})</button>
        <button type="button" class="stack-tab" data-filter="ai-agents">AI &amp; Agents</button>
        <button type="button" class="stack-tab" data-filter="backend-languages">Backend &amp; APIs</button>
        <button type="button" class="stack-tab" data-filter="data-storage">Databases &amp; Queues</button>
        <button type="button" class="stack-tab" data-filter="frontend-web">Frontend &amp; Web</button>
        <button type="button" class="stack-tab" data-filter="cloud-devops">Cloud &amp; Security</button>
        <button type="button" class="stack-tab" data-filter="workstation-gear">Workstation</button>
      </div>

      <!-- Quick Search Filter Input -->
      <div class="stack-search-wrap">
        <svg class="stack-search-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="stack-search-input" 
          class="stack-search-input" 
          placeholder="Filter tech by name, tag, or project..." 
          autocomplete="off"
        />
      </div>
    </div>

    <!-- Architectural Categories Breakdown -->
    <div class="categories-stream" id="categories-container">
      {categories.map((cat) => (
        <section class="category-block" id={cat.id} data-category-id={cat.id}>
          <!-- Category Header -->
          <div class="category-header-row">
            <span class="category-icon-container">
              {cat.categoryIconType === 'bot' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
                </svg>
              )}
              {cat.categoryIconType === 'server' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>
                </svg>
              )}
              {cat.categoryIconType === 'zap' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              )}
              {cat.categoryIconType === 'cloud' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                </svg>
              )}
              {cat.categoryIconType === 'database' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>
                </svg>
              )}
              {cat.categoryIconType === 'monitor' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
                </svg>
              )}
            </span>
            <div class="category-meta-text">
              <h2 class="category-title">{cat.categoryName}</h2>
              <p class="category-subtitle">{cat.categoryDesc}</p>
            </div>
          </div>

          <!-- Single-Line Full-Width Items List -->
          <div class="tech-items-list">
            {cat.items.map((item) => (
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="tech-row-card"
                data-tech-name={item.name.toLowerCase()}
                data-tech-tag={item.tag.toLowerCase()}
                data-tech-role={item.role.toLowerCase()}
                data-tech-used={item.usedIn.toLowerCase()}
                title={`Visit official ${item.name} documentation`}
              >
                <!-- Left: Name + External Link Icon + Tag Badge -->
                <div class="tech-left-column">
                  <span class="tech-name">{item.name}</span>
                  <svg class="tech-link-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                  <span class="tech-tag-pill">{item.tag}</span>
                  {item.usedIn && (
                    <span class="tech-used-pill">
                      <span class="used-dot"></span>
                      {item.usedIn}
                    </span>
                  )}
                </div>

                <!-- Right: Technical Role / Description -->
                <div class="tech-right-role">{item.role}</div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Core Architecture Principles Grid -->
    <section class="principles-section">
      <div class="principles-section-header">
        <h2 class="principles-section-title">Architectural Principles &amp; Standards</h2>
        <p class="principles-section-desc">Core engineering decisions governing every distributed system and application I build.</p>
      </div>

      <div class="principles-grid">
        {architecturePrinciples.map((p) => (
          <div class="principle-card">
            <div class="principle-icon-row">
              <span class="principle-icon-box">
                {p.icon === 'shield' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                )}
                {p.icon === 'zap' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                )}
                {p.icon === 'lock' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                )}
                {p.icon === 'layers' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                )}
              </span>
              <h3 class="principle-title">{p.title}</h3>
            </div>
            <p class="principle-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Architecture CTA Section -->
    <section class="stack-cta-card">
      <div class="stack-cta-content">
        <h3 class="stack-cta-title">Need custom architecture or high-scale system design?</h3>
        <p class="stack-cta-desc">
          I design and deliver distributed web systems, AI multi-agent pipelines, and cloud microservices tailored for performance and high concurrency.
        </p>
      </div>
      <div class="stack-cta-actions">
        <Button href="/tools/appointment" variant="primary" size="md">
          Book 1:1 Consultation &rarr;
        </Button>
        <Button href="/tools/estimator" variant="secondary" size="md">
          Estimate Architecture Cost
        </Button>
      </div>
    </section>
  </article>
</Layout>

<style>
  .stack-page-wrapper {
    max-width: 860px;
    margin: 0 auto 5rem auto;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* Hero Header */
  .stack-hero-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .stack-main-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .stack-hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 680px;
    line-height: 1.6;
  }

  /* Stats Grid */
  .stack-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 0.75rem;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .stat-card:hover {
    border-color: #3b82f6;
    transform: translateY(-2px);
  }

  .stat-label {
    font-size: 0.725rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono, monospace);
  }

  .stat-highlight {
    font-size: 0.775rem;
    color: #3b82f6;
    font-weight: 600;
  }

  /* Interactive Bar: Filter Tabs + Live Search */
  .stack-interactive-bar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 0.85rem 1rem;
  }

  .stack-filter-tabs {
    display: flex;
    align-items: center;
