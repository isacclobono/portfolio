# Groq API Key for AI Chatbot Assistant (Get one at https://console.groq.com/keys)
PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Groq AI Conversational Model (openai/gpt-oss-120b or qwen/qwen3.8-27b)
PUBLIC_GROQ_MODEL=openai/gpt-oss-120b

# Production Domain Configuration (Cloudflare Pages, Vercel, or custom domain)
SITE_URL=https://sunilkhobragade.pages.dev

# Google Calendar API (Optional OAuth Client ID for direct API event insertion)
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
PUBLIC_GOOGLE_CALENDAR_API_KEY=your_google_api_key_here

